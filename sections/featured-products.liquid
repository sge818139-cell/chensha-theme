{% endschema %}
<section id="bracelets" style="padding-top:80px">
  <div class="container">
    <div style="text-align:center;max-width:700px;margin:0 auto">
      <div class="sec-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="sec-title">{{ section.settings.title }}<span class="cn">{{ section.settings.title_cn }}</span></h2>
      <p class="sec-lead" style="margin:0 auto">{{ section.settings.lead }}</p>
    </div>
    <div class="prod-grid">

      {% assign link1 = section.settings.link1 | default: '#' %}
      <a href="{{ link1 }}" class="pcard">
        <div class="pcard-img">
          {% if section.settings.badge1 != blank %}<span class="pcard-badge">{{ section.settings.badge1 }}</span>{% endif %}
          {% if section.settings.img1 %}<img src="{{ section.settings.img1 | image_url: width: 800 }}" alt="{{ section.settings.name1 }}">
          {% else %}<img src="{{ 'p01.jpg' | asset_url }}" alt="{{ section.settings.name1 }}">{% endif %}
        </div>
        <div class="pcard-body">
          <div class="pcard-cat">{{ section.settings.cat1 }}</div>
          <div class="pcard-name">{{ section.settings.name1 }}</div>
          <div class="pcard-cn">{{ section.settings.name1_cn }}</div>
          <div class="pcard-price">{{ section.settings.price1 }}{% if section.settings.price1_old != blank %}<span class="old">{{ section.settings.price1_old }}</span>{% endif %}</div>
          <div class="pcard-pay">or 4 payments of {{ section.settings.price1 | remove: '$' | divided_by: 4 | round: 2 | prepend: '$' }}</div>
        </div>
      </a>

