    { "type": "text", "id": "name5_cn", "label": "Product 5 Chinese", "default": "流 光" },
    { "type": "text", "id": "cat5", "label": "Product 5 category", "default": "Cat's Eye · Carnelian" },
    { "type": "text", "id": "price5", "label": "Product 5 price", "default": "$148" },
