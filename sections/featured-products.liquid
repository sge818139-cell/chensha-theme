{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "title", "label": "Title", "default": "The CHENSHA Selection" },
    { "type": "text", "id": "title_cn", "label": "Chinese title", "default": "精選之作" },
    { "type": "textarea", "id": "lead", "label": "Lead text", "default": "Each piece is hand-assembled with authentic cinnabar and paired with symbolic materials — jade, gold vermeil, cloisonné, and cat's eye — chosen for meaning as much as beauty." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product image" },
        { "type": "text", "id": "name", "label": "Product name", "default": "The Essence" },
        { "type": "text", "id": "name_cn", "label": "Chinese name", "default": "本 源" },
        { "type": "text", "id": "category", "label": "Category", "default": "Minimal · Daily Wear" },
        { "type": "text", "id": "price", "label": "Price", "default": "$128" },
        { "type": "text", "id": "price_old", "label": "Old price", "default": "$150" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "default": "Bestseller" },
        { "type": "url", "id": "link", "label": "Product link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "blocks": [
        { "type": "product", "settings": { "name": "The Essence", "name_cn": "本 源", "category": "Minimal · Daily Wear", "price": "$128", "price_old": "$150", "badge": "Bestseller" } },
        { "type": "product", "settings": { "name": "The Dynasty", "name_cn": "朝 儀", "category": "Nanhong Agate · Cloisonné", "price": "$268", "price_old": "$310", "badge": "Signature" } },
        { "type": "product", "settings": { "name": "The Whisper", "name_cn": "心 語", "category": "Hetian Jade · Woven", "price": "$98", "price_old": "$120", "badge": "" } },
        { "type": "product", "settings": { "name": "The Aurum", "name_cn": "鎏 金", "category": "Gold Vermeil · Turquoise", "price": "$188", "price_old": "$220", "badge": "New" } },
        { "type": "product", "settings": { "name": "The Halo", "name_cn": "流 光", "category": "Cat's Eye · Carnelian", "price": "$148", "price_old": "$175", "badge": "" } },
        { "type": "product", "settings": { "name": "The Gourd", "name_cn": "福 祿", "category": "Gold Hulu · CZ Pendant", "price": "$198", "price_old": "$230", "badge": "Limited" } }
      ]
    }
  ]
}
{% endschema %}
<section id="bracelets" style="padding-top:80px">
  <div class="container">
    <div style="text-align:center;max-width:700px;margin:0 auto">
      <div class="sec-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="sec-title">{{ section.settings.title }}<span class="cn">{{ section.settings.title_cn }}</span></h2>
      <p class="sec-lead" style="margin:0 auto">{{ section.settings.lead }}</p>
    </div>
    <div class="prod-grid">
      {% if section.blocks.size > 0 %}
        {% assign defaults = "The Essence|本 源|Minimal · Daily Wear|$128|$150|Bestseller|p01.jpg||The Dynasty|朝 儀|Nanhong Agate · Cloisonné|$268|$310|Signature|p02.jpg||The Whisper|心 語|Hetian Jade · Woven|$98|$120||p03.jpg||The Aurum|鎏 金|Gold Vermeil · Turquoise|$188|$220|New|p04.jpg||The Halo|流 光|Cat's Eye · Carnelian|$148|$175||p05.jpg||The Gourd|福 祿|Gold Hulu · CZ Pendant|$198|$230|Limited|p06.jpg|" | split: "|" %}
        {% for block in section.blocks %}
          {% assign i = forloop.index0 | times: 8 %}
          {% if i < 48 %}
            {% assign d_name = defaults[i] %}
            {% assign d_cn = defaults[i+1] %}
            {% assign d_cat = defaults[i+2] %}
            {% assign d_price = defaults[i+3] %}
            {% assign d_old = defaults[i+4] %}
            {% assign d_badge = defaults[i+5] %}
            {% assign d_img = defaults[i+6] %}
          {% else %}
            {% assign d_name = block.settings.name %}
            {% assign d_cn = block.settings.name_cn %}
            {% assign d_cat = block.settings.category %}
            {% assign d_price = block.settings.price %}
            {% assign d_old = block.settings.price_old %}
            {% assign d_badge = block.settings.badge %}
            {% assign d_img = '' %}
          {% endif %}
          <a href="{{ block.settings.link | default: '#' }}" class="pcard" {{ block.shopify_attributes }}>
            <div class="pcard-img">
              {% assign badge = block.settings.badge | default: d_badge %}
              {% if badge != blank %}<span class="pcard-badge">{{ badge }}</span>{% endif %}
              {% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.name | default: d_name }}">
              {% else %}<img src="{{ d_img | asset_url }}" alt="{{ block.settings.name | default: d_name }}">{% endif %}
            </div>
            <div class="pcard-body">
              <div class="pcard-cat">{{ block.settings.category | default: d_cat }}</div>
              <div class="pcard-name">{{ block.settings.name | default: d_name }}</div>
              <div class="pcard-cn">{{ block.settings.name_cn | default: d_cn }}</div>
              <div class="pcard-price">{{ block.settings.price | default: d_price }}{% assign old_p = block.settings.price_old | default: d_old %}{% if old_p != blank %}<span class="old">{{ old_p }}</span>{% endif %}</div>
              <div class="pcard-pay">or 4 payments of {{ (block.settings.price | default: d_price) | remove: '$' | divided_by: 4 | round: 2 | prepend: '$' }}</div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <div class="pcard"><div class="pcard-img"><span class="pcard-badge">Bestseller</span><img src="{{ 'p01.jpg' | asset_url }}" alt="The Essence"></div><div class="pcard-body"><div class="pcard-cat">Minimal · Daily Wear</div><div class="pcard-name">The Essence</div><div class="pcard-cn">本 源</div><div class="pcard-price">$128<span class="old">$150</span></div><div class="pcard-pay">or 4 payments of $32.00</div></div></div>
        <div class="pcard"><div class="pcard-img"><span class="pcard-badge">Signature</span><img src="{{ 'p02.jpg' | asset_url }}" alt="The Dynasty"></div><div class="pcard-body"><div class="pcard-cat">Nanhong Agate · Cloisonné</div><div class="pcard-name">The Dynasty</div><div class="pcard-cn">朝 儀</div><div class="pcard-price">$268<span class="old">$310</span></div><div class="pcard-pay">or 4 payments of $67.00</div></div></div>
        <div class="pcard"><div class="pcard-img"><img src="{{ 'p03.jpg' | asset_url }}" alt="The Whisper"></div><div class="pcard-body"><div class="pcard-cat">Hetian Jade · Woven</div><div class="pcard-name">The Whisper</div><div class="pcard-cn">心 語</div><div class="pcard-price">$98<span class="old">$120</span></div><div class="pcard-pay">or 4 payments of $24.50</div></div></div>
        <div class="pcard"><div class="pcard-img"><span class="pcard-badge">New</span><img src="{{ 'p04.jpg' | asset_url }}" alt="The Aurum"></div><div class="pcard-body"><div class="pcard-cat">Gold Vermeil · Turquoise</div><div class="pcard-name">The Aurum</div><div class="pcard-cn">鎏 金</div><div class="pcard-price">$188<span class="old">$220</span></div><div class="pcard-pay">or 4 payments of $47.00</div></div></div>
        <div class="pcard"><div class="pcard-img"><img src="{{ 'p05.jpg' | asset_url }}" alt="The Halo"></div><div class="pcard-body"><div class="pcard-cat">Cat's Eye · Carnelian</div><div class="pcard-name">The Halo</div><div class="pcard-cn">流 光</div><div class="pcard-price">$148<span class="old">$175</span></div><div class="pcard-pay">or 4 payments of $37.00</div></div></div>
        <div class="pcard"><div class="pcard-img"><span class="pcard-badge">Limited</span><img src="{{ 'p06.jpg' | asset_url }}" alt="The Gourd"></div><div class="pcard-body"><div class="pcard-cat">Gold Hulu · CZ Pendant</div><div class="pcard-name">The Gourd</div><div class="pcard-cn">福 祿</div><div class="pcard-price">$198<span class="old">$230</span></div><div class="pcard-pay">or 4 payments of $49.50</div></div></div>
      {% endif %}
    </div>
  </div>
</section>
