{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "title", "label": "Title", "default": "The CHENSHA Selection" },
    { "type": "text", "id": "title_cn", "label": "Chinese title", "default": "精選之作" }
  ]
}
{% endschema %}
<section id="bracelets" style="padding-top:80px">
  <div class="container">
    <div style="text-align:center;max-width:700px;margin:0 auto">
      <div class="sec-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="sec-title">{{ section.settings.title }}<span class="cn">{{ section.settings.title_cn }}</span></h2>
      <p class="sec-lead" style="margin:0 auto">Each piece is hand-assembled with authentic cinnabar and paired with symbolic materials &mdash; jade, gold vermeil, cloisonn&eacute;, and cat's eye &mdash; chosen for meaning as much as beauty.</p>
    </div>

    <div class="prod-grid">

      <div class="pcard">
        <div class="pcard-img">
          <span class="pcard-badge">Bestseller</span>
          <img src="{{ 'p01.jpg' | asset_url }}" alt="The Essence">
        </div>
        <div class="pcard-body">
          <div class="pcard-cat">Minimal &middot; Daily Wear</div>
          <div class="pcard-name">The Essence</div>
          <div class="pcard-cn">本 源</div>
          <div class="pcard-price">$128<span class="old">$150</span></div>
          <div class="pcard-pay">or 4 payments of $32.00</div>
        </div>
      </div>

      <div class="pcard">
        <div class="pcard-img">
          <span class="pcard-badge">Signature</span>
          <img src="{{ 'p02.jpg' | asset_url }}" alt="The Dynasty">
        </div>
        <div class="pcard-body">
          <div class="pcard-cat">Nanhong Agate &middot; Cloisonn&eacute;</div>
          <div class="pcard-name">The Dynasty</div>
          <div class="pcard-cn">朝 儀</div>
          <div class="pcard-price">$268<span class="old">$310</span></div>
          <div class="pcard-pay">or 4 payments of $67.00</div>
        </div>
      </div>

      <div class="pcard">
        <div class="pcard-img">
          <img src="{{ 'p03.jpg' | asset_url }}" alt="The Whisper">
        </div>
        <div class="pcard-body">
          <div class="pcard-cat">Hetian Jade &middot; Woven</div>
          <div class="pcard-name">The Whisper</div>
          <div class="pcard-cn">心 語</div>
          <div class="pcard-price">$98<span class="old">$120</span></div>
          <div class="pcard-pay">or 4 payments of $24.50</div>
        </div>
      </div>

      <div class="pcard">
        <div class="pcard-img">
          <span class="pcard-badge">New</span>
          <img src="{{ 'p04.jpg' | asset_url }}" alt="The Aurum">
        </div>
        <div class="pcard-body">
          <div class="pcard-cat">Gold Vermeil &middot; Turquoise</div>
          <div class="pcard-name">The Aurum</div>
          <div class="pcard-cn">鎏 金</div>
          <div class="pcard-price">$188<span class="old">$220</span></div>
          <div class="pcard-pay">or 4 payments of $47.00</div>
        </div>
      </div>

      <div class="pcard">
        <div class="pcard-img">
          <img src="{{ 'p05.jpg' | asset_url }}" alt="The Halo">
        </div>
        <div class="pcard-body">
          <div class="pcard-cat">Cat's Eye &middot; Carnelian</div>
          <div class="pcard-name">The Halo</div>
          <div class="pcard-cn">流 光</div>
          <div class="pcard-price">$148<span class="old">$175</span></div>
          <div class="pcard-pay">or 4 payments of $37.00</div>
        </div>
      </div>

      <div class="pcard">
        <div class="pcard-img">
          <span class="pcard-badge">Limited</span>
          <img src="{{ 'p06.jpg' | asset_url }}" alt="The Gourd">
        </div>
        <div class="pcard-body">
          <div class="pcard-cat">Gold Hulu &middot; CZ Pendant</div>
          <div class="pcard-name">The Gourd</div>
          <div class="pcard-cn">福 祿</div>
          <div class="pcard-price">$198<span class="old">$230</span></div>
          <div class="pcard-pay">or 4 payments of $49.50</div>
        </div>
      </div>

    </div>
  </div>
</section>
