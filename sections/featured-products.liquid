{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "title", "label": "Title", "default": "The CHENSHA Selection" },
    { "type": "text", "id": "title_cn", "label": "Chinese title", "default": "精選之作" },
    { "type": "textarea", "id": "lead", "label": "Lead text", "default": "Each piece is hand-assembled with authentic cinnabar and paired with symbolic materials — jade, gold vermeil, cloisonné, and cat's eye — chosen for meaning as much as beauty." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product image" },
        { "type": "text", "id": "name", "label": "Product name", "default": "The Essence" },
        { "type": "text", "id": "name_cn", "label": "Chinese name", "default": "本 源" },
        { "type": "text", "id": "category", "label": "Category", "default": "Minimal · Daily Wear" },
        { "type": "text", "id": "price", "label": "Price", "default": "$128" },
        { "type": "text", "id": "price_old", "label": "Old price", "default": "$150" },
        { "type": "text", "id": "pay", "label": "Installment text", "default": "or 4 payments of $32.00" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "default": "Bestseller" },
        { "type": "url", "id": "link", "label": "Product link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "blocks": [
        { "type": "product", "settings": { "name": "The Essence", "name_cn": "本 源", "category": "Minimal · Daily Wear", "price": "$128", "price_old": "$150", "pay": "or 4 payments of $32.00", "badge": "Bestseller" } },
        { "type": "product", "settings": { "name": "The Dynasty", "name_cn": "朝 儀", "category": "Nanhong Agate · Cloisonné", "price": "$268", "price_old": "$310", "pay": "or 4 payments of $67.00", "badge": "Signature" } },
        { "type": "product", "settings": { "name": "The Whisper", "name_cn": "心 語", "category": "Hetian Jade · Woven", "price": "$98", "price_old": "$120", "pay": "or 4 payments of $24.50", "badge": "" } },
        { "type": "product", "settings": { "name": "The Aurum", "name_cn": "鎏 金", "category": "Gold Vermeil · Turquoise", "price": "$188", "price_old": "$220", "pay": "or 4 payments of $47.00", "badge": "New" } },
        { "type": "product", "settings": { "name": "The Halo", "name_cn": "流 光", "category": "Cat's Eye · Carnelian", "price": "$148", "price_old": "$175", "pay": "or 4 payments of $37.00", "badge": "" } },
        { "type": "product", "settings": { "name": "The Gourd", "name_cn": "福 祿", "category": "Gold Hulu · CZ Pendant", "price": "$198", "price_old": "$230", "pay": "or 4 payments of $49.50", "badge": "Limited" } }
      ]
    }
  ]
}
{% endschema %}
<section id="bracelets" style="padding-top:80px">
  <div class="container">
    <div style="text-align:center;max-width:700px;margin:0 auto">
      <div class="sec-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="sec-title">{{ section.settings.title }}<span class="cn">{{ section.settings.title_cn }}</span></h2>
      <p class="sec-lead" style="margin:0 auto">{{ section.settings.lead }}</p>
    </div>
    <div class="prod-grid">
      {% for block in section.blocks %}
        <div class="pcard" {{ block.shopify_attributes }}>
          <div class="pcard-img">
            {% if block.settings.badge != blank %}<span class="pcard-badge">{{ block.settings.badge }}</span>{% endif %}
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.name }}">
            {% else %}
              <img src="{{ 'p01.jpg' | asset_url }}" alt="{{ block.settings.name }}">
            {% endif %}
          </div>
          <div class="pcard-body">
            <div class="pcard-cat">{{ block.settings.category }}</div>
            <div class="pcard-name">{{ block.settings.name }}</div>
            <div class="pcard-cn">{{ block.settings.name_cn }}</div>
            <div class="pcard-price">{{ block.settings.price }}{% if block.settings.price_old != blank %}<span class="old">{{ block.settings.price_old }}</span>{% endif %}</div>
            <div class="pcard-pay">{{ block.settings.pay }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
