{% schema %}
{
  "name": "Packaging",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The CHENSHA Experience" },
    { "type": "text", "id": "title", "label": "Title", "default": "Wrapped in Red & Gold" },
    { "type": "text", "id": "title_cn", "label": "Chinese title", "default": "開 盒 之 禮" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Every order arrives in our signature ivory keepsake box, tied with a black grosgrain ribbon and finished with a velveteen pouch and certificate of authenticity." },
    { "type": "image_picker", "id": "image", "label": "Packaging image" },
    { "type": "text", "id": "li1", "label": "Feature 1", "default": "Signature keepsake box — reusable, magnetic closure, lined in ivory." },
    { "type": "text", "id": "li2", "label": "Feature 2", "default": "Velveteen travel pouch — gold-foil stamped, protects your piece on the go." },
    { "type": "text", "id": "li3", "label": "Feature 3", "default": "Certificate of Authenticity — signed, numbered, with origin and care guide." },
    { "type": "text", "id": "li4", "label": "Feature 4", "default": "Ribbon & card — gift-ready by default." }
  ]
}
{% endschema %}
<section>
  <div class="container pack-grid">
    <div class="pack-img">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="CHENSHA packaging">
      {% else %}
        <img src="{{ 'packaging.jpg' | asset_url }}" alt="CHENSHA gift packaging">
      {% endif %}
    </div>
    <div>
      <div class="sec-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="sec-title">{{ section.settings.title }}<span class="cn">{{ section.settings.title_cn }}</span></h2>
      <p class="sec-lead">{{ section.settings.lead }}</p>
      <ul class="pack-list">
        {% for i in (1..4) %}
          <li><span class="dot"></span><span>{{ section.settings['li' | append: i] }}</span></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
