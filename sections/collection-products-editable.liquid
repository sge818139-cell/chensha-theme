<section class="collection-products">
  <div class="container collection-layout">
    <!-- 左侧筛选栏 -->
    <aside class="collection-sidebar">
      <div class="filter-title">{{ section.settings.filter_title }}</div>
      <div class="filter-group">
        <div class="filter-label" data-filter="intention">{{ section.settings.filter_1 }} <span class="filter-plus">+</span></div>
        <div class="filter-options" data-options="intention">
          <label class="filter-option"><input type="checkbox" value="protection"> Protection</label>
          <label class="filter-option"><input type="checkbox" value="fortune"> Fortune</label>
          <label class="filter-option"><input type="checkbox" value="love"> Love & Harmony</label>
          <label class="filter-option"><input type="checkbox" value="health"> Health</label>
          <label class="filter-option"><input type="checkbox" value="wisdom"> Wisdom</label>
        </div>
      </div>
      <div class="filter-group">
        <div class="filter-label" data-filter="symbol">{{ section.settings.filter_2 }} <span class="filter-plus">+</span></div>
        <div class="filter-options" data-options="symbol">
          <label class="filter-option"><input type="checkbox" value="pixiu"> Pixiu</label>
          <label class="filter-option"><input type="checkbox" value="gourd"> Hulu Gourd</label>
          <label class="filter-option"><input type="checkbox" value="knot"> Peace Knot</label>
          <label class="filter-option"><input type="checkbox" value="beads"> Beads</label>
          <label class="filter-option"><input type="checkbox" value="pingankou"> Ping An Kou</label>
        </div>
      </div>
      <div class="filter-group">
        <div class="filter-label" data-filter="material">{{ section.settings.filter_3 }} <span class="filter-plus">+</span></div>
        <div class="filter-options" data-options="material">
          <label class="filter-option"><input type="checkbox" value="pure-cinnabar"> Pure Cinnabar</label>
          <label class="filter-option"><input type="checkbox" value="cinnabar-gold"> Cinnabar + Gold</label>
          <label class="filter-option"><input type="checkbox" value="cinnabar-jade"> Cinnabar + Jade</label>
          <label class="filter-option"><input type="checkbox" value="black-cord"> Black Cord</label>
          <label class="filter-option"><input type="checkbox" value="brown-cord"> Brown Cord</label>
        </div>
      </div>
      <div class="filter-group">
        <div class="filter-label" data-filter="price">{{ section.settings.filter_4 }} <span class="filter-plus">+</span></div>
        <div class="filter-options" data-options="price">
          <label class="filter-option"><input type="checkbox" value="under-100"> Under $100</label>
          <label class="filter-option"><input type="checkbox" value="100-200"> $100 - $200</label>
          <label class="filter-option"><input type="checkbox" value="200-300"> $200 - $300</label>
          <label class="filter-option"><input type="checkbox" value="over-300"> $300+</label>
        </div>
      </div>
    </aside>

    <!-- 右侧产品网格 -->
    <div class="collection-main">
      <div class="collection-toolbar">
        <div class="collection-count">{{ section.settings.product_count_text }}</div>
        <div class="collection-sort">{{ section.settings.sort_text }}</div>
      </div>
      <div class="prod-grid" id="productGrid">
        {% for block in section.blocks %}
          {% assign product_index = forloop.index0 | plus: 1 %}
          {% case product_index %}
            {% when 1 %}{% assign product_tags = "pixiu,fortune,cinnabar-gold,100-200" %}
            {% when 2 %}{% assign product_tags = "beads,wisdom,pure-cinnabar,black-cord,200-300" %}
            {% when 3 %}{% assign product_tags = "pingankou,protection,pure-cinnabar,black-cord,100-200" %}
            {% when 4 %}{% assign product_tags = "pingankou,protection,pure-cinnabar,black-cord,100-200" %}
            {% when 5 %}{% assign product_tags = "beads,wisdom,pure-cinnabar,brown-cord,150-250" %}
            {% when 6 %}{% assign product_tags = "gourd,protection,cinnabar-gold,brown-cord,100-200" %}
            {% when 7 %}{% assign product_tags = "beads,wisdom,cinnabar-gold,brown-cord,100-200" %}
            {% when 8 %}{% assign product_tags = "beads,wisdom,cinnabar-gold,brown-cord,150-250" %}
            {% when 9 %}{% assign product_tags = "beads,love,pure-cinnabar,brown-cord,80-150" %}
            {% when 10 %}{% assign product_tags = "knot,love,cinnabar-gold,black-cord,100-200" %}
            {% when 11 %}{% assign product_tags = "beads,wisdom,pure-cinnabar,200-300" %}
            {% when 12 %}{% assign product_tags = "beads,wisdom,pure-cinnabar,brown-cord,150-250" %}
            {% else %}{% assign product_tags = "" %}
          {% endcase %}
          <div class="pcard" data-tags="{{ product_tags }}" data-index="{{ product_index }}">
            <div class="pcard-img">
              {% if block.settings.image != blank %}
                <a href="{{ block.settings.link }}">
                  <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}">
                </a>
              {% else %}
                <a href="{{ block.settings.link }}">
                  <img src="{{ 'p0' | append: product_index | append: '.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}">
                </a>
              {% endif %}
            </div>
            <div class="pcard-body">
              <div class="pcard-name"><a href="{{ block.settings.link }}">{{ block.settings.title }}</a></div>
              <div class="pcard-price">{{ block.settings.price }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Grid - Cinnabar",
  "settings": [
    { "type": "text", "id": "filter_title", "label": "Filter Title", "default": "FILTER BY" },
    { "type": "text", "id": "filter_1", "label": "Filter 1", "default": "Intention" },
    { "type": "text", "id": "filter_2", "label": "Filter 2", "default": "Symbol" },
    { "type": "text", "id": "filter_3", "label": "Filter 3", "default": "Material" },
    { "type": "text", "id": "filter_4", "label": "Filter 4", "default": "Price" },
    { "type": "text", "id": "product_count_text", "label": "Product Count Text", "default": "9 RESULTS" },
    { "type": "text", "id": "sort_text", "label": "Sort Text", "default": "SORT BY: NEWEST ↓" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "text", "id": "title", "label": "Product Title", "default": "Product Name" },
        { "type": "text", "id": "price", "label": "Price", "default": "$0.00" },
        { "type": "url", "id": "link", "label": "Product Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "default": {
    "blocks": [
      { "type": "product", "settings": { "title": "CINNABAR BRACELETS", "price": "$168.00" } },
      { "type": "product", "settings": { "title": "CLOISONNÉ & GOLD", "price": "$178.00" } },
      { "type": "product", "settings": { "title": "GOLD GOURD CHARM", "price": "$188.00" } },
      { "type": "product", "settings": { "title": "TURQUOISE & GOLD", "price": "$158.00" } },
      { "type": "product", "settings": { "title": "NORTH STAR BRACELET", "price": "$168.00" } },
      { "type": "product", "settings": { "title": "DIVINE EYE CHARM", "price": "$188.00" } }
    ]
  }
}
{% endschema %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap');

.collection-sidebar {
  width: 240px;
  flex-shrink: 0;
  padding-right: 40px;
}

.filter-title {
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
  font-size: 18px;
  letter-spacing: 2px;
  color: #2A1F1A;
  margin-bottom: 30px;
  padding-bottom: 15px;
  border-bottom: 1px solid #E8E0D5;
}

.filter-group {
  border-bottom: 1px solid #E8E0D5;
  padding: 15px 0;
}

.filter-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: 'Noto Serif SC', 'Cormorant Garamond', serif;
  font-size: 14px;
  font-weight: 400;
  color: #5A4A42;
  cursor: pointer;
  transition: color 0.3s;
}

.filter-label:hover {
  color: #9E2B25;
}

.filter-plus {
  font-size: 18px;
  font-weight: 300;
  transition: transform 0.3s;
}

.filter-group.active .filter-plus {
  transform: rotate(45deg);
}

.filter-options {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.filter-group.active .filter-options {
  max-height: 300px;
  padding-top: 15px;
}

.filter-option {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  font-family: 'Noto Serif SC', 'Cormorant Garamond', serif;
  font-size: 13px;
  color: #8A7A72;
  cursor: pointer;
  transition: color 0.3s;
}

.filter-option:hover {
  color: #9E2B25;
}

.filter-option input[type="checkbox"] {
  width: 14px;
  height: 14px;
  accent-color: #9E2B25;
}

.collection-layout {
  display: flex;
  gap: 40px;
  padding: 60px 0;
}

.collection-main {
  flex: 1;
}

.collection-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  padding-bottom: 15px;
  border-bottom: 1px solid #E8E0D5;
}

.collection-count, .collection-sort {
  font-family: 'Noto Serif SC', 'Cormorant Garamond', serif;
  font-size: 13px;
  color: #8A7A72;
  letter-spacing: 1px;
}

.prod-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.pcard {
  background: #fff;
  border-radius: 4px;
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
}

.pcard:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 30px rgba(158, 43, 37, 0.1);
}

.pcard-img {
  aspect-ratio: 4/5;
  overflow: hidden;
  background: #FAF6F0;
}

.pcard-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
}

.pcard:hover .pcard-img img {
  transform: scale(1.05);
}

.pcard-body {
  padding: 16px;
  text-align: center;
}

.pcard-name {
  font-family: 'Noto Serif SC', 'Cormorant Garamond', serif;
  font-size: 14px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 6px;
  line-height: 1.4;
}

.pcard-name a {
  color: inherit;
  text-decoration: none;
}

.pcard-price {
  font-family: 'Noto Serif SC', 'Cormorant Garamond', serif;
  font-size: 13px;
  color: #9E2B25;
  font-weight: 500;
}

@media (max-width: 1200px) {
  .prod-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 1024px) {
  .collection-layout {
    flex-direction: column;
  }
  .collection-sidebar {
    width: 100%;
    padding-right: 0;
  }
  .prod-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .prod-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // 筛选展开/收起
  document.querySelectorAll('.filter-label').forEach(function(label) {
    label.addEventListener('click', function() {
      const group = this.closest('.filter-group');
      group.classList.toggle('active');
    });
  });

  // 产品筛选功能
  function getProductCards() {
    return document.querySelectorAll('#productGrid .pcard');
  }

  function getCheckboxes() {
    return document.querySelectorAll('.filter-option input[type="checkbox"]');
  }

  function getPriceFromCard(card) {
    const priceEl = card.querySelector('.pcard-price');
    if (!priceEl) return 0;
    const priceText = priceEl.textContent || '';
    const priceMatch = priceText.match(/[\d.]+/);
    return priceMatch ? parseFloat(priceMatch[0]) : 0;
  }

  function filterProducts() {
    const activeFilters = {
      intention: [],
      symbol: [],
      material: [],
      price: []
    };

    const checkboxes = getCheckboxes();
    // 收集选中的筛选条件
    checkboxes.forEach(function(cb) {
      if (cb.checked) {
        const group = cb.closest('.filter-options');
        const type = group.dataset.options;
        activeFilters[type].push(cb.value);
      }
    });

    // 过滤产品
    const productCards = getProductCards();
    productCards.forEach(function(card) {
      const tags = (card.dataset.tags || '').split(',').map(t => t.trim()).filter(t => t);
      const price = getPriceFromCard(card);
      let show = true;

      // 检查每个筛选维度
      for (const [filterType, values] of Object.entries(activeFilters)) {
        if (values.length === 0) continue;

        if (filterType === 'price') {
          // 价格筛选
          let priceMatch = false;
          values.forEach(function(range) {
            if (range === 'under-100' && price < 100) priceMatch = true;
            if (range === '100-200' && price >= 100 && price <= 200) priceMatch = true;
            if (range === '200-300' && price >= 200 && price <= 300) priceMatch = true;
            if (range === 'over-300' && price > 300) priceMatch = true;
          });
          if (!priceMatch) show = false;
        } else {
          // 标签筛选
          const tagMatch = values.some(v => tags.includes(v));
          if (!tagMatch) show = false;
        }
      }

      card.style.display = show ? 'block' : 'none';
    });

    // 更新结果计数
    const visibleCount = document.querySelectorAll('#productGrid .pcard:not([style*="display: none"])').length;
    const countEl = document.querySelector('.collection-count');
    if (countEl) {
      countEl.textContent = visibleCount + ' RESULTS';
    }
  }

  // 绑定筛选事件
  getCheckboxes().forEach(function(cb) {
    cb.addEventListener('change', filterProducts);
  });
});
</script>
