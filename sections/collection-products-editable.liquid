<section class="collection-products">
  <div class="container collection-layout">
    <!-- 左侧筛选栏 -->
    <aside class="collection-sidebar">
      <div class="filter-title">{{ section.settings.filter_title }}</div>
      <div class="filter-group">
        <div class="filter-label">{{ section.settings.filter_1 }} <span class="filter-plus">+</span></div>
      </div>
      <div class="filter-group">
        <div class="filter-label">{{ section.settings.filter_2 }} <span class="filter-plus">+</span></div>
      </div>
      <div class="filter-group">
        <div class="filter-label">{{ section.settings.filter_3 }} <span class="filter-plus">+</span></div>
      </div>
      <div class="filter-group">
        <div class="filter-label">{{ section.settings.filter_4 }} <span class="filter-plus">+</span></div>
      </div>
    </aside>

    <!-- 右侧产品网格 -->
    <div class="collection-main">
      <div class="collection-toolbar">
        <div class="collection-count">{{ section.settings.product_count_text }}</div>
        <div class="collection-sort">{{ section.settings.sort_text }}</div>
      </div>
      <div class="prod-grid">
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            {% assign product = block.settings.product %}
            {% if product != blank %}
              <div class="pcard">
                <div class="pcard-img">
                  {% if product.featured_image %}
                    <a href="{{ product.url }}">
                      <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
                    </a>
                  {% endif %}
                </div>
                <div class="pcard-body">
                  <div class="pcard-name"><a href="{{ product.url }}">{{ product.title }}</a></div>
                  <div class="pcard-price">{{ product.price | money }}</div>
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Products",
  "settings": [
    { "type": "text", "id": "filter_title", "label": "Filter Title", "default": "FILTER BY" },
    { "type": "text", "id": "filter_1", "label": "Filter 1", "default": "Intention" },
    { "type": "text", "id": "filter_2", "label": "Filter 2", "default": "Symbol" },
    { "type": "text", "id": "filter_3", "label": "Filter 3", "default": "Material" },
    { "type": "text", "id": "filter_4", "label": "Filter 4", "default": "Price" },
    { "type": "text", "id": "product_count_text", "label": "Product Count Text", "default": "9 RESULTS" },
    { "type": "text", "id": "sort_text", "label": "Sort Text", "default": "SORT BY: NEWEST ↓" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
