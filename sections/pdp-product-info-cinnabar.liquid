<style>
.pdp-tabs-section {
  margin-top: 40px;
  padding-top: 30px;
  border-top: 1px solid #E8E0D5;
}

.pdp-tab-headers {
  display: flex;
  gap: 30px;
  margin-bottom: 25px;
  border-bottom: 1px solid #E8E0D5;
  flex-wrap: wrap;
}

.pdp-tab-header {
  background: none;
  border: none;
  padding: 0 0 12px 0;
  font-family: 'Cormorant Garamond', serif;
  font-size: 16px;
  color: #8A7A72;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: all 0.3s ease;
}

.pdp-tab-header.active {
  color: #2A1F1A;
  border-bottom-color: #9E2B25;
}

.pdp-tab-panel {
  display: none;
  font-size: 15px;
  line-height: 1.8;
  color: #5A4A42;
}

.pdp-tab-panel.active {
  display: block;
}

.pdp-tab-panel p {
  margin-bottom: 15px;
}

.pdp-tab-panel ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.pdp-tab-panel li {
  padding-left: 18px;
  position: relative;
  margin-bottom: 8px;
}

.pdp-tab-panel li:before {
  content: '•';
  position: absolute;
  left: 0;
  color: #9E2B25;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Tab switching functionality
  var tabsSection = document.querySelector('.pdp-tabs-section');
  if (tabsSection) {
    var tabHeaders = tabsSection.querySelectorAll('.pdp-tab-header');
    var tabPanels = tabsSection.querySelectorAll('.pdp-tab-panel');
    
    tabHeaders.forEach(function(header) {
      header.addEventListener('click', function() {
        var tab = this.getAttribute('data-tab');
        
        tabHeaders.forEach(function(h) { h.classList.remove('active'); });
        tabPanels.forEach(function(p) { p.classList.remove('active'); });
        
        this.classList.add('active');
        tabsSection.querySelector('.pdp-tab-panel[data-panel="' + tab + '"]').classList.add('active');
      });
    });
  }

  // Auto-sync rating text with review count from customer reviews section
  var ratingText = document.getElementById('ratingText');
  if (ratingText) {
    var reviewCountEl = document.querySelector('.review-count');
    if (reviewCountEl) {
      var reviewCountText = reviewCountEl.textContent.trim();
      if (reviewCountText) {
        // Extract the number from "X reviews"
        var match = reviewCountText.match(/(\d+)/);
        if (match) {
          var count = parseInt(match[1]);
          if (count === 0) {
            ratingText.textContent = '(No reviews yet)';
          } else {
            ratingText.textContent = '(' + reviewCountText + ')';
          }
        }
      }
    }
  }
});
</script>
