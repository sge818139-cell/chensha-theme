<section class="pdp-top-section">
  <div class="pdp-layout">

    <!-- LEFT: Gallery -->
    <div class="pdp-gallery">
      <div class="pdp-main">
        {% if product.featured_image %}
          <img id="pdpMainImg" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
        {% else %}
          <img src="{{ 'p01.jpg' | asset_url }}" alt="{{ product.title | escape }}">
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
      <div class="pdp-thumbs">
        {% for image in product.images %}
          <img src="{{ image | image_url: width: 150 }}" alt="{{ product.title | append: ' thumb' | escape }}"
               class="pdp-thumb{% if forloop.first %} active{% endif %}"
               onclick="var m=document.getElementById('pdpMainImg');m.src='{{ image | image_url: width: 1000 }}';document.querySelectorAll('.pdp-thumb').forEach(function(t){t.classList.remove('active')});this.classList.add('active')">
        {% endfor %}
      </div>
      {% endif %}
      <div class="pdp-packaging-img">
        {% if section.settings.packaging_image != blank %}
          <img src="{{ section.settings.packaging_image | image_url: width: 1000 }}" alt="CHENSHA gift packaging">
        {% else %}
          <img src="{{ 'packaging.jpg' | asset_url }}" alt="CHENSHA gift packaging">
        {% endif %}
      </div>
    </div>

    <!-- RIGHT: Info -->
    <div class="pdp-info">
      {% if product.type %}<div class="pdp-eyebrow">{{ product.type }}</div>{% endif %}
      <h1 class="pdp-title">{{ product.title }}</h1>

      <div class="pdp-price-row">
        <span class="pdp-price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="pdp-compare">{{ product.compare_at_price | money }}</span>
          <span class="pdp-sale-badge">SAVE {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span>
        {% endif %}
      </div>

      <div class="pdp-rating-row">
        <span class="pdp-stars">★★★★★</span>
        <span class="pdp-rating-text" id="ratingText">{{ section.settings.rating_text }}</span>
      </div>

      <div class="pdp-divider"></div>

      {% if product and product.available %}
      {% form 'product', product, id: 'product-form', class: 'product-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {% unless product.variants.size == 1 %}
          <div class="pdp-variants">
            {% for option in product.options_with_values %}
              <div class="pdp-option">
                <label class="pdp-option-label">{{ option.name }}</label>
                <div class="pdp-option-values">
                  {% for value in option.values %}
                    <label class="pdp-value">
                      <input type="radio" name="options[{{ option.name }}]" value="{{ value }}" {% if forloop.first %}checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endunless %}

        <div class="pdp-qty-cart">
          <div class="pdp-qty">
            <button type="button" onclick="var i=this.nextElementSibling;i.value=Math.max(1,parseInt(i.value)-1)">−</button>
            <input type="number" name="quantity" value="1" min="1">
            <button type="button" onclick="var i=this.previousElementSibling;i.value=parseInt(i.value)+1">+</button>
          </div>
          <button type="submit" name="add" class="pdp-add-btn">Add to Cart</button>
        </div>
      {% endform %}
      {% else %}
        <div class="pdp-qty-cart">
          <div class="pdp-qty">
            <button type="button">−</button>
            <input type="number" value="1" min="1" readonly>
            <button type="button">+</button>
          </div>
          <button class="pdp-add-btn" disabled>Add to Cart</button>
        </div>
      {% endif %}

      <div class="pdp-guarantees">
        <div class="pdp-guarantee">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <div><strong>{{ section.settings.guarantee1_title }}</strong><span>{{ section.settings.guarantee1_subtitle }}</span></div>
        </div>
        <div class="pdp-guarantee">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          <div><strong>{{ section.settings.guarantee2_title }}</strong><span>{{ section.settings.guarantee2_subtitle }}</span></div>
        </div>
        <div class="pdp-guarantee">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg>
          <div><strong>{{ section.settings.guarantee3_title }}</strong><span>{{ section.settings.guarantee3_subtitle }}</span></div>
        </div>
      </div>

      <!-- Product Tabs -->
      <div class="pdp-tabs-section">
        <div class="pdp-tabs">
          <div class="pdp-tab-headers">
            <button class="pdp-tab-header active" data-tab="tab1">{{ section.settings.tab1_title }}</button>
            <button class="pdp-tab-header" data-tab="tab2">{{ section.settings.tab2_title }}</button>
            <button class="pdp-tab-header" data-tab="tab3">{{ section.settings.tab3_title }}</button>
            <button class="pdp-tab-header" data-tab="tab4">{{ section.settings.tab4_title }}</button>
          </div>
          <div class="pdp-tab-content">
            <div class="pdp-tab-panel active" data-panel="tab1">
              {{ section.settings.tab1_content }}
            </div>
            <div class="pdp-tab-panel" data-panel="tab2">
              {{ section.settings.tab2_content }}
            </div>
            <div class="pdp-tab-panel" data-panel="tab3">
              {{ section.settings.tab3_content }}
            </div>
            <div class="pdp-tab-panel" data-panel="tab4">
              {{ section.settings.tab4_content }}
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
