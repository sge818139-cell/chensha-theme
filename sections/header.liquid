{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "CHENSHA" }
  ],
  "blocks": [
    { "type": "link", "name": "Menu link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Collections" },
      { "type": "url", "id": "url", "label": "URL" }
    ]}
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "link", "settings": { "label": "Collections" } },
        { "type": "link", "settings": { "label": "Bracelets" } },
        { "type": "link", "settings": { "label": "Our Story" } },
        { "type": "link", "settings": { "label": "Craft" } },
        { "type": "link", "settings": { "label": "Journal" } }
      ]
    }
  ]
}
{% endschema %}
<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a href="{{ routes.root_url }}" class="logo">
      {% assign logo = section.settings.logo_text | default: 'CHENSHA' %}
      {% assign mid = logo.size | divided_by: 2 | ceil %}
      {{ logo | slice: 0, mid }}<span>{{ logo | slice: mid, logo.size }}</span>
    </a>
    <ul class="nav-links" id="navLinks">
      <li><a href="/#collections">Collections</a></li>
      <li><a href="/#bracelets">Bracelets</a></li>
      <li><a href="/#origin">Our Story</a></li>
      <li><a href="/#craft">Craft</a></li>
      <li><a href="/#journal">Journal</a></li>
    </ul>
    <div class="header-icons">
      <div class="currency-selector">
        <button class="currency-btn" id="currencyBtn">
          <span class="currency-flag">{{ cart.currency.iso_code | slice: 0, 2 }}</span>
          <span class="currency-code">{{ cart.currency.iso_code }} $</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="currency-dropdown" id="currencyDropdown">
          <div class="currency-dropdown-title">Select Region / Currency</div>
          {% for currency in shop.enabled_currencies %}
            <a href="?currency={{ currency.iso_code }}" class="currency-option {% if currency.iso_code == cart.currency.iso_code %}active{% endif %}">
              <span class="currency-flag">{{ currency.iso_code | slice: 0, 2 }}</span>
              <span>{{ currency.iso_code }}</span>
            </a>
          {% endfor %}
          {% if shop.enabled_currencies.size <= 1 %}
            <a href="?currency=USD" class="currency-option {% if cart.currency.iso_code == 'USD' %}active{% endif %}">
              <span class="currency-flag">US</span>
              <span>USD — United States</span>
            </a>
            <a href="?currency=EUR" class="currency-option">
              <span class="currency-flag">EU</span>
              <span>EUR — Europe</span>
            </a>
            <a href="?currency=SGD" class="currency-option">
              <span class="currency-flag">SG</span>
              <span>SGD — Singapore</span>
            </a>
            <a href="?currency=TWD" class="currency-option">
              <span class="currency-flag">TW</span>
              <span>TWD — Taiwan</span>
            </a>
            <a href="?currency=MYR" class="currency-option">
              <span class="currency-flag">MY</span>
              <span>MYR — Malaysia</span>
            </a>
          {% endif %}
        </div>
      </div>
      <svg viewBox="0 0 24 24" class="icon-search"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <a href="{{ routes.account_url }}" class="icon-link"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
      <a href="{{ routes.cart_url }}" class="cart-count" data-count="{{ cart.item_count }}">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      </a>
      <button class="menu-toggle" id="menuToggle" aria-label="Menu">
        <svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>
