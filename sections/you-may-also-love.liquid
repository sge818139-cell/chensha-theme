<section class="you-may-also-love-section">
  <div class="container">
    <h2 class="related-title">{{ section.settings.title }}</h2>
    
    <div class="related-grid">
      <a href="{{ section.settings.product_1_link }}" class="related-card">
        <div class="related-image">
          {% if section.settings.product_1_image != blank %}
            <img src="{{ section.settings.product_1_image | image_url: width: 500 }}" alt="{{ section.settings.product_1_name | escape }}">
          {% else %}
            <img src="{{ 'product-bracelet.jpg' | asset_url }}" alt="{{ section.settings.product_1_name | escape }}">
          {% endif %}
        </div>
        <div class="related-info">
          <div class="related-name">{{ section.settings.product_1_name }}</div>
          <div class="related-price">{{ section.settings.product_1_price }}</div>
        </div>
      </a>

      <a href="{{ section.settings.product_2_link }}" class="related-card">
        <div class="related-image">
          {% if section.settings.product_2_image != blank %}
            <img src="{{ section.settings.product_2_image | image_url: width: 500 }}" alt="{{ section.settings.product_2_name | escape }}">
          {% else %}
            <img src="{{ 'product-necklace.jpg' | asset_url }}" alt="{{ section.settings.product_2_name | escape }}">
          {% endif %}
        </div>
        <div class="related-info">
          <div class="related-name">{{ section.settings.product_2_name }}</div>
          <div class="related-price">{{ section.settings.product_2_price }}</div>
        </div>
      </a>

      <a href="{{ section.settings.product_3_link }}" class="related-card">
        <div class="related-image">
          {% if section.settings.product_3_image != blank %}
            <img src="{{ section.settings.product_3_image | image_url: width: 500 }}" alt="{{ section.settings.product_3_name | escape }}">
          {% else %}
            <img src="{{ 'product-ring.jpg' | asset_url }}" alt="{{ section.settings.product_3_name | escape }}">
          {% endif %}
        </div>
        <div class="related-info">
          <div class="related-name">{{ section.settings.product_3_name }}</div>
          <div class="related-price">{{ section.settings.product_3_price }}</div>
        </div>
      </a>

      <a href="{{ section.settings.product_4_link }}" class="related-card">
        <div class="related-image">
          {% if section.settings.product_4_image != blank %}
            <img src="{{ section.settings.product_4_image | image_url: width: 500 }}" alt="{{ section.settings.product_4_name | escape }}">
          {% else %}
            <img src="{{ 'product-earrings.jpg' | asset_url }}" alt="{{ section.settings.product_4_name | escape }}">
          {% endif %}
        </div>
        <div class="related-info">
          <div class="related-name">{{ section.settings.product_4_name }}</div>
          <div class="related-price">{{ section.settings.product_4_price }}</div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
.you-may-also-love-section {
  padding: 80px 0;
  background: #FAF8F4;
}

.related-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 32px;
  font-weight: 400;
  color: #2A1F1A;
  text-align: center;
  margin-bottom: 50px;
}

.related-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.related-card {
  text-decoration: none;
  color: inherit;
  transition: transform 0.3s ease;
}

.related-card:hover {
  transform: translateY(-5px);
}

.related-image {
  aspect-ratio: 1;
  background: #F4EDE2;
  margin-bottom: 15px;
  overflow: hidden;
}

.related-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.related-name {
  font-size: 15px;
  color: #2A1F1A;
  margin-bottom: 5px;
  line-height: 1.4;
}

.related-price {
  font-size: 14px;
  color: #9E2B25;
}

@media (max-width: 768px) {
  .related-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .related-title {
    font-size: 24px;
  }
}
</style>

