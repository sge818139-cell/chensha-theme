<section class="you-may-also-love-section">
  <div class="container">
    <h2 class="related-title">{{ section.settings.title }}</h2>
    
    <div class="related-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="related-card">
          <div class="related-image">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.name | escape }}">
            {% else %}
              <div class="image-placeholder">Product Image</div>
            {% endif %}
          </div>
          <div class="related-info">
            <div class="related-name">{{ block.settings.name }}</div>
            <div class="related-price">{{ block.settings.price }}</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.you-may-also-love-section {
  padding: 80px 0;
  background: #FAF8F4;
}

.related-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 32px;
  font-weight: 400;
  color: #2A1F1A;
  text-align: center;
  margin-bottom: 50px;
}

.related-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.related-card {
  text-decoration: none;
  color: inherit;
  transition: transform 0.3s ease;
}

.related-card:hover {
  transform: translateY(-5px);
}

.related-image {
  aspect-ratio: 1;
  background: #F4EDE2;
  margin-bottom: 15px;
  overflow: hidden;
}

.related-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8A7A72;
  font-size: 14px;
}

.related-name {
  font-size: 15px;
  color: #2A1F1A;
  margin-bottom: 5px;
  line-height: 1.4;
}

.related-price {
  font-size: 14px;
  color: #9E2B25;
}

@media (max-width: 768px) {
  .related-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .related-title {
    font-size: 24px;
  }
}
</style>

{% schema %}
{
  "name": "You May Also Love",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "You May Also Love"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Product Name",
          "default": "Cinnabar Bead Bracelet"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Product Price",
          "default": "$128.00"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "You May Also Love",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "name": "Cinnabar Bead Bracelet",
            "price": "$128.00"
          }
        },
        {
          "type": "product",
          "settings": {
            "name": "Cinnabar Pendant Necklace",
            "price": "$168.00"
          }
        },
        {
          "type": "product",
          "settings": {
            "name": "Cinnabar Ring",
            "price": "$98.00"
          }
        },
        {
          "type": "product",
          "settings": {
            "name": "Cinnabar Earrings",
            "price": "$88.00"
          }
        }
      ]
    }
  ]
}
{% endschema %}
