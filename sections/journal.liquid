<section class="journal-section" id="journal">
  <div class="container">
    <div class="sec-head center">
      <div class="sec-eyebrow">CHAPT 03 · JOURNAL</div>
      <h2 class="sec-title">{{ section.settings.title | default: 'CHENSHA Journal' }}</h2>
      <p class="sec-sub" style="font-family:'Cormorant Garamond','Noto Serif SC',serif;font-size:18px;font-style:italic;color:var(--ink-light);max-width:500px;margin:16px auto 0;line-height:1.6;letter-spacing:0.01em;">{{ section.settings.subtitle | default: 'Stories of craft, meaning and the art of wearing cinnabar.' }}</p>
    </div>
    <div class="journal-grid">

      <a href="{{ section.settings.post1_link | default: '/blogs/journal' }}" class="journal-card">
        <div class="journal-img">
          {% if section.settings.post1_image != blank %}
            <img src="{{ section.settings.post1_image | image_url: width: 600 }}" alt="{{ section.settings.post1_title | escape }}">
          {% else %}
            <div class="journal-img-placeholder"></div>
          {% endif %}
        </div>
        <div class="journal-body">
          <h3>{{ section.settings.post1_title | default: 'Our Story' }}</h3>
          <p>{{ section.settings.post1_excerpt | default: 'Founded on a reverence for Chinese craft and the sacred meaning of cinnabar, CHENSHA brings two millennia of tradition into the modern world. Discover the story behind every piece.' }}</p>
          <span class="journal-more">{{ section.settings.post1_link_text | default: 'Read More' }} →</span>
        </div>
      </a>

      <a href="{{ section.settings.post2_link | default: '/blogs/journal' }}" class="journal-card">
        <div class="journal-img">
          {% if section.settings.post2_image != blank %}
            <img src="{{ section.settings.post2_image | image_url: width: 600 }}" alt="{{ section.settings.post2_title | escape }}">
          {% else %}
            <div class="journal-img-placeholder"></div>
          {% endif %}
        </div>
        <div class="journal-body">
          <h3>{{ section.settings.post2_title }}</h3>
          <p>{{ section.settings.post2_excerpt }}</p>
          <span class="journal-more">{{ section.settings.post2_link_text | default: 'Read More' }} →</span>
        </div>
      </a>

      <a href="{{ section.settings.post3_link | default: '/blogs/journal' }}" class="journal-card">
        <div class="journal-img">
          {% if section.settings.post3_image != blank %}
            <img src="{{ section.settings.post3_image | image_url: width: 600 }}" alt="{{ section.settings.post3_title | escape }}">
          {% else %}
            <div class="journal-img-placeholder"></div>
          {% endif %}
        </div>
        <div class="journal-body">
          <h3>{{ section.settings.post3_title }}</h3>
          <p>{{ section.settings.post3_excerpt }}</p>
          <span class="journal-more">{{ section.settings.post3_link_text | default: 'Read More' }} →</span>
        </div>
      </a>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "CHENSHA Journal" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Stories of craft, meaning and the art of wearing cinnabar." },

    { "type": "header", "content": "Post 1" },
    { "type": "image_picker", "id": "post1_image", "label": "Image" },
    { "type": "text", "id": "post1_title", "label": "Title", "default": "Our Story" },
    { "type": "textarea", "id": "post1_excerpt", "label": "Excerpt", "default": "Founded on a reverence for Chinese craft and the sacred meaning of cinnabar, CHENSHA brings two millennia of tradition into the modern world. Discover the story behind every piece." },
    { "type": "url", "id": "post1_link", "label": "Link" },
    { "type": "text", "id": "post1_link_text", "label": "Link Text", "default": "Read More" },

    { "type": "header", "content": "Post 2" },
    { "type": "image_picker", "id": "post2_image", "label": "Image" },
    { "type": "text", "id": "post2_title", "label": "Title", "default": "How to Care for Your Piece" },
    { "type": "textarea", "id": "post2_excerpt", "label": "Excerpt", "default": "Simple rituals to keep your cinnabar bracelet vibrant and beautiful for years to come." },
    { "type": "url", "id": "post2_link", "label": "Link" },
    { "type": "text", "id": "post2_link_text", "label": "Link Text", "default": "Read More" },

    { "type": "header", "content": "Post 3" },
    { "type": "image_picker", "id": "post3_image", "label": "Image" },
    { "type": "text", "id": "post3_title", "label": "Title", "default": "Choosing Your Intention" },
    { "type": "textarea", "id": "post3_excerpt", "label": "Excerpt", "default": "Pixiu, Hulu gourd, peace knot — every charm carries a different meaning. Find the one that speaks to you." },
    { "type": "url", "id": "post3_link", "label": "Link" },
    { "type": "text", "id": "post3_link_text", "label": "Link Text", "default": "Read More" }
  ],
  "presets": [
    { "name": "Journal" }
  ]
}
{% endschema %}
