  font-weight: 400;
  color: #FAF6F0;
  margin-bottom: 25px;
}

.finale-desc {
  font-size: 18px;
  color: #E0C88A;
  margin-bottom: 40px;
}

.finale-btn {
  display: inline-block;
  padding: 18px 60px;
  background: #C9A24B;
  color: #2A1F1A;
  text-decoration: none;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-size: 14px;
  transition: all 0.3s ease;
}

.finale-btn:hover {
