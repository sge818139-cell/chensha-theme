<section class="wild-journey">
  <!-- 3D 场景容器 -->
  <div class="journey-scene-3d">

    <!-- 地面小路 -->
    <div class="journey-ground"></div>

    <!-- 远景层 -->
    <div class="layer layer-far">
      <div class="mountain mountain-1"></div>
      <div class="mountain mountain-2"></div>
      <div class="cloud cloud-1"></div>
      <div class="cloud cloud-2"></div>
    </div>

    <!-- 中景层 - 两侧植物 -->
    <div class="layer layer-mid">
      <div class="plant plant-left-1"></div>
      <div class="plant plant-left-2"></div>
      <div class="plant plant-right-1"></div>
      <div class="plant plant-right-2"></div>
    </div>

    <!-- 主角 - 朱砂原石 -->
    <div class="journey-hero">
      <div class="hero-shadow"></div>
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | image_url: width: 600 }}" alt="Cinnabar Hero" class="hero-img">
      {% else %}
        <img src="{{ 'mine-crystal.jpg' | asset_url }}" alt="Cinnabar Hero" class="hero-img">
      {% endif %}
    </div>

    <!-- 场景元素 - 从两侧浮现 -->
    <div class="scene-card scene-left scene-1">
      <div class="card-inner">
        {% if section.settings.scene_1_image != blank %}
          <img src="{{ section.settings.scene_1_image | image_url: width: 500 }}" alt="">
        {% else %}
          <img src="{{ 'mine-map.jpg' | asset_url }}" alt="">
        {% endif %}
      </div>
    </div>
    <div class="scene-text scene-text-1">
      <div class="scene-eyebrow">01 · ORIGIN</div>
      <h3>{{ section.settings.scene_1_title }}</h3>
      <p>{{ section.settings.scene_1_desc }}</p>
    </div>

    <div class="scene-card scene-right scene-2">
      <div class="card-inner">
        {% if section.settings.scene_2_image != blank %}
          <img src="{{ section.settings.scene_2_image | image_url: width: 500 }}" alt="">
        {% else %}
          <img src="{{ 'p01.jpg' | asset_url }}" alt="">
        {% endif %}
      </div>
    </div>
    <div class="scene-text scene-text-2">
      <div class="scene-eyebrow">02 · CRAFT</div>
      <h3>{{ section.settings.scene_2_title }}</h3>
      <p>{{ section.settings.scene_2_desc }}</p>
    </div>

    <div class="scene-card scene-left scene-3">
      <div class="card-inner">
        {% if section.settings.scene_3_image != blank %}
          <img src="{{ section.settings.scene_3_image | image_url: width: 500 }}" alt="">
        {% else %}
          <img src="{{ 'p04.jpg' | asset_url }}" alt="">
        {% endif %}
      </div>
    </div>
    <div class="scene-text scene-text-3">
      <div class="scene-eyebrow">03 · QUALITY</div>
      <h3>{{ section.settings.scene_3_title }}</h3>
      <p>{{ section.settings.scene_3_desc }}</p>
    </div>

    <div class="scene-card scene-right scene-4">
      <div class="card-inner product-duo">
        {% if section.settings.scene_4_image_1 != blank %}
          <img src="{{ section.settings.scene_4_image_1 | image_url: width: 300 }}" alt="">
        {% else %}
          <img src="{{ 'p02.jpg' | asset_url }}" alt="">
        {% endif %}
        {% if section.settings.scene_4_image_2 != blank %}
          <img src="{{ section.settings.scene_4_image_2 | image_url: width: 300 }}" alt="">
        {% else %}
          <img src="{{ 'p05.jpg' | asset_url }}" alt="">
        {% endif %}
      </div>
    </div>
    <div class="scene-text scene-text-4">
      <div class="scene-eyebrow">04 · COLLECTION</div>
      <h3>{{ section.settings.scene_4_title }}</h3>
      <p>{{ section.settings.scene_4_desc }}</p>
    </div>

    <!-- 结尾 -->
    <div class="finale">
      <h2>{{ section.settings.finale_title }}</h2>
      <p>{{ section.settings.finale_desc }}</p>
      <a href="{{ section.settings.cta_link }}" class="cta-btn">{{ section.settings.cta_button }}</a>
    </div>

  </div>

  <!-- 滚动进度条 -->
  <div class="scroll-progress">
    <div class="progress-bar"></div>
  </div>
</section>

<style>
.wild-journey {
  position: relative;
  width: 100%;
  height: 500vh;
  background: linear-gradient(180deg, #FAF6F0 0%, #F4EDE2 50%, #EDE3D3 100%);
  overflow: hidden;
}

.journey-scene-3d {
  position: sticky;
  top: 0;
  width: 100%;
  height: 100vh;
  perspective: 1000px;
  overflow: hidden;
}

/* 地面小路 */
.journey-ground {
  position: absolute;
  bottom: -10%;
  left: 50%;
  transform: translateX(-50%) rotateX(60deg);
  width: 200%;
  height: 150%;
  background: 
    radial-gradient(ellipse at center, rgba(158,43,37,0.1) 0%, transparent 70%),
    linear-gradient(180deg, #E8DCC8 0%, #D4C4A8 100%);
  transform-origin: center bottom;
}

/* 远景层 */
.layer {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.layer-far {
  opacity: 0.4;
}
.mountain {
  position: absolute;
  bottom: 30%;
  width: 400px;
  height: 300px;
  background: linear-gradient(180deg, #C9B896 0%, transparent 100%);
  clip-path: polygon(0 100%, 20% 40%, 40% 60%, 60% 20%, 80% 50%, 100% 100%);
}
.mountain-1 { left: 5%; }
.mountain-2 { right: 5%; transform: scale(1.2); }
.cloud {
  position: absolute;
  width: 200px;
  height: 80px;
  background: white;
  border-radius: 50%;
  opacity: 0.6;
}
.cloud-1 { top: 15%; left: 20%; }
.cloud-2 { top: 25%; right: 15%; }

/* 中景植物 */
.layer-mid {
  opacity: 0.5;
}
.plant {
  position: absolute;
  width: 150px;
  height: 250px;
  background: linear-gradient(180deg, #D4C4A8 0%, #B8A888 100%);
  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
}
.plant-left-1 { left: 5%; bottom: 20%; }
.plant-left-2 { left: 15%; bottom: 10%; transform: scale(1.3); }
.plant-right-1 { right: 5%; bottom: 20%; transform: scaleX(-1); }
.plant-right-2 { right: 15%; bottom: 10%; transform: scaleX(-1) scale(1.3); }

/* 主角 */
.journey-hero {
  position: absolute;
  bottom: 15%;
  left: 50%;
  transform: translateX(-50%);
  width: 200px;
  height: 200px;
  z-index: 10;
}
.hero-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  animation: heroWalk 2s ease-in-out infinite;
}
.hero-shadow {
  position: absolute;
  bottom: -20px;
  left: 50%;
  transform: translateX(-50%);
  width: 120px;
  height: 20px;
  background: radial-gradient(ellipse, rgba(0,0,0,0.2) 0%, transparent 70%);
  border-radius: 50%;
}
@keyframes heroWalk {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* 场景卡片 */
.scene-card {
  position: absolute;
  width: 350px;
  z-index: 5;
  opacity: 0;
  transform: translateY(50px) scale(0.8);
  transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
}
.scene-card.visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}
.scene-left { left: 8%; }
.scene-right { right: 8%; }
.card-inner {
  background: white;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(158,43,37,0.15);
}
.card-inner img {
  width: 100%;
  height: auto;
  display: block;
}
.product-duo {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
}
.product-duo img {
  width: 100%;
}

/* 场景文字 */
.scene-text {
  position: absolute;
  width: 300px;
  z-index: 6;
  opacity: 0;
  transform: translateY(30px);
  transition: all 1s ease 0.3s;
}
.scene-text.visible {
  opacity: 1;
  transform: translateY(0);
}
.scene-text-1 { top: 25%; left: 8%; }
.scene-text-2 { top: 25%; right: 8%; text-align: right; }
.scene-text-3 { top: 25%; left: 8%; }
.scene-text-4 { top: 25%; right: 8%; text-align: right; }

.scene-eyebrow {
  font-size: 12px;
  letter-spacing: 3px;
  color: #9E2B25;
  margin-bottom: 10px;
}
.scene-text h3 {
  font-size: 28px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 15px;
  line-height: 1.3;
}
.scene-text p {
  font-size: 15px;
  line-height: 1.7;
  color: #666;
}

/* 结尾 */
.finale {
  position: absolute;
  bottom: 10%;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 10;
  opacity: 0;
  transition: all 1s ease;
}
.finale.visible {
  opacity: 1;
}
.finale h2 {
  font-size: 48px;
  font-weight: 400;
  color: #9E2B25;
  margin-bottom: 20px;
}
.finale p {
  font-size: 18px;
  color: #666;
  margin-bottom: 30px;
}
.cta-btn {
  display: inline-block;
  padding: 16px 50px;
  background: #9E2B25;
  color: white;
  text-decoration: none;
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size: 14px;
  transition: all 0.3s ease;
}
.cta-btn:hover {
  background: #7A1F1A;
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(158,43,37,0.3);
}

/* 滚动进度条 */
.scroll-progress {
  position: fixed;
  top: 50%;
  right: 20px;
  transform: translateY(-50%);
  width: 2px;
  height: 200px;
  background: rgba(158,43,37,0.1);
  z-index: 100;
}
.progress-bar {
  width: 100%;
  height: 0%;
  background: #9E2B25;
  transition: height 0.1s ease;
}

@media (max-width: 768px) {
  .scene-card {
    width: 280px;
  }
  .scene-text {
    width: 250px;
  }
  .finale h2 {
    font-size: 32px;
  }
  .journey-hero {
    width: 150px;
    height: 150px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const journey = document.querySelector('.wild-journey');
  const scenes = document.querySelectorAll('.scene-card, .scene-text, .finale');
  const progressBar = document.querySelector('.progress-bar');
  
  function updateJourney() {
    const scrollTop = window.pageYOffset;
    const journeyTop = journey.offsetTop;
    const journeyHeight = journey.offsetHeight - window.innerHeight;
    const progress = Math.max(0, Math.min(1, (scrollTop - journeyTop) / journeyHeight));
    
    // 进度条
    progressBar.style.height = (progress * 100) + '%';
    
    // 场景出现时机（4个场景 + 结尾）
    const thresholds = [0.15, 0.35, 0.55, 0.75, 0.9];
    
    for (let i = 0; i < scenes.length; i++) {
      const scene = scenes[i];
      const sceneIndex = Math.floor(i / 2); // 每个场景有卡片和文字两个元素
      if (scene.classList.contains('finale')) {
        if (progress > 0.85) scene.classList.add('visible');
      } else {
        if (progress > thresholds[sceneIndex]) {
          scene.classList.add('visible');
        }
      }
    }
    
    // 主角随滚动向前移动（模拟前进）
    const hero = document.querySelector('.journey-hero');
    if (hero) {
      const scale = 1 + progress * 0.5;
      hero.style.transform = `translateX(-50%) scale(${scale})`;
    }
    
    // 背景视差
    const farLayer = document.querySelector('.layer-far');
    const midLayer = document.querySelector('.layer-mid');
    if (farLayer) farLayer.style.transform = `translateY(${progress * 50}px)`;
    if (midLayer) midLayer.style.transform = `translateY(${progress * 100}px)`;
  }
  
  window.addEventListener('scroll', updateJourney);
  updateJourney();
});
</script>

{% schema %}
{
  "name": "Wild Journey",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image (Cinnabar Crystal)" },
    { "type": "text", "id": "scene_1_title", "label": "Scene 1 Title", "default": "Ancient Origins" },
    { "type": "textarea", "id": "scene_1_desc", "label": "Scene 1 Desc", "default": "For over two millennia, Tongren, Guizhou has been the heart of cinnabar mining." },
    { "type": "image_picker", "id": "scene_1_image", "label": "Scene 1 Image" },
    { "type": "text", "id": "scene_2_title", "label": "Scene 2 Title", "default": "Master Craft" },
    { "type": "textarea", "id": "scene_2_desc", "label": "Scene 2 Desc", "default": "Handcrafted by master artisans using centuries-old techniques." },
    { "type": "image_picker", "id": "scene_2_image", "label": "Scene 2 Image" },
    { "type": "text", "id": "scene_3_title", "label": "Scene 3 Title", "default": "Premium Quality" },
    { "type": "textarea", "id": "scene_3_desc", "label": "Scene 3 Desc", "default": "99% pure cinnabar with the deepest, most vibrant crimson color." },
    { "type": "image_picker", "id": "scene_3_image", "label": "Scene 3 Image" },
    { "type": "text", "id": "scene_4_title", "label": "Scene 4 Title", "default": "Our Collection" },
    { "type": "textarea", "id": "scene_4_desc", "label": "Scene 4 Desc", "default": "Discover bracelets that carry thousands of years of Chinese heritage." },
    { "type": "image_picker", "id": "scene_4_image_1", "label": "Scene 4 Product 1" },
    { "type": "image_picker", "id": "scene_4_image_2", "label": "Scene 4 Product 2" },
    { "type": "text", "id": "finale_title", "label": "Finale Title", "default": "Thank You for Choosing CHENSHA" },
    { "type": "textarea", "id": "finale_desc", "label": "Finale Desc", "default": "Carry a piece of Chinese heritage with you every day." },
    { "type": "text", "id": "cta_button", "label": "CTA Button", "default": "EXPLORE MORE" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [
    {
      "name": "Wild Journey",
      "category": "Featured"
    }
  ]
}
{% endschema %}
