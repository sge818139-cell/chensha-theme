  color: #C9A24B;
  border: 1px solid #C9A24B;
}

/* 进度条 */
.progress-bar {
  position: fixed;
  right: 40px;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 200px;
  background: rgba(158, 43, 37, 0.1);
  z-index: 100;
}

.progress-fill {
  width: 100%;
  height: 0%;
  background: #9E2B25;
  transition: height 0.1s linear;
}

@media (max-width: 768px) {
  .intro-title {
    font-size: 36px;
  }
  .scene-block {
    width: 320px;
  }
  .scene-image {
    width: 220px;
    height: 220px;
  }
  .scene-title {
    font-size: 28px;
  }
  .layer-1 .far-mountain {
    width: 600px;
    height: 300px;
  }
  .layer-2 .mountain {
    width: 500px;
    height: 250px;
  }
  .layer-3 .bamboo-left {
    width: 90px;
    height: 180px;
  }
  .layer-3 .pine-right {
    width: 100px;
    height: 200px;
  }
