}

.layer-1 .cloud-1 {
  top: 10%;
  left: 15%;
  width: 100px;
  height: 100px;
  background: url('{{ 'ink-cloud.png' | asset_url }}') center/contain no-repeat;
}

.layer-1 .cloud-2 {
  top: 20%;
  right: 20%;
  width: 80px;
  height: 80px;
  background: url('{{ 'ink-cloud.png' | asset_url }}') center/contain no-repeat;
}

/* 第2层 - 远 */
.layer-2 {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
  opacity: 0.35;
}

.layer-2 .mountain {
  bottom: 40%;
  left: 50%;
  transform: translateX(-50%);
  width: 700px;
  height: 350px;
  background: url('{{ 'ink-mountain.png' | asset_url }}') center/contain no-repeat;
}

.layer-2 .bird {
  top: 15%;
  left: 30%;
  width: 80px;
  height: 60px;
  background: url('{{ 'ink-bird.png' | asset_url }}') center/contain no-repeat;
}

/* 第3层 - 中 */
.layer-3 {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
  opacity: 0.5;
}

.layer-3 .bamboo-left {
  bottom: 25%;
  left: 2%;
  width: 130px;
  height: 260px;
  background: url('{{ 'ink-bamboo.png' | asset_url }}') center/contain no-repeat;
}

.layer-3 .pine-right {
