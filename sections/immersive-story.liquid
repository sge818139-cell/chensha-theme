/* 引导词 - 开始页面 */
.intro-text {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 8;
  transition: all 2s ease;
}

.intro-eyebrow {
  font-size: 12px;
  letter-spacing: 6px;
  color: #9E2B25;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.intro-title {
  font-size: 56px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 25px;
  line-height: 1.1;
}

.intro-desc {
  font-size: 16px;
  color: #8A7A72;
  letter-spacing: 2px;
  margin-bottom: 30px;
}

