<section class="cinematic-story">
  <!-- 中国风背景装饰 -->
  <div class="bg-decor">
    <div class="cloud-pattern cloud-1"></div>
    <div class="cloud-pattern cloud-2"></div>
    <div class="mountain-silhouette"></div>
  </div>

  <!-- 进度指示器 -->
  <div class="progress-dots">
    <div class="dot active" data-scene="0"></div>
    <div class="dot" data-scene="1"></div>
    <div class="dot" data-scene="2"></div>
    <div class="dot" data-scene="3"></div>
    <div class="dot" data-scene="4"></div>
    <div class="dot" data-scene="5"></div>
  </div>

  <!-- 场景容器 -->
  <div class="scenes-container">

    <!-- 场景 0: 起源 - 地图 -->
    <div class="story-scene active" data-scene="0">
      <div class="scene-inner">
        <div class="scene-image-side">
          {% if section.settings.origin_image != blank %}
            <img src="{{ section.settings.origin_image | image_url: width: 1000 }}" alt="Cinnabar Origin" class="float-animation">
          {% else %}
            <img src="{{ 'mine-map.jpg' | asset_url }}" alt="Cinnabar Origin" class="float-animation">
          {% endif %}
        </div>
        <div class="scene-text-side">
          <div class="scene-number">01</div>
          <h2 class="scene-title">{{ section.settings.origin_title }}</h2>
          <div class="scene-divider"></div>
          <p class="scene-text">{{ section.settings.origin_text }}</p>
        </div>
      </div>
    </div>

    <!-- 场景 1: 品质 -->
    <div class="story-scene" data-scene="1">
      <div class="scene-inner">
        <div class="scene-text-side">
          <div class="scene-number">02</div>
          <h2 class="scene-title">{{ section.settings.quality_title }}</h2>
          <div class="scene-divider"></div>
          <p class="scene-text">{{ section.settings.quality_text }}</p>
        </div>
        <div class="scene-image-side">
          {% if section.settings.quality_image != blank %}
            <img src="{{ section.settings.quality_image | image_url: width: 1000 }}" alt="Cinnabar Quality" class="float-animation">
          {% else %}
            <img src="{{ 'mine-crystal.jpg' | asset_url }}" alt="Cinnabar Quality" class="float-animation">
          {% endif %}
        </div>
      </div>
    </div>

    <!-- 场景 2: 工艺 -->
    <div class="story-scene" data-scene="2">
      <div class="scene-inner">
        <div class="scene-image-side">
          {% if section.settings.craft_image != blank %}
            <img src="{{ section.settings.craft_image | image_url: width: 1000 }}" alt="Cinnabar Craft" class="float-animation">
          {% else %}
            <img src="{{ 'p01.jpg' | asset_url }}" alt="Cinnabar Craft" class="float-animation">
          {% endif %}
        </div>
        <div class="scene-text-side">
          <div class="scene-number">03</div>
          <h2 class="scene-title">{{ section.settings.craft_title }}</h2>
          <div class="scene-divider"></div>
          <p class="scene-text">{{ section.settings.craft_text }}</p>
        </div>
      </div>
    </div>

    <!-- 场景 3: 我们的选择 -->
    <div class="story-scene" data-scene="3">
      <div class="scene-inner">
        <div class="scene-text-side">
          <div class="scene-number">04</div>
          <h2 class="scene-title">{{ section.settings.choice_title }}</h2>
          <div class="scene-divider"></div>
          <p class="scene-text">{{ section.settings.choice_text }}</p>
        </div>
        <div class="scene-image-side">
          {% if section.settings.choice_image != blank %}
            <img src="{{ section.settings.choice_image | image_url: width: 1000 }}" alt="Our Choice" class="float-animation">
          {% else %}
            <img src="{{ 'p04.jpg' | asset_url }}" alt="Our Choice" class="float-animation">
          {% endif %}
        </div>
      </div>
    </div>

    <!-- 场景 4: 产品展示 -->
    <div class="story-scene" data-scene="4">
      <div class="scene-inner">
        <div class="scene-product-row">
          <div class="product-card">
            {% if section.settings.product_1_image != blank %}
              <img src="{{ section.settings.product_1_image | image_url: width: 600 }}" alt="">
            {% else %}
              <img src="{{ 'p02.jpg' | asset_url }}" alt="">
            {% endif %}
            <div class="product-name">{{ section.settings.product_1_name }}</div>
          </div>
          <div class="product-card">
            {% if section.settings.product_2_image != blank %}
              <img src="{{ section.settings.product_2_image | image_url: width: 600 }}" alt="">
            {% else %}
              <img src="{{ 'p05.jpg' | asset_url }}" alt="">
            {% endif %}
            <div class="product-name">{{ section.settings.product_2_name }}</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 场景 5: 结尾 CTA -->
    <div class="story-scene" data-scene="5">
      <div class="scene-inner scene-cta">
        <h2 class="scene-title">{{ section.settings.cta_title }}</h2>
        <div class="scene-divider"></div>
        <p class="scene-text">{{ section.settings.cta_text }}</p>
        <a href="{{ section.settings.cta_link }}" class="btn btn-gold">{{ section.settings.cta_button }}</a>
      </div>
    </div>

  </div>

  <!-- 前进按钮 -->
  <div class="nav-arrow next" onclick="nextScene()">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
  <div class="nav-arrow prev" onclick="prevScene()">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M19 12H5M5 12L12 5M5 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</section>

<style>
.cinematic-story {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(135deg, #FAF6F0 0%, #F4EDE2 50%, #E8DCC8 100%);
}

/* 背景装饰 */
.bg-decor {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}
.cloud-pattern {
  position: absolute;
  opacity: 0.15;
}
.cloud-1 {
  top: 10%;
  right: 10%;
  width: 300px;
  height: 200px;
  background: radial-gradient(ellipse, #C9A24B 0%, transparent 70%);
  border-radius: 50%;
}
.cloud-2 {
  bottom: 15%;
  left: 5%;
  width: 400px;
  height: 250px;
  background: radial-gradient(ellipse, #9E2B25 0%, transparent 70%);
  border-radius: 50%;
  opacity: 0.08;
}
.mountain-silhouette {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 200px;
  background: linear-gradient(180deg, transparent 0%, rgba(158,43,37,0.05) 100%);
  clip-path: polygon(0 100%, 15% 60%, 30% 80%, 45% 50%, 60% 70%, 75% 45%, 90% 65%, 100% 100%);
}

/* 进度点 */
.progress-dots {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12px;
  z-index: 10;
}
.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ccc;
  cursor: pointer;
  transition: all 0.3s ease;
}
.dot.active {
  background: #9E2B25;
  width: 24px;
  border-radius: 4px;
}

/* 场景容器 */
.scenes-container {
  position: relative;
  width: 100%;
  height: 100%;
}
.story-scene {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateX(100px);
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
  padding: 80px;
}
.story-scene.active {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}
.story-scene.prev {
  transform: translateX(-100px);
}
.scene-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
  max-width: 1200px;
  width: 100%;
}
.scene-image-side img {
  width: 100%;
  height: auto;
  border-radius: 12px;
  box-shadow: 0 20px 60px rgba(158,43,37,0.2);
}
.float-animation {
  animation: float 4s ease-in-out infinite;
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}
.scene-number {
  font-size: 14px;
  letter-spacing: 4px;
  color: #C9A24B;
  margin-bottom: 15px;
}
.scene-title {
  font-size: 48px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 20px;
  line-height: 1.2;
}
.scene-divider {
  width: 60px;
  height: 2px;
  background: #9E2B25;
  margin-bottom: 30px;
}
.scene-text {
  font-size: 18px;
  line-height: 1.8;
  color: #555;
}

/* 产品展示场景 */
.scene-product-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  width: 100%;
}
.product-card {
  text-align: center;
}
.product-card img {
  width: 100%;
  height: auto;
  border-radius: 12px;
  box-shadow: 0 15px 40px rgba(0,0,0,0.15);
  margin-bottom: 20px;
  transition: transform 0.3s ease;
}
.product-card:hover img {
  transform: translateY(-10px);
}
.product-name {
  font-size: 16px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #2A1F1A;
}

/* CTA 场景 */
.scene-cta {
  text-align: center;
  flex-direction: column;
}
.btn-gold {
  display: inline-block;
  padding: 16px 48px;
  background: #9E2B25;
  color: #FAF6F0;
  text-decoration: none;
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size: 14px;
  transition: all 0.3s ease;
  margin-top: 30px;
}
.btn-gold:hover {
  background: #7A1F1A;
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(158,43,37,0.3);
}

/* 导航箭头 */
.nav-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: all 0.3s ease;
  color: #9E2B25;
  box-shadow: 0 5px 20px rgba(0,0,0,0.1);
}
.nav-arrow:hover {
  background: #9E2B25;
  color: #fff;
}
.nav-arrow.prev {
  left: 30px;
}
.nav-arrow.next {
  right: 30px;
}

@media (max-width: 768px) {
  .story-scene {
    padding: 100px 40px;
  }
  .scene-inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .scene-title {
    font-size: 32px;
  }
  .scene-product-row {
    grid-template-columns: 1fr;
  }
  .nav-arrow.prev {
    left: 10px;
  }
  .nav-arrow.next {
    right: 10px;
  }
}
</style>

<script>
let currentScene = 0;
const totalScenes = 6;
let autoPlayTimer;

function goToScene(n) {
  if (n < 0 || n >= totalScenes) return;
  const scenes = document.querySelectorAll('.story-scene');
  scenes[currentScene].classList.remove('active');
  if (n > currentScene) {
    scenes[currentScene].classList.add('prev');
  } else {
    scenes[currentScene].classList.remove('prev');
  }
  setTimeout(() => {
    scenes.forEach(s => s.classList.remove('prev'));
  }, 800);
  scenes[n].classList.add('active');
  currentScene = n;
  
  // 更新进度点
  document.querySelectorAll('.dot').forEach((d, i) => {
    d.classList.toggle('active', i === n);
  });
  
  resetAutoPlay();
}

function nextScene() {
  goToScene((currentScene + 1) % totalScenes);
}

function prevScene() {
  goToScene((currentScene - 1 + totalScenes) % totalScenes);
}

function resetAutoPlay() {
  clearInterval(autoPlayTimer);
  autoPlayTimer = setInterval(() => {
    nextScene();
  }, 8000);
}

// 初始化
document.querySelectorAll('.dot').forEach((dot, i) => {
  dot.addEventListener('click', () => goToScene(i));
});

// 键盘导航
document.addEventListener('keydown', (e) => {
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown') nextScene();
  if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') prevScene();
});

resetAutoPlay();
</script>

{% schema %}
{
  "name": "Cinematic Story",
  "settings": [
    { "type": "text", "id": "origin_title", "label": "Origin Title", "default": "Ancient Origins" },
    { "type": "textarea", "id": "origin_text", "label": "Origin Text", "default": "For over two millennia, the mountains of Tongren, Guizhou have yielded the world's finest cinnabar. This sacred red stone has been treasured by emperors, worn by scholars, and carried as a talisman through every dynasty of Chinese history." },
    { "type": "image_picker", "id": "origin_image", "label": "Origin Image" },
    { "type": "text", "id": "quality_title", "label": "Quality Title", "default": "Premium Quality" },
    { "type": "textarea", "id": "quality_text", "label": "Quality Text", "default": "Our cinnabar boasts 99% purity, with a deep, vibrant crimson that reflects the light with a warm, golden glow. Each piece is carefully selected to ensure the highest quality and most beautiful color." },
    { "type": "image_picker", "id": "quality_image", "label": "Quality Image" },
    { "type": "text", "id": "craft_title", "label": "Craft Title", "default": "Master Craftsmanship" },
    { "type": "textarea", "id": "craft_text", "label": "Craft Text", "default": "Every CHENSHA bracelet is handcrafted by master artisans with decades of experience. From stringing the beads to finishing the knots, each step is done with meticulous care and respect for traditional techniques." },
    { "type": "image_picker", "id": "craft_image", "label": "Craft Image" },
    { "type": "text", "id": "choice_title", "label": "Choice Title", "default": "Our Choice" },
    { "type": "textarea", "id": "choice_text", "label": "Choice Text", "default": "We believe that jewelry should tell a story. That's why we choose materials with meaning and create pieces that connect you to thousands of years of Chinese culture. Every CHENSHA piece is a testament to tradition, quality, and timeless beauty." },
    { "type": "image_picker", "id": "choice_image", "label": "Choice Image" },
    { "type": "text", "id": "product_1_name", "label": "Product 1 Name", "default": "Cinnabar Bracelets" },
    { "type": "image_picker", "id": "product_1_image", "label": "Product 1 Image" },
    { "type": "text", "id": "product_2_name", "label": "Product 2 Name", "default": "Gold & Cinnabar" },
    { "type": "image_picker", "id": "product_2_image", "label": "Product 2 Image" },
    { "type": "text", "id": "cta_title", "label": "CTA Title", "default": "Thank You for Choosing CHENSHA" },
    { "type": "textarea", "id": "cta_text", "label": "CTA Text", "default": "Discover our collection and carry a piece of Chinese heritage with you." },
    { "type": "text", "id": "cta_button", "label": "CTA Button", "default": "EXPLORE MORE" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [
    {
      "name": "Cinematic Story",
      "category": "Featured"
    }
  ]
}
{% endschema %}
