<section class="cinnabar-journey">

  <div class="journey-container">

    <!-- 场景 1: 起源 -->
    <div class="j-scene">
      <div class="j-grid">
        <div class="j-left">
          <div class="j-eyebrow">01 · ORIGIN</div>
          <h2 class="j-title">{{ section.settings.scene_1_title }}</h2>
          <div class="j-divider"></div>
          <p class="j-desc">{{ section.settings.scene_1_desc }}</p>
        </div>
        <div class="j-right">
          <div class="j-gem gem-red"></div>
        </div>
      </div>
    </div>

    <!-- 场景 2: 品质 -->
    <div class="j-scene">
      <div class="j-grid j-grid-reverse">
        <div class="j-left">
          <div class="j-gem gem-gold"></div>
        </div>
        <div class="j-right">
          <div class="j-eyebrow">02 · QUALITY</div>
          <h2 class="j-title">{{ section.settings.scene_2_title }}</h2>
          <div class="j-divider"></div>
          <p class="j-desc">{{ section.settings.scene_2_desc }}</p>
        </div>
      </div>
    </div>

    <!-- 场景 3: 工艺 -->
    <div class="j-scene">
      <div class="j-grid">
        <div class="j-left">
          <div class="j-eyebrow">03 · CRAFT</div>
          <h2 class="j-title">{{ section.settings.scene_3_title }}</h2>
          <div class="j-divider"></div>
          <p class="j-desc">{{ section.settings.scene_3_desc }}</p>
        </div>
        <div class="j-right">
          <div class="j-gem gem-dark"></div>
        </div>
      </div>
    </div>

    <!-- 场景 4: 产品 -->
    <div class="j-scene j-scene-center">
      <div class="j-eyebrow">04 · COLLECTION</div>
      <h2 class="j-title">{{ section.settings.scene_4_title }}</h2>
      <div class="j-divider j-divider-center"></div>
      <p class="j-desc j-desc-center">{{ section.settings.scene_4_desc }}</p>
      <div class="j-products">
        <div class="j-product"></div>
        <div class="j-product"></div>
      </div>
    </div>

    <!-- 结尾 -->
    <div class="j-scene j-scene-finale">
      <div class="j-eyebrow j-eyebrow-light">CHENSHA</div>
      <h2 class="j-title j-title-light">{{ section.settings.finale_title }}</h2>
      <p class="j-desc j-desc-light">{{ section.settings.finale_desc }}</p>
      <a href="{{ section.settings.cta_link }}" class="j-btn">{{ section.settings.cta_button }}</a>
    </div>

  </div>

</section>

<style>
.cinnabar-journey {
  width: 100%;
  background: #FAF6F0;
}

.journey-container {
  width: 100%;
}

.j-scene {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80px 40px;
  background: #FAF6F0;
}

.j-scene:nth-child(even) {
  background: #F4EDE2;
}

.j-scene-finale {
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
}

.j-grid {
  max-width: 1200px;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

.j-grid-reverse {
  direction: rtl;
}
.j-grid-reverse > * {
  direction: ltr;
}

.j-eyebrow {
  font-size: 13px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: #9E2B25;
  margin-bottom: 15px;
}
.j-eyebrow-light {
  color: #E0C88A;
}

.j-title {
  font-size: 48px;
  font-weight: 400;
  line-height: 1.2;
  color: #2A1F1A;
  margin-bottom: 20px;
}
.j-title-light {
  color: #FAF6F0;
}

.j-divider {
  width: 60px;
  height: 2px;
  background: #9E2B25;
  margin-bottom: 25px;
}
.j-divider-center {
  margin-left: auto;
  margin-right: auto;
}

.j-desc {
  font-size: 17px;
  line-height: 1.8;
  color: #555;
}
.j-desc-center {
  text-align: center;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}
.j-desc-light {
  color: #E0C88A;
  text-align: center;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.j-gem {
  width: 250px;
  height: 250px;
  border-radius: 50%;
  margin: 0 auto;
  animation: gemFloat 4s ease-in-out infinite;
}

.gem-red {
  background: radial-gradient(circle at 30% 30%, #C94B44 0%, #9E2B25 50%, #7A1F1A 100%);
  box-shadow: 0 0 80px rgba(158,43,37,0.4);
}

.gem-gold {
  background: radial-gradient(circle at 30% 30%, #E0C88A 0%, #C9A24B 50%, #9E7B2F 100%);
  box-shadow: 0 0 80px rgba(201,162,75,0.4);
}

.gem-dark {
  background: radial-gradient(circle at 30% 30%, #B83830 0%, #9E2B25 50%, #5A1510 100%);
  box-shadow: 0 0 80px rgba(158,43,37,0.5);
}

@keyframes gemFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20px) scale(1.05); }
}

.j-scene-center {
  flex-direction: column;
  text-align: center;
}

.j-products {
  display: flex;
  gap: 40px;
  margin-top: 50px;
  justify-content: center;
}

.j-product {
  width: 220px;
  height: 280px;
  border-radius: 16px;
  box-shadow: 0 15px 40px rgba(0,0,0,0.15);
}

.j-product:nth-child(1) {
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
}

.j-product:nth-child(2) {
  background: linear-gradient(135deg, #C9A24B 0%, #9E2B25 100%);
}

.j-btn {
  display: inline-block;
  margin-top: 30px;
  padding: 16px 50px;
  background: #C9A24B;
  color: #2A1F1A;
  text-decoration: none;
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size: 14px;
  transition: all 0.3s ease;
}

.j-btn:hover {
  background: transparent;
  color: #C9A24B;
  border: 1px solid #C9A24B;
}

@media (max-width: 768px) {
  .j-scene {
    padding: 60px 20px;
  }
  .j-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .j-title {
    font-size: 32px;
  }
  .j-gem {
    width: 180px;
    height: 180px;
  }
  .j-products {
    flex-direction: column;
    align-items: center;
  }
}
</style>

{% schema %}
{
  "name": "Cinnabar Journey",
  "settings": [
    { "type": "text", "id": "scene_1_title", "label": "Scene 1 Title", "default": "Ancient Origins" },
    { "type": "textarea", "id": "scene_1_desc", "label": "Scene 1 Desc", "default": "For over two millennia, the mountains of Tongren, Guizhou have yielded the world's finest cinnabar. This sacred red stone has been treasured by emperors and scholars through every dynasty." },
    { "type": "text", "id": "scene_2_title", "label": "Scene 2 Title", "default": "Premium Quality" },
    { "type": "textarea", "id": "scene_2_desc", "label": "Scene 2 Desc", "default": "Our cinnabar boasts 99% purity, with a deep, vibrant crimson that reflects the light with a warm, golden glow. Each piece is carefully selected for the highest quality." },
    { "type": "text", "id": "scene_3_title", "label": "Scene 3 Title", "default": "Master Craftsmanship" },
    { "type": "textarea", "id": "scene_3_desc", "label": "Scene 3 Desc", "default": "Every CHENSHA bracelet is handcrafted by master artisans with decades of experience. From stringing to finishing, each step is done with meticulous care." },
    { "type": "text", "id": "scene_4_title", "label": "Scene 4 Title", "default": "Our Collection" },
    { "type": "textarea", "id": "scene_4_desc", "label": "Scene 4 Desc", "default": "Discover bracelets that carry thousands of years of Chinese heritage, crafted to be worn and treasured every day." },
    { "type": "text", "id": "finale_title", "label": "Finale Title", "default": "Thank You for Choosing CHENSHA" },
    { "type": "textarea", "id": "finale_desc", "label": "Finale Desc", "default": "Carry a piece of Chinese heritage with you." },
    { "type": "text", "id": "cta_button", "label": "CTA Button", "default": "EXPLORE MORE" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [
    {
      "name": "Cinnabar Journey",
      "category": "Featured"
    }
  ]
}
{% endschema %}
