<section class="cinematic-journey">
  <!-- 第 1 幕: 入口 - 起源地图 -->
  <div class="journey-scene" data-depth="0.2">
    <div class="scene-layer bg-layer">
      <div class="bg-mist bg-mist-1"></div>
      <div class="bg-mist bg-mist-2"></div>
    </div>
    <div class="scene-layer content-layer">
      <div class="journey-container">
        <div class="journey-text">
          <div class="journey-eyebrow">01 · ORIGIN</div>
          <h2 class="journey-title">{{ section.settings.origin_title }}</h2>
          <div class="journey-line"></div>
          <p class="journey-desc">{{ section.settings.origin_text }}</p>
        </div>
        <div class="journey-visual">
          {% if section.settings.origin_image != blank %}
            <img src="{{ section.settings.origin_image | image_url: width: 1000 }}" alt="" class="parallax-img" data-speed="0.15">
          {% else %}
            <img src="{{ 'mine-map.jpg' | asset_url }}" alt="" class="parallax-img" data-speed="0.15">
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- 第 2 幕: 品质 -->
  <div class="journey-scene" data-depth="0.4">
    <div class="scene-layer bg-layer">
      <div class="bg-mist bg-mist-3"></div>
    </div>
    <div class="scene-layer content-layer">
      <div class="journey-container reverse">
        <div class="journey-visual">
          {% if section.settings.quality_image != blank %}
            <img src="{{ section.settings.quality_image | image_url: width: 1000 }}" alt="" class="parallax-img" data-speed="0.2">
          {% else %}
            <img src="{{ 'mine-crystal.jpg' | asset_url }}" alt="" class="parallax-img" data-speed="0.2">
          {% endif %}
        </div>
        <div class="journey-text">
          <div class="journey-eyebrow">02 · QUALITY</div>
          <h2 class="journey-title">{{ section.settings.quality_title }}</h2>
          <div class="journey-line"></div>
          <p class="journey-desc">{{ section.settings.quality_text }}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 第 3 幕: 工艺 -->
  <div class="journey-scene" data-depth="0.6">
    <div class="scene-layer bg-layer">
      <div class="bg-mist bg-mist-4"></div>
    </div>
    <div class="scene-layer content-layer">
      <div class="journey-container">
        <div class="journey-text">
          <div class="journey-eyebrow">03 · CRAFT</div>
          <h2 class="journey-title">{{ section.settings.craft_title }}</h2>
          <div class="journey-line"></div>
          <p class="journey-desc">{{ section.settings.craft_text }}</p>
        </div>
        <div class="journey-visual">
          {% if section.settings.craft_image != blank %}
            <img src="{{ section.settings.craft_image | image_url: width: 1000 }}" alt="" class="parallax-img" data-speed="0.25">
          {% else %}
            <img src="{{ 'p01.jpg' | asset_url }}" alt="" class="parallax-img" data-speed="0.25">
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- 第 4 幕: 我们的选择 -->
  <div class="journey-scene" data-depth="0.8">
    <div class="scene-layer bg-layer"></div>
    <div class="scene-layer content-layer">
      <div class="journey-container reverse">
        <div class="journey-visual">
          {% if section.settings.choice_image != blank %}
            <img src="{{ section.settings.choice_image | image_url: width: 1000 }}" alt="" class="parallax-img" data-speed="0.18">
          {% else %}
            <img src="{{ 'p04.jpg' | asset_url }}" alt="" class="parallax-img" data-speed="0.18">
          {% endif %}
        </div>
        <div class="journey-text">
          <div class="journey-eyebrow">04 · OUR CHOICE</div>
          <h2 class="journey-title">{{ section.settings.choice_title }}</h2>
          <div class="journey-line"></div>
          <p class="journey-desc">{{ section.settings.choice_text }}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 第 5 幕: 产品展示 -->
  <div class="journey-scene product-scene" data-depth="1.0">
    <div class="scene-layer bg-layer"></div>
    <div class="scene-layer content-layer">
      <div class="journey-container center">
        <div class="journey-text center-text">
          <div class="journey-eyebrow">05 · COLLECTION</div>
          <h2 class="journey-title">Our Treasures</h2>
        </div>
        <div class="product-duo">
          <div class="product-item">
            {% if section.settings.product_1_image != blank %}
              <img src="{{ section.settings.product_1_image | image_url: width: 600 }}" alt="" class="parallax-img" data-speed="0.12">
            {% else %}
              <img src="{{ 'p02.jpg' | asset_url }}" alt="" class="parallax-img" data-speed="0.12">
            {% endif %}
            <div class="product-label">{{ section.settings.product_1_name }}</div>
          </div>
          <div class="product-item">
            {% if section.settings.product_2_image != blank %}
              <img src="{{ section.settings.product_2_image | image_url: width: 600 }}" alt="" class="parallax-img" data-speed="0.12">
            {% else %}
              <img src="{{ 'p05.jpg' | asset_url }}" alt="" class="parallax-img" data-speed="0.12">
            {% endif %}
            <div class="product-label">{{ section.settings.product_2_name }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 第 6 幕: 结尾 -->
  <div class="journey-scene finale-scene" data-depth="1.2">
    <div class="scene-layer bg-layer"></div>
    <div class="scene-layer content-layer">
      <div class="finale-content">
        <div class="journey-eyebrow">CHENSHA</div>
        <h2 class="journey-title finale-title">{{ section.settings.cta_title }}</h2>
        <div class="journey-line center-line"></div>
        <p class="journey-desc center-text">{{ section.settings.cta_text }}</p>
        <a href="{{ section.settings.cta_link }}" class="btn-cinematic">{{ section.settings.cta_button }}</a>
      </div>
    </div>
  </div>
</section>

<style>
.cinematic-journey {
  position: relative;
  width: 100%;
  background: linear-gradient(180deg, #FAF6F0 0%, #F4EDE2 25%, #EDE3D3 50%, #F4EDE2 75%, #FAF6F0 100%);
}

.journey-scene {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.scene-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.bg-layer {
  z-index: 0;
}

.content-layer {
  z-index: 2;
}

/* 雾气背景 */
.bg-mist {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.5;
}
.bg-mist-1 {
  top: 10%;
  left: 10%;
  width: 400px;
  height: 400px;
  background: #C9A24B;
}
.bg-mist-2 {
  bottom: 20%;
  right: 15%;
  width: 500px;
  height: 500px;
  background: #9E2B25;
  opacity: 0.2;
}
.bg-mist-3 {
  top: 30%;
  right: 10%;
  width: 600px;
  height: 600px;
  background: #E0C88A;
}
.bg-mist-4 {
  bottom: 10%;
  left: 20%;
  width: 500px;
  height: 500px;
  background: #7A1F1A;
  opacity: 0.15;
}

/* 内容容器 */
.journey-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
  max-width: 1200px;
  width: 100%;
  padding: 0 60px;
}
.journey-container.reverse {
  direction: rtl;
}
.journey-container.reverse > * {
  direction: ltr;
}
.journey-container.center {
  display: flex;
  flex-direction: column;
  text-align: center;
}

.journey-text {
  opacity: 0;
  transform: translateY(60px);
  transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
}
.journey-scene.in-view .journey-text {
  opacity: 1;
  transform: translateY(0);
}
.center-text {
  text-align: center;
}
.journey-eyebrow {
  font-size: 13px;
  letter-spacing: 6px;
  text-transform: uppercase;
  color: #9E2B25;
  margin-bottom: 20px;
}
.journey-title {
  font-size: 56px;
  font-weight: 400;
  line-height: 1.2;
  color: #2A1F1A;
  margin-bottom: 25px;
}
.finale-title {
  font-size: 64px;
  color: #9E2B25;
}
.journey-line {
  width: 80px;
  height: 2px;
  background: #9E2B25;
  margin-bottom: 30px;
}
.center-line {
  margin: 0 auto 30px;
}
.journey-desc {
  font-size: 18px;
  line-height: 1.9;
  color: #555;
}

.journey-visual img {
  width: 100%;
  height: auto;
  border-radius: 16px;
  box-shadow: 0 30px 80px rgba(158,43,37,0.2);
  opacity: 0;
  transform: scale(0.9);
  transition: all 1.2s cubic-bezier(0.4, 0, 0.2, 1);
}
.journey-scene.in-view .journey-visual img {
  opacity: 1;
  transform: scale(1);
}

/* 产品双列 */
.product-duo {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  margin-top: 50px;
}
.product-item img {
  width: 100%;
  height: auto;
  border-radius: 16px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.15);
  transition: transform 0.5s ease;
}
.product-item:hover img {
  transform: translateY(-15px);
}
.product-label {
  margin-top: 20px;
  font-size: 14px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #2A1F1A;
}

/* 结尾 */
.finale-content {
  text-align: center;
  max-width: 800px;
  padding: 0 40px;
}
.btn-cinematic {
  display: inline-block;
  margin-top: 40px;
  padding: 18px 60px;
  background: #9E2B25;
  color: #FAF6F0;
  text-decoration: none;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-size: 14px;
  transition: all 0.4s ease;
  border: 1px solid #9E2B25;
}
.btn-cinematic:hover {
  background: transparent;
  color: #9E2B25;
  transform: translateY(-3px);
  box-shadow: 0 15px 40px rgba(158,43,37,0.2);
}

@media (max-width: 768px) {
  .journey-container {
    grid-template-columns: 1fr;
    gap: 40px;
    padding: 0 30px;
  }
  .journey-title {
    font-size: 36px;
  }
  .finale-title {
    font-size: 42px;
  }
  .product-duo {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // 滚动触发动画
  const scenes = document.querySelectorAll('.journey-scene');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
      }
    });
  }, {
    threshold: 0.2
  });
  scenes.forEach(scene => observer.observe(scene));

  // 视差滚动
  window.addEventListener('scroll', () => {
    const scrollY = window.pageYOffset;
    document.querySelectorAll('.parallax-img').forEach(img => {
      const speed = parseFloat(img.dataset.speed) || 0.15;
      const rect = img.getBoundingClientRect();
      const offset = (rect.top - window.innerHeight / 2) * speed;
      img.style.transform = `translateY(${offset}px)`;
    });
  });
});
</script>

{% schema %}
{
  "name": "Cinematic Journey",
  "settings": [
    { "type": "text", "id": "origin_title", "label": "Origin Title", "default": "Ancient Origins" },
    { "type": "textarea", "id": "origin_text", "label": "Origin Text", "default": "For over two millennia, the mountains of Tongren, Guizhou have yielded the world's finest cinnabar. This sacred red stone has been treasured by emperors, worn by scholars, and carried as a talisman through every dynasty of Chinese history." },
    { "type": "image_picker", "id": "origin_image", "label": "Origin Image" },
    { "type": "text", "id": "quality_title", "label": "Quality Title", "default": "Premium Quality" },
    { "type": "textarea", "id": "quality_text", "label": "Quality Text", "default": "Our cinnabar boasts 99% purity, with a deep, vibrant crimson that reflects the light with a warm, golden glow. Each piece is carefully selected to ensure the highest quality and most beautiful color." },
    { "type": "image_picker", "id": "quality_image", "label": "Quality Image" },
    { "type": "text", "id": "craft_title", "label": "Craft Title", "default": "Master Craftsmanship" },
    { "type": "textarea", "id": "craft_text", "label": "Craft Text", "default": "Every CHENSHA bracelet is handcrafted by master artisans with decades of experience. From stringing the beads to finishing the knots, each step is done with meticulous care and respect for traditional techniques." },
    { "type": "image_picker", "id": "craft_image", "label": "Craft Image" },
    { "type": "text", "id": "choice_title", "label": "Choice Title", "default": "Our Choice" },
    { "type": "textarea", "id": "choice_text", "label": "Choice Text", "default": "We believe that jewelry should tell a story. That's why we choose materials with meaning and create pieces that connect you to thousands of years of Chinese culture. Every CHENSHA piece is a testament to tradition, quality, and timeless beauty." },
    { "type": "image_picker", "id": "choice_image", "label": "Choice Image" },
    { "type": "text", "id": "product_1_name", "label": "Product 1 Name", "default": "Cinnabar Bracelets" },
    { "type": "image_picker", "id": "product_1_image", "label": "Product 1 Image" },
    { "type": "text", "id": "product_2_name", "label": "Product 2 Name", "default": "Gold & Cinnabar" },
    { "type": "image_picker", "id": "product_2_image", "label": "Product 2 Image" },
    { "type": "text", "id": "cta_title", "label": "CTA Title", "default": "Thank You for Choosing CHENSHA" },
    { "type": "textarea", "id": "cta_text", "label": "CTA Text", "default": "Discover our collection and carry a piece of Chinese heritage with you." },
    { "type": "text", "id": "cta_button", "label": "CTA Button", "default": "EXPLORE MORE" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [
    {
      "name": "Cinematic Journey",
      "category": "Featured"
    }
  ]
}
{% endschema %}
