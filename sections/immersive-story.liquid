}

.scene-block.visible {
  opacity: 1;
  transform: translate(-50%, -50%);
}

.scene-image {
  width: 320px;
  height: 320px;
  margin: 0 auto 20px;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  animation: floatImage 6s ease-in-out infinite;
  mix-blend-mode: multiply;
}

@keyframes floatImage {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.scene-eyebrow {
  font-size: 11px;
  letter-spacing: 4px;
  color: #9E2B25;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.scene-title {
  font-size: 36px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 12px;
  line-height: 1.2;
}

.scene-location {
  font-size: 14px;
  color: #9E2B25;
  letter-spacing: 2px;
  margin-bottom: 18px;
}

.scene-desc {
  font-size: 16px;
  line-height: 1.7;
  color: #5A4A42;
  max-width: 320px;
  margin: 0 auto;
}

/* 结尾 */
.finale {
