/* 居中场景 - 图片在上，文字在下 */
.scene-block {
  width: 400px;
  z-index: 6;
  opacity: 0;
  transition: all 1.2s ease;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -40%);
