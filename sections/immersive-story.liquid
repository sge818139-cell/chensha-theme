<section class="cinnabar-journey">

  <div class="journey-track">

    <!-- 场景 1: 起源 -->
    <div class="j-scene">
      <div class="j-bg j-bg-1"></div>
      <div class="j-content">
        <div class="j-text j-text-left">
          <div class="j-eyebrow">01 · ORIGIN</div>
          <h2 class="j-title">{{ section.settings.scene_1_title }}</h2>
          <div class="j-divider"></div>
          <p class="j-desc">{{ section.settings.scene_1_desc }}</p>
        </div>
        <div class="j-visual j-visual-right">
          <div class="j-img-placeholder j-img-map">
            <div class="map-shape"></div>
            <div class="map-pin"></div>
            <div class="map-label">铜仁<br>Tongren</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 场景 2: 品质 -->
    <div class="j-scene">
      <div class="j-bg j-bg-2"></div>
      <div class="j-content">
        <div class="j-visual j-visual-left">
          <div class="j-img-placeholder j-img-crystal">
            <div class="crystal-shape"></div>
            <div class="crystal-glow"></div>
          </div>
        </div>
        <div class="j-text j-text-right">
          <div class="j-eyebrow">02 · QUALITY</div>
          <h2 class="j-title">{{ section.settings.scene_2_title }}</h2>
          <div class="j-divider"></div>
          <p class="j-desc">{{ section.settings.scene_2_desc }}</p>
        </div>
      </div>
    </div>

    <!-- 场景 3: 工艺 -->
    <div class="j-scene">
      <div class="j-bg j-bg-3"></div>
      <div class="j-content">
        <div class="j-text j-text-left">
          <div class="j-eyebrow">03 · CRAFT</div>
          <h2 class="j-title">{{ section.settings.scene_3_title }}</h2>
          <div class="j-divider"></div>
          <p class="j-desc">{{ section.settings.scene_3_desc }}</p>
        </div>
        <div class="j-visual j-visual-right">
          <div class="j-img-placeholder j-img-craft">
            <div class="bead-row">
              <div class="bead"></div>
              <div class="bead"></div>
              <div class="bead"></div>
              <div class="bead"></div>
              <div class="bead"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 场景 4: 产品 -->
    <div class="j-scene">
      <div class="j-bg j-bg-4"></div>
      <div class="j-content">
        <div class="j-text j-text-center">
          <div class="j-eyebrow">04 · COLLECTION</div>
          <h2 class="j-title">{{ section.settings.scene_4_title }}</h2>
          <div class="j-divider j-divider-center"></div>
          <p class="j-desc">{{ section.settings.scene_4_desc }}</p>
        </div>
        <div class="j-products">
          <div class="j-product">
            <div class="j-product-img j-product-1"></div>
            <div class="j-product-name">Cinnabar Bracelets</div>
          </div>
          <div class="j-product">
            <div class="j-product-img j-product-2"></div>
            <div class="j-product-name">Gold & Cinnabar</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 场景 5: 结尾 -->
    <div class="j-scene j-scene-finale">
      <div class="j-bg j-bg-5"></div>
      <div class="j-content j-content-center">
        <div class="j-eyebrow j-eyebrow-light">CHENSHA</div>
        <h2 class="j-title j-title-light">{{ section.settings.finale_title }}</h2>
        <div class="j-divider j-divider-center"></div>
        <p class="j-desc j-desc-light">{{ section.settings.finale_desc }}</p>
        <a href="{{ section.settings.cta_link }}" class="j-cta-btn">{{ section.settings.cta_button }}</a>
      </div>
    </div>

  </div>

  <!-- 进度指示 -->
  <div class="j-progress">
    <div class="j-progress-dot active"></div>
    <div class="j-progress-dot"></div>
    <div class="j-progress-dot"></div>
    <div class="j-progress-dot"></div>
    <div class="j-progress-dot"></div>
  </div>

</section>

<style>
.cinnabar-journey {
  position: relative;
  width: 100%;
  background: #FAF6F0;
}

.journey-track {
  position: relative;
  width: 100%;
}

.j-scene {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.j-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.j-bg-1 {
  background: 
    radial-gradient(ellipse at 20% 50%, rgba(158,43,37,0.05) 0%, transparent 50%),
    linear-gradient(135deg, #FAF6F0 0%, #F4EDE2 100%);
}
.j-bg-2 {
  background: 
    radial-gradient(ellipse at 80% 50%, rgba(201,162,75,0.08) 0%, transparent 50%),
    linear-gradient(135deg, #F4EDE2 0%, #EDE3D3 100%);
}
.j-bg-3 {
  background: 
    radial-gradient(ellipse at 20% 50%, rgba(158,43,37,0.06) 0%, transparent 50%),
    linear-gradient(135deg, #EDE3D3 0%, #E8DCC8 100%);
}
.j-bg-4 {
  background: linear-gradient(135deg, #E8DCC8 0%, #F4EDE2 100%);
}
.j-bg-5 {
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
}

.j-content {
  position: relative;
  z-index: 2;
  max-width: 1200px;
  width: 100%;
  padding: 0 60px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.j-content-center {
  display: flex;
  flex-direction: column;
  text-align: center;
  align-items: center;
}

.j-text {
  opacity: 0;
  transform: translateY(50px);
  transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
}
.j-scene.in-view .j-text {
  opacity: 1;
  transform: translateY(0);
}

.j-eyebrow {
  font-size: 13px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: #9E2B25;
  margin-bottom: 15px;
}
.j-eyebrow-light {
  color: #E0C88A;
}
.j-title {
  font-size: 52px;
  font-weight: 400;
  line-height: 1.2;
  color: #2A1F1A;
  margin-bottom: 20px;
}
.j-title-light {
  color: #FAF6F0;
}
.j-divider {
  width: 60px;
  height: 2px;
  background: #9E2B25;
  margin-bottom: 25px;
}
.j-divider-center {
  margin-left: auto;
  margin-right: auto;
}
.j-desc {
  font-size: 17px;
  line-height: 1.8;
  color: #555;
}
.j-desc-light {
  color: #E0C88A;
}

.j-visual {
  opacity: 0;
  transform: translateY(50px) scale(0.95);
  transition: all 1.2s cubic-bezier(0.4, 0, 0.2, 1);
}
.j-scene.in-view .j-visual {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.j-img-placeholder {
  width: 100%;
  height: 400px;
  border-radius: 16px;
  box-shadow: 0 20px 60px rgba(158,43,37,0.15);
  position: relative;
  overflow: hidden;
}

/* 地图占位 */
.j-img-map {
  background: linear-gradient(135deg, #FAF6F0 0%, #F4EDE2 100%);
}
.map-shape {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 250px;
  height: 200px;
  background: rgba(158,43,37,0.3);
  clip-path: polygon(30% 10%, 70% 5%, 90% 30%, 85% 70%, 60% 95%, 25% 90%, 10% 60%, 15% 25%);
  border: 2px solid #C9A24B;
}
.map-pin {
  position: absolute;
  top: 45%;
  left: 55%;
  width: 20px;
  height: 20px;
  background: #9E2B25;
  border-radius: 50%;
  border: 3px solid white;
  box-shadow: 0 0 0 4px rgba(158,43,37,0.2);
  animation: pinPulse 2s ease-in-out infinite;
}
@keyframes pinPulse {
  0%, 100% { box-shadow: 0 0 0 4px rgba(158,43,37,0.2); }
  50% { box-shadow: 0 0 0 12px rgba(158,43,37,0.1); }
}
.map-label {
  position: absolute;
  top: 40%;
  left: 60%;
  font-size: 14px;
  color: #9E2B25;
  font-weight: 500;
}

/* 晶体占位 */
.j-img-crystal {
  background: linear-gradient(135deg, #2A1F1A 0%, #3D2A20 100%);
}
.crystal-shape {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120px;
  height: 160px;
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
  clip-path: polygon(50% 0%, 80% 20%, 100% 50%, 80% 80%, 50% 100%, 20% 80%, 0% 50%, 20% 20%);
  box-shadow: 0 0 60px rgba(158,43,37,0.5);
}
.crystal-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(158,43,37,0.3) 0%, transparent 70%);
  border-radius: 50%;
  animation: glowPulse 3s ease-in-out infinite;
}
@keyframes glowPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* 工艺占位 - 手链 */
.j-img-craft {
  background: linear-gradient(135deg, #FAF6F0 0%, #F4EDE2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.bead-row {
  display: flex;
  gap: 15px;
}
.bead {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
  box-shadow: 0 5px 15px rgba(158,43,37,0.3);
  animation: beadFloat 3s ease-in-out infinite;
}
.bead:nth-child(2) { animation-delay: 0.2s; }
.bead:nth-child(3) { animation-delay: 0.4s; }
.bead:nth-child(4) { animation-delay: 0.6s; }
.bead:nth-child(5) { animation-delay: 0.8s; }
@keyframes beadFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* 产品展示 */
.j-products {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  margin-top: 40px;
}
.j-product {
  text-align: center;
  opacity: 0;
  transform: translateY(50px);
  transition: all 1s ease 0.3s;
}
.j-scene.in-view .j-product {
  opacity: 1;
  transform: translateY(0);
}
.j-product-img {
  width: 100%;
  height: 350px;
  border-radius: 16px;
  margin-bottom: 15px;
  box-shadow: 0 15px 40px rgba(0,0,0,0.15);
}
.j-product-1 {
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
}
.j-product-2 {
  background: linear-gradient(135deg, #C9A24B 0%, #9E2B25 100%);
}
.j-product-name {
  font-size: 14px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #2A1F1A;
}

/* CTA 按钮 */
.j-cta-btn {
  display: inline-block;
  margin-top: 30px;
  padding: 16px 50px;
  background: #C9A24B;
  color: #2A1F1A;
  text-decoration: none;
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size: 14px;
  transition: all 0.3s ease;
}
.j-cta-btn:hover {
  background: transparent;
  color: #C9A24B;
  border: 1px solid #C9A24B;
}

/* 进度指示 */
.j-progress {
  position: fixed;
  right: 30px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 12px;
  z-index: 100;
}
.j-progress-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ccc;
  cursor: pointer;
  transition: all 0.3s ease;
}
.j-progress-dot.active {
  background: #9E2B25;
  transform: scale(1.5);
}

@media (max-width: 768px) {
  .j-content {
    grid-template-columns: 1fr;
    gap: 40px;
    padding: 0 30px;
  }
  .j-title {
    font-size: 36px;
  }
  .j-products {
    grid-template-columns: 1fr;
  }
  .j-progress {
    right: 15px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const scenes = document.querySelectorAll('.j-scene');
  const dots = document.querySelectorAll('.j-progress-dot');
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        // 更新进度点
        const sceneIndex = Array.from(scenes).indexOf(entry.target);
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === sceneIndex);
        });
      }
    });
  }, {
    threshold: 0.3
  });
  
  scenes.forEach(scene => observer.observe(scene));
  
  // 进度点点击跳转
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      scenes[i].scrollIntoView({ behavior: 'smooth' });
    });
  });
});
</script>

