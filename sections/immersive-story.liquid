<section class="cinnabar-journey">

  <!-- 开始页面 -->
  <div class="journey-screen">
    <div class="screen-bg">
      <div class="bg-far"></div>
      <div class="bg-mid"></div>
      <div class="bg-near"></div>
    </div>
    <div class="screen-content reveal">
      <div class="eyebrow red">CHENSHA JOURNEY</div>
      <h1 class="main-title">Into The Cinnabar</h1>
      <p class="subtitle">Scroll to explore</p>
      <div class="scroll-arrow">↓</div>
    </div>
  </div>

  <!-- 场景 1: 起源 -->
  <div class="journey-screen">
    <div class="screen-bg">
      <div class="bg-far"></div>
      <div class="bg-mid"></div>
      <div class="bg-near"></div>
    </div>
    <div class="screen-content reveal">
      <div class="scene-image" style="background-image: url('{{ 'scene-origin.png' | asset_url }}')"></div>
      <div class="eyebrow red">01 · ORIGIN</div>
      <h2 class="scene-title">{{ section.settings.scene_1_title }}</h2>
      <p class="location">中国铜仁 · Tongren, China</p>
      <p class="desc">{{ section.settings.scene_1_desc }}</p>
    </div>
  </div>

  <!-- 场景 2: 品质 -->
  <div class="journey-screen">
    <div class="screen-bg">
      <div class="bg-far"></div>
      <div class="bg-mid"></div>
      <div class="bg-near"></div>
    </div>
    <div class="screen-content reveal">
      <div class="scene-image" style="background-image: url('{{ 'scene-quality.png' | asset_url }}')"></div>
      <div class="eyebrow red">02 · QUALITY</div>
      <h2 class="scene-title">{{ section.settings.scene_2_title }}</h2>
      <p class="desc">{{ section.settings.scene_2_desc }}</p>
    </div>
  </div>

  <!-- 场景 3: 工艺 -->
  <div class="journey-screen">
    <div class="screen-bg">
      <div class="bg-far"></div>
      <div class="bg-mid"></div>
      <div class="bg-near"></div>
    </div>
    <div class="screen-content reveal">
      <div class="scene-image" style="background-image: url('{{ 'scene-craft.png' | asset_url }}')"></div>
      <div class="eyebrow red">03 · CRAFT</div>
      <h2 class="scene-title">{{ section.settings.scene_3_title }}</h2>
      <p class="desc">{{ section.settings.scene_3_desc }}</p>
    </div>
  </div>

  <!-- 场景 4: 产品 -->
  <div class="journey-screen">
    <div class="screen-bg">
      <div class="bg-far"></div>
      <div class="bg-mid"></div>
      <div class="bg-near"></div>
    </div>
    <div class="screen-content reveal">
      <div class="scene-image" style="background-image: url('{{ 'scene-product.png' | asset_url }}')"></div>
      <div class="eyebrow red">04 · COLLECTION</div>
      <h2 class="scene-title">{{ section.settings.scene_4_title }}</h2>
      <p class="desc">{{ section.settings.scene_4_desc }}</p>
    </div>
  </div>

  <!-- 结尾 -->
  <div class="journey-screen finale-screen">
    <div class="screen-content reveal">
      <div class="eyebrow gold">CHENSHA</div>
      <h2 class="finale-title">{{ section.settings.finale_title }}</h2>
      <p class="finale-desc">{{ section.settings.finale_desc }}</p>
      <a href="{{ section.settings.cta_link }}" class="cta-btn">{{ section.settings.cta_button }}</a>
    </div>
  </div>

</section>

<style>
.cinnabar-journey {
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
  background: #FAF8F4;
  color: #2A1F1A;
  width: 100%;
  margin: 0;
  padding: 0;
}

.journey-screen {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #FAF8F4;
}

.screen-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
}

.bg-far {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  background: 
    url('{{ 'ink-far-mountain.png' | asset_url }}') bottom center / 800px auto no-repeat;
  opacity: 0.25;
}

.bg-mid {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  background: 
    url('{{ 'ink-mountain.png' | asset_url }}') bottom center / 600px auto no-repeat,
    url('{{ 'ink-cloud.png' | asset_url }}') top left / 100px auto no-repeat;
  opacity: 0.4;
}

.bg-near {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  background: 
    url('{{ 'ink-bamboo.png' | asset_url }}') bottom left / 140px auto no-repeat,
    url('{{ 'ink-pine.png' | asset_url }}') bottom right / 150px auto no-repeat,
    url('{{ 'ink-plum.png' | asset_url }}') left 5% bottom 10% / 100px auto no-repeat,
    url('{{ 'ink-willow.png' | asset_url }}') right 5% bottom 12% / 110px auto no-repeat;
  opacity: 0.6;
}

.screen-content {
  position: relative;
  z-index: 10;
  text-align: center;
  max-width: 400px;
  padding: 40px;
}

.reveal {
  opacity: 0;
  transform: translateY(40px) scale(0.98);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.eyebrow {
  font-size: 12px;
  letter-spacing: 6px;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.eyebrow.red { color: #9E2B25; }
.eyebrow.gold { color: #E0C88A; }

.main-title {
  font-size: 64px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 25px;
  line-height: 1.1;
}

.subtitle {
  font-size: 16px;
  color: #8A7A72;
  letter-spacing: 2px;
  margin-bottom: 30px;
}

.scroll-arrow {
  font-size: 32px;
  color: #9E2B25;
  animation: bounceArrow 2s ease-in-out infinite;
}

@keyframes bounceArrow {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(10px); }
}

.scene-image {
  width: 300px;
  height: 300px;
  margin: 0 auto 20px;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  mix-blend-mode: multiply;
}

.scene-title {
  font-size: 36px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 12px;
  line-height: 1.2;
}

.location {
  font-size: 14px;
  color: #9E2B25;
  letter-spacing: 2px;
  margin-bottom: 18px;
}

.desc {
  font-size: 16px;
  line-height: 1.7;
  color: #5A4A42;
}

.finale-screen {
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
}

.finale-title {
  font-size: 48px;
  font-weight: 400;
  color: #FAF6F0;
  margin-bottom: 25px;
}

.finale-desc {
  font-size: 18px;
  color: #E0C88A;
  margin-bottom: 40px;
}

.cta-btn {
  display: inline-block;
  padding: 18px 60px;
  background: #C9A24B;
  color: #2A1F1A;
  text-decoration: none;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-size: 14px;
  transition: all 0.3s ease;
}

.cta-btn:hover {
  background: transparent;
  color: #C9A24B;
  border: 1px solid #C9A24B;
}

@media (max-width: 768px) {
  .main-title { font-size: 40px; }
  .screen-content { max-width: 320px; }
  .scene-image { width: 220px; height: 220px; }
  .scene-title { font-size: 28px; }
  .finale-title { font-size: 32px; }
}
</style>

<script>
(function() {
  var reveals = document.querySelectorAll('.cinnabar-journey .reveal');
  
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, {
    threshold: 0.2,
    rootMargin: '0px 0px -50px 0px'
  });

  reveals.forEach(function(el) {
    observer.observe(el);
  });
})();
</script>

{% schema %}
{
  "name": "Cinnabar Journey",
  "settings": [
    { "type": "text", "id": "scene_1_title", "label": "Scene 1 Title", "default": "Ancient Origins" },
    { "type": "textarea", "id": "scene_1_desc", "label": "Scene 1 Desc", "default": "For over two millennia, the mountains of Tongren, Guizhou have yielded the world's finest cinnabar. This sacred red stone has been treasured by emperors and scholars through every dynasty." },
    { "type": "text", "id": "scene_2_title", "label": "Scene 2 Title", "default": "Premium Quality" },
    { "type": "textarea", "id": "scene_2_desc", "label": "Scene 2 Desc", "default": "Our cinnabar boasts 99% purity, with a deep, vibrant crimson that reflects the light with a warm, golden glow. Each piece is carefully selected for the highest quality." },
    { "type": "text", "id": "scene_3_title", "label": "Scene 3 Title", "default": "Master Craftsmanship" },
    { "type": "textarea", "id": "scene_3_desc", "label": "Scene 3 Desc", "default": "Every CHENSHA bracelet is handcrafted by master artisans with decades of experience. From stringing to finishing, each step is done with meticulous care." },
    { "type": "text", "id": "scene_4_title", "label": "Scene 4 Title", "default": "Our Collection" },
    { "type": "textarea", "id": "scene_4_desc", "label": "Scene 4 Desc", "default": "Discover bracelets that carry thousands of years of Chinese heritage, crafted to be worn and treasured every day." },
    { "type": "text", "id": "finale_title", "label": "Finale Title", "default": "Thank You for Choosing CHENSHA" },
    { "type": "textarea", "id": "finale_desc", "label": "Finale Desc", "default": "Carry a piece of Chinese heritage with you." },
    { "type": "text", "id": "cta_button", "label": "CTA Button", "default": "EXPLORE MORE" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [
    {
      "name": "Cinnabar Journey",
      "category": "Featured"
    }
  ]
}
{% endschema %}
