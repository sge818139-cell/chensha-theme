<section class="cinnabar-journey">

  <!-- 固定背景层 -->
  <div class="journey-bg">
    <div class="bg-layer layer-far">
      <div class="far-mountain"></div>
      <div class="cloud cloud-1"></div>
      <div class="cloud cloud-2"></div>
    </div>
    <div class="bg-layer layer-mid-far">
      <div class="mid-mountain"></div>
      <div class="bird"></div>
    </div>
    <div class="bg-layer layer-mid">
      <div class="bamboo"></div>
      <div class="pine"></div>
    </div>
    <div class="bg-layer layer-near">
      <div class="plum"></div>
      <div class="willow"></div>
    </div>
  </div>

  <!-- 内容层 - 正常滚动 -->
  <div class="journey-content">

    <!-- 开始页面 -->
    <div class="journey-screen intro-screen">
      <div class="screen-content">
        <div class="eyebrow red">CHENSHA JOURNEY</div>
        <h1 class="main-title">Into The Cinnabar</h1>
        <p class="subtitle">Scroll to explore</p>
        <div class="scroll-arrow">↓</div>
      </div>
    </div>

    <!-- 场景 1: 起源 -->
    <div class="journey-screen">
      <div class="screen-content">
        <div class="scene-image" style="background-image: url('{{ 'scene-origin.png' | asset_url }}')"></div>
        <div class="eyebrow red">01 · ORIGIN</div>
        <h2 class="scene-title">{{ section.settings.scene_1_title }}</h2>
        <p class="location">中国铜仁 · Tongren, China</p>
        <p class="desc">{{ section.settings.scene_1_desc }}</p>
      </div>
    </div>

    <!-- 场景 2: 品质 -->
    <div class="journey-screen">
      <div class="screen-content">
        <div class="scene-image" style="background-image: url('{{ 'scene-quality.png' | asset_url }}')"></div>
        <div class="eyebrow red">02 · QUALITY</div>
        <h2 class="scene-title">{{ section.settings.scene_2_title }}</h2>
        <p class="desc">{{ section.settings.scene_2_desc }}</p>
      </div>
    </div>

    <!-- 场景 3: 工艺 -->
    <div class="journey-screen">
      <div class="screen-content">
        <div class="scene-image" style="background-image: url('{{ 'scene-craft.png' | asset_url }}')"></div>
        <div class="eyebrow red">03 · CRAFT</div>
        <h2 class="scene-title">{{ section.settings.scene_3_title }}</h2>
        <p class="desc">{{ section.settings.scene_3_desc }}</p>
      </div>
    </div>

    <!-- 场景 4: 产品 -->
    <div class="journey-screen">
      <div class="screen-content">
        <div class="scene-image" style="background-image: url('{{ 'scene-product.png' | asset_url }}')"></div>
        <div class="eyebrow red">04 · COLLECTION</div>
        <h2 class="scene-title">{{ section.settings.scene_4_title }}</h2>
        <p class="desc">{{ section.settings.scene_4_desc }}</p>
      </div>
    </div>

    <!-- 结尾 -->
    <div class="journey-screen finale-screen">
      <div class="screen-content">
        <div class="eyebrow gold">CHENSHA</div>
        <h2 class="finale-title">{{ section.settings.finale_title }}</h2>
        <p class="finale-desc">{{ section.settings.finale_desc }}</p>
        <a href="{{ section.settings.cta_link }}" class="cta-btn">{{ section.settings.cta_button }}</a>
      </div>
    </div>

  </div>

</section>

<style>
.cinnabar-journey {
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
  background: #FAF8F4;
  color: #2A1F1A;
  width: 100%;
  margin: 0;
  padding: 0;
  position: relative;
}

/* 固定背景层 */
.journey-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 1;
  pointer-events: none;
}

.bg-layer {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}

.bg-layer div {
  position: absolute;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.layer-far { opacity: 0.25; }
.far-mountain {
  bottom: 45%;
  left: 50%;
  transform: translateX(-50%);
  width: 900px;
  height: 450px;
  background-image: url('{{ 'ink-far-mountain.png' | asset_url }}');
}
.cloud {
  width: 80px;
  height: 80px;
  background-image: url('{{ 'ink-cloud.png' | asset_url }}');
}
.cloud-1 { top: 15%; left: 12%; }
.cloud-2 { top: 25%; right: 18%; width: 60px; height: 60px; }

.layer-mid-far { opacity: 0.4; }
.mid-mountain {
  bottom: 35%;
  left: 50%;
  transform: translateX(-50%);
  width: 700px;
  height: 350px;
  background-image: url('{{ 'ink-mountain.png' | asset_url }}');
}
.bird {
  top: 20%;
  left: 28%;
  width: 60px;
  height: 50px;
  background-image: url('{{ 'ink-bird.png' | asset_url }}');
}

.layer-mid { opacity: 0.55; }
.bamboo {
  bottom: 18%;
  left: 3%;
  width: 130px;
  height: 260px;
  background-image: url('{{ 'ink-bamboo.png' | asset_url }}');
}
.pine {
  bottom: 15%;
  right: 4%;
  width: 150px;
  height: 290px;
  background-image: url('{{ 'ink-pine.png' | asset_url }}');
}

.layer-near { opacity: 0.7; }
.plum {
  bottom: 10%;
  left: 8%;
  width: 110px;
  height: 220px;
  background-image: url('{{ 'ink-plum.png' | asset_url }}');
}
.willow {
  bottom: 12%;
  right: 10%;
  width: 120px;
  height: 240px;
  background-image: url('{{ 'ink-willow.png' | asset_url }}');
}

/* 内容层 */
.journey-content {
  position: relative;
  z-index: 2;
}

.journey-screen {
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.screen-content {
  text-align: center;
  max-width: 400px;
  padding: 40px;
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.eyebrow {
  font-size: 12px;
  letter-spacing: 6px;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.eyebrow.red { color: #9E2B25; }
.eyebrow.gold { color: #E0C88A; }

.main-title {
  font-size: 64px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 25px;
  line-height: 1.1;
}

.subtitle {
  font-size: 16px;
  color: #8A7A72;
  letter-spacing: 2px;
  margin-bottom: 30px;
}

.scroll-arrow {
  font-size: 32px;
  color: #9E2B25;
  animation: bounceArrow 2s ease-in-out infinite;
}

@keyframes bounceArrow {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(10px); }
}

.scene-image {
  width: 300px;
  height: 300px;
  margin: 0 auto 20px;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  mix-blend-mode: multiply;
}

.scene-title {
  font-size: 36px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 12px;
  line-height: 1.2;
}

.location {
  font-size: 14px;
  color: #9E2B25;
  letter-spacing: 2px;
  margin-bottom: 18px;
}

.desc {
  font-size: 16px;
  line-height: 1.7;
  color: #5A4A42;
}

/* 结尾 */
.finale-screen {
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
}

.finale-title {
  font-size: 48px;
  font-weight: 400;
  color: #FAF6F0;
  margin-bottom: 25px;
}

.finale-desc {
  font-size: 18px;
  color: #E0C88A;
  margin-bottom: 40px;
}

.cta-btn {
  display: inline-block;
  padding: 18px 60px;
  background: #C9A24B;
  color: #2A1F1A;
  text-decoration: none;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-size: 14px;
  transition: all 0.3s ease;
}

.cta-btn:hover {
  background: transparent;
  color: #C9A24B;
  border: 1px solid #C9A24B;
}

@media (max-width: 768px) {
  .main-title { font-size: 40px; }
  .screen-content { max-width: 320px; }
  .scene-image { width: 220px; height: 220px; }
  .scene-title { font-size: 28px; }
  .finale-title { font-size: 32px; }
  .far-mountain { width: 500px; height: 250px; }
  .mid-mountain { width: 400px; height: 200px; }
  .bamboo { width: 80px; height: 160px; }
  .pine { width: 90px; height: 180px; }
}
</style>

<script>
(function() {
  const section = document.currentScript.closest('.cinnabar-journey');
  if (!section) return;

  const layers = section.querySelectorAll('.bg-layer');
  const contents = section.querySelectorAll('.screen-content');

  // 增强的视差效果 + 内容动效
  function updateAnimation() {
    const scrollY = window.scrollY;
    const windowH = window.innerHeight;

    // 背景层视差移动 - 速度更大更明显
    const speeds = [0.2, 0.35, 0.5, 0.65];
    for (let i = 0; i < layers.length; i++) {
      if (layers[i]) {
        layers[i].style.transform = 'translateY(' + (scrollY * speeds[i]) + 'px)';
      }
    }

    // 场景内容动效 - 根据滚动位置调整透明度和位置
    for (let i = 0; i < contents.length; i++) {
      const rect = contents[i].getBoundingClientRect();
      const elementCenter = rect.top + rect.height / 2;
      const windowCenter = windowH / 2;
      const distance = Math.abs(elementCenter - windowCenter);
      const maxDistance = windowH;
      const opacity = Math.max(0.3, 1 - distance / maxDistance);
      const translateY = (elementCenter - windowCenter) * 0.1;

      contents[i].style.opacity = opacity;
      contents[i].style.transform = 'translateY(' + translateY + 'px)';
    }
  }

  window.addEventListener('scroll', updateAnimation, { passive: true });
  window.addEventListener('resize', updateAnimation);
  updateAnimation();
})();
</script>

