<section class="panther-journey">

  <div class="journey-viewport">
    <div class="journey-3d">

      <!-- 地面 -->
      <div class="journey-floor"></div>

      <!-- 远景层 -->
      <div class="j-layer j-layer-far">
        <div class="far-mountain far-mountain-left"></div>
        <div class="far-mountain far-mountain-right"></div>
        <div class="far-cloud far-cloud-1"></div>
        <div class="far-cloud far-cloud-2"></div>
      </div>

      <!-- 中景层 - 两侧植物 -->
      <div class="j-layer j-layer-mid">
        <div class="mid-plant mid-plant-left-1"></div>
        <div class="mid-plant mid-plant-left-2"></div>
        <div class="mid-plant mid-plant-right-1"></div>
        <div class="mid-plant mid-plant-right-2"></div>
      </div>

      <!-- 主角 - 朱砂原石 -->
      <div class="journey-hero">
        <div class="hero-shadow"></div>
        <div class="hero-crystal"></div>
      </div>

      <!-- 场景元素 - 从两侧浮现 -->
      <div class="scene-float scene-1-left">
        <div class="scene-card">
          <div class="scene-card-icon map-icon"></div>
          <div class="scene-card-text">
            <div class="scene-card-eyebrow">01</div>
            <div class="scene-card-title">{{ section.settings.scene_1_title }}</div>
          </div>
        </div>
      </div>

      <div class="scene-float scene-2-right">
        <div class="scene-card">
          <div class="scene-card-icon crystal-icon"></div>
          <div class="scene-card-text">
            <div class="scene-card-eyebrow">02</div>
            <div class="scene-card-title">{{ section.settings.scene_2_title }}</div>
          </div>
        </div>
      </div>

      <div class="scene-float scene-3-left">
        <div class="scene-card">
          <div class="scene-card-icon craft-icon"></div>
          <div class="scene-card-text">
            <div class="scene-card-eyebrow">03</div>
            <div class="scene-card-title">{{ section.settings.scene_3_title }}</div>
          </div>
        </div>
      </div>

      <div class="scene-float scene-4-right">
        <div class="scene-card">
          <div class="scene-card-icon product-icon"></div>
          <div class="scene-card-text">
            <div class="scene-card-eyebrow">04</div>
            <div class="scene-card-title">{{ section.settings.scene_4_title }}</div>
          </div>
        </div>
      </div>

      <!-- 底部标题 -->
      <div class="journey-title-bar">
        <div class="title-eyebrow">{{ section.settings.title_eyebrow }}</div>
        <h2 class="title-main">{{ section.settings.title_main }}</h2>
        <div class="title-line"></div>
      </div>

      <!-- 结尾 CTA -->
      <div class="journey-finale">
        <h2 class="finale-title">{{ section.settings.finale_title }}</h2>
        <p class="finale-desc">{{ section.settings.finale_desc }}</p>
        <a href="{{ section.settings.cta_link }}" class="finale-btn">{{ section.settings.cta_button }}</a>
      </div>

    </div>
  </div>

  <!-- 滚动进度 -->
  <div class="journey-progress">
    <div class="progress-track"></div>
    <div class="progress-fill"></div>
  </div>

</section>

<style>
.panther-journey {
  position: relative;
  width: 100%;
  height: 600vh;
  background: #FAF6F0;
  overflow: hidden;
}

.journey-viewport {
  position: sticky;
  top: 0;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.journey-3d {
  position: relative;
  width: 100%;
  height: 100%;
  perspective: 1200px;
  perspective-origin: 50% 40%;
}

/* 地面 */
.journey-floor {
  position: absolute;
  bottom: -20%;
  left: 50%;
  transform: translateX(-50%) rotateX(70deg);
  width: 300%;
  height: 200%;
  background: 
    radial-gradient(ellipse at center, rgba(158,43,37,0.08) 0%, transparent 60%),
    linear-gradient(180deg, #F4EDE2 0%, #E8DCC8 100%);
  transform-origin: center bottom;
}

/* 远景层 */
.j-layer {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.j-layer-far {
  opacity: 0.3;
}
.far-mountain {
  position: absolute;
  bottom: 35%;
  width: 400px;
  height: 300px;
  background: #C9B896;
  clip-path: polygon(0 100%, 15% 50%, 35% 70%, 55% 30%, 75% 60%, 90% 40%, 100% 100%);
}
.far-mountain-left { left: 0; }
.far-mountain-right { right: 0; transform: scale(1.3); }
.far-cloud {
  position: absolute;
  width: 200px;
  height: 60px;
  background: white;
  border-radius: 50%;
  opacity: 0.8;
}
.far-cloud-1 { top: 20%; left: 15%; }
.far-cloud-2 { top: 30%; right: 20%; }

/* 中景植物 */
.j-layer-mid {
  opacity: 0.4;
}
.mid-plant {
  position: absolute;
  bottom: 20%;
  width: 100px;
  height: 180px;
  background: #B8A888;
  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
}
.mid-plant-left-1 { left: 3%; }
.mid-plant-left-2 { left: 12%; bottom: 15%; transform: scale(1.4); }
.mid-plant-right-1 { right: 3%; transform: scaleX(-1); }
.mid-plant-right-2 { right: 12%; bottom: 15%; transform: scaleX(-1) scale(1.4); }

/* 主角 */
.journey-hero {
  position: absolute;
  bottom: 12%;
  left: 50%;
  transform: translateX(-50%);
  width: 120px;
  height: 120px;
  z-index: 10;
  transition: transform 0.1s linear;
}
.hero-crystal {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
  clip-path: polygon(50% 0%, 80% 20%, 100% 50%, 80% 80%, 50% 100%, 20% 80%, 0% 50%, 20% 20%);
  box-shadow: 0 0 40px rgba(158,43,37,0.4);
  animation: heroWalk 2s ease-in-out infinite;
}
.hero-shadow {
  position: absolute;
  bottom: -15px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 15px;
  background: radial-gradient(ellipse, rgba(0,0,0,0.2) 0%, transparent 70%);
  border-radius: 50%;
}
@keyframes heroWalk {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

/* 场景卡片 */
.scene-float {
  position: absolute;
  width: 280px;
  z-index: 5;
  opacity: 0;
  transition: all 1s cubic-bezier(0.4, 0, 0.2, 1);
}
.scene-float.visible {
  opacity: 1;
}
.scene-1-left {
  left: 10%;
  top: 30%;
}
.scene-2-right {
  right: 10%;
  top: 30%;
}
.scene-3-left {
  left: 10%;
  top: 30%;
}
.scene-4-right {
  right: 10%;
  top: 30%;
}
.scene-card {
  background: white;
  border-radius: 16px;
  padding: 25px;
  box-shadow: 0 15px 40px rgba(158,43,37,0.15);
  display: flex;
  align-items: center;
  gap: 20px;
}
.scene-card-icon {
  width: 60px;
  height: 60px;
  border-radius: 12px;
  flex-shrink: 0;
}
.map-icon {
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
}
.crystal-icon {
  background: linear-gradient(135deg, #C9A24B 0%, #9E2B25 100%);
}
.craft-icon {
  background: linear-gradient(135deg, #7A1F1A 0%, #2A1F1A 100%);
}
.product-icon {
  background: linear-gradient(135deg, #9E2B25 0%, #C9A24B 100%);
}
.scene-card-eyebrow {
  font-size: 12px;
  letter-spacing: 2px;
  color: #9E2B25;
  margin-bottom: 5px;
}
.scene-card-title {
  font-size: 18px;
  color: #2A1F1A;
  font-weight: 500;
}

/* 底部标题 */
.journey-title-bar {
  position: absolute;
  bottom: 8%;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 8;
}
.title-eyebrow {
  font-size: 12px;
  letter-spacing: 4px;
  color: #9E2B25;
  margin-bottom: 10px;
}
.title-main {
  font-size: 36px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 15px;
}
.title-line {
  width: 60px;
  height: 2px;
  background: #9E2B25;
  margin: 0 auto;
}

/* 结尾 */
.journey-finale {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  z-index: 20;
  opacity: 0;
  transition: opacity 1s ease;
}
.journey-finale.visible {
  opacity: 1;
}
.finale-title {
  font-size: 48px;
  font-weight: 400;
  color: #FAF6F0;
  margin-bottom: 20px;
}
.finale-desc {
  font-size: 18px;
  color: #E0C88A;
  margin-bottom: 30px;
}
.finale-btn {
  display: inline-block;
  padding: 16px 50px;
  background: #C9A24B;
  color: #2A1F1A;
  text-decoration: none;
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size: 14px;
  transition: all 0.3s ease;
}
.finale-btn:hover {
  background: transparent;
  color: #C9A24B;
  border: 1px solid #C9A24B;
}

/* 进度条 */
.journey-progress {
  position: fixed;
  right: 30px;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 200px;
  background: rgba(158,43,37,0.1);
  z-index: 100;
}
.progress-fill {
  width: 100%;
  height: 0%;
  background: #9E2B25;
  transition: height 0.1s linear;
}

@media (max-width: 768px) {
  .journey-hero {
    width: 80px;
    height: 80px;
  }
  .scene-float {
    width: 220px;
  }
  .scene-1-left, .scene-3-left {
    left: 5%;
  }
  .scene-2-right, .scene-4-right {
    right: 5%;
  }
  .title-main {
    font-size: 28px;
  }
  .finale-title {
    font-size: 32px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const journey = document.querySelector('.panther-journey');
  const hero = document.querySelector('.journey-hero');
  const scenes = document.querySelectorAll('.scene-float');
  const finale = document.querySelector('.journey-finale');
  const progressFill = document.querySelector('.progress-fill');
  const titleMain = document.querySelector('.title-main');
  const titleEyebrow = document.querySelector('.title-eyebrow');
  
  const sceneTitles = [
    'Ancient Origins',
    'Premium Quality',
    'Master Craft',
    'Our Collection'
  ];
  const sceneEyebrows = [
    '01 · ORIGIN',
    '02 · QUALITY',
    '03 · CRAFT',
    '04 · COLLECTION'
  ];
  
  function updateJourney() {
    const scrollTop = window.pageYOffset;
    const journeyTop = journey.offsetTop;
    const journeyHeight = journey.offsetHeight - window.innerHeight;
    const progress = Math.max(0, Math.min(1, (scrollTop - journeyTop) / journeyHeight));
    
    // 进度条
    progressFill.style.height = (progress * 100) + '%';
    
    // 主角向前走（变大）
    const scale = 1 + progress * 0.8;
    hero.style.transform = `translateX(-50%) scale(${scale})`;
    
    // 场景出现时机（4个场景，每个占25%）
    for (let i = 0; i < scenes.length; i++) {
      const threshold = (i + 1) * 0.18;
      if (progress > threshold) {
        scenes[i].classList.add('visible');
        // 更新底部标题
        titleMain.textContent = sceneTitles[i];
        titleEyebrow.textContent = sceneEyebrows[i];
      }
    }
    
    // 结尾
    if (progress > 0.85) {
      finale.classList.add('visible');
    } else {
      finale.classList.remove('visible');
    }
    
    // 视差 - 远景移动慢，中景移动快
    const farLayer = document.querySelector('.j-layer-far');
    const midLayer = document.querySelector('.j-layer-mid');
    if (farLayer) farLayer.style.transform = `translateY(${progress * 30}px)`;
    if (midLayer) midLayer.style.transform = `translateY(${progress * 60}px)`;
  }
  
  window.addEventListener('scroll', updateJourney);
  updateJourney();
});
</script>

{% schema %}
{
  "name": "Panther Journey",
  "settings": [
    { "type": "text", "id": "scene_1_title", "label": "Scene 1 Title", "default": "Ancient Origins" },
    { "type": "text", "id": "scene_2_title", "label": "Scene 2 Title", "default": "Premium Quality" },
    { "type": "text", "id": "scene_3_title", "label": "Scene 3 Title", "default": "Master Craft" },
    { "type": "text", "id": "scene_4_title", "label": "Scene 4 Title", "default": "Our Collection" },
    { "type": "text", "id": "title_eyebrow", "label": "Title Eyebrow", "default": "01 · ORIGIN" },
    { "type": "text", "id": "title_main", "label": "Title Main", "default": "Ancient Origins" },
    { "type": "text", "id": "finale_title", "label": "Finale Title", "default": "Thank You for Choosing CHENSHA" },
    { "type": "textarea", "id": "finale_desc", "label": "Finale Desc", "default": "Carry a piece of Chinese heritage with you." },
    { "type": "text", "id": "cta_button", "label": "CTA Button", "default": "EXPLORE MORE" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [
    {
      "name": "Panther Journey",
      "category": "Featured"
    }
  ]
}
{% endschema %}
