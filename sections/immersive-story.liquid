</style>

<script>
(function() {
  const section = document.currentScript.closest('.cinnabar-journey');
  if (!section) return;
  
  const journey = section.querySelector('.journey-container');
  const scenes = section.querySelectorAll('.scene-block');
  const finale = section.querySelector('.finale');
  const progressFill = section.querySelector('.progress-fill');
  const introText = section.querySelector('.intro-text');

  function updateJourney() {
    const rect = journey.getBoundingClientRect();
    const totalScroll = journey.offsetHeight - window.innerHeight;
    const scrolled = Math.max(0, Math.min(totalScroll, -rect.top));
    const progress = totalScroll > 0 ? scrolled / totalScroll : 0;

    if (progressFill) progressFill.style.height = (progress * 100) + '%';

    if (introText) {
      if (progress < 0.05) {
        introText.style.opacity = '1';
        introText.style.transform = 'translate(-50%, -50%)';
      } else {
        introText.style.opacity = '0';
        introText.style.transform = 'translate(-50%, -70%)';
      }
    }

    for (let i = 0; i < scenes.length; i++) {
      const threshold = (i + 1) * 0.18;
      const nextThreshold = (i + 2) * 0.18;
      if (progress > threshold && progress < nextThreshold) {
        scenes[i].classList.add('visible');
      } else {
        scenes[i].classList.remove('visible');
      }
    }

    if (finale) {
      if (progress > 0.9) {
        finale.classList.add('visible');
      } else {
        finale.classList.remove('visible');
      }
    }

    const layer1 = section.querySelector('.layer-1');
    const layer2 = section.querySelector('.layer-2');
    const layer3 = section.querySelector('.layer-3');
    const layer4 = section.querySelector('.layer-4');
    const layer5 = section.querySelector('.layer-5');

    if (layer1) layer1.style.transform = `translateY(${progress * 30}px)`;
    if (layer2) layer2.style.transform = `translateY(${progress * 60}px)`;
    if (layer3) layer3.style.transform = `translateY(${progress * 90}px)`;
    if (layer4) layer4.style.transform = `translateY(${progress * 120}px)`;
    if (layer5) layer5.style.transform = `translateY(${progress * 150}px)`;
  }

  window.addEventListener('scroll', updateJourney);
  window.addEventListener('resize', updateJourney);
  updateJourney();
})();
</script>

