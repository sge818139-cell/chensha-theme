{% assign review_count = section.settings.review_count | plus: 0 %}
{% assign start_index = product.id | modulo: 110 %}
{% if start_index < 0 %}{% assign start_index = start_index | times: -1 %}{% endif %}

<section class="customer-reviews-section">
  <div class="container">
    <h2 class="reviews-title">{{ section.settings.title }}</h2>
    
    <div class="reviews-summary">
      <div class="score-block">
        <span class="score">{{ section.settings.score }}</span>
        <span class="score-divider">/5</span>
      </div>
      <div class="stars-block">
        <div class="stars">★★★★★</div>
        <div class="review-count">{{ review_count }} reviews</div>
      </div>
    </div>

    <div class="reviews-actions">
      <a href="{{ section.settings.ask_question_link }}" class="btn-outline">{{ section.settings.ask_question_btn }}</a>
      <a href="{{ section.settings.write_review_link }}" class="btn-outline">{{ section.settings.write_review_btn }}</a>
    </div>

    <div class="review-list">
      {% for i in (0..review_count) %}
        {% assign idx = start_index | plus: i | times: 4 | modulo: 120 %}
        {% assign title = all_reviews[idx] %}
        {% assign author = all_reviews[idx | plus: 1] %}
        {% assign date = all_reviews[idx | plus: 2] %}
        {% assign content = all_reviews[idx | plus: 3] %}
        
        {% if title != blank and i < review_count %}
        <div class="review-item">
          <div class="review-stars">★★★★★</div>
          <div class="review-meta">
            <span class="review-date">{{ date }}</span>
          </div>
          <h4 class="review-title">{{ title }}</h4>
          <div class="review-author">
            {{ author }}
            <span class="verified-badge">✓ Verified Buyer</span>
          </div>
          <p class="review-content">{{ content }}</p>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    <a href="{{ section.settings.read_all_link }}" class="read-all-link">Read all {{ review_count }} reviews</a>
  </div>
</section>

<style>
.customer-reviews-section {
  padding: 80px 0;
  background: #FAF8F4;
}

.reviews-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 32px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 30px;
  padding-bottom: 15px;
  border-bottom: 1px solid #E8E0D5;
}

.reviews-summary {
  display: flex;
  align-items: center;
  gap: 40px;
  margin-bottom: 30px;
}

.score-block {
  display: flex;
  align-items: baseline;
  gap: 5px;
}

.score {
  font-size: 48px;
  font-weight: 300;
  color: #2A1F1A;
  line-height: 1;
}

.score-divider {
  font-size: 18px;
  color: #8A7A72;
}

.stars {
  color: #C9A24B;
  font-size: 18px;
  margin-bottom: 5px;
}

.review-count {
  font-size: 14px;
  color: #8A7A72;
}

.reviews-actions {
  display: flex;
  gap: 15px;
  margin-bottom: 40px;
  justify-content: flex-end;
}

.btn-outline {
  padding: 12px 24px;
  border: 1px solid #2A1F1A;
  background: transparent;
  color: #2A1F1A;
  font-size: 13px;
  letter-spacing: 1px;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;
}

.btn-outline:hover {
  background: #2A1F1A;
  color: #FAF8F4;
}

.review-list {
  margin-bottom: 30px;
}

.review-item {
  padding: 25px 0;
  border-bottom: 1px solid #E8E0D5;
}

.review-stars {
  color: #C9A24B;
  font-size: 14px;
  margin-bottom: 8px;
}

.review-date {
  font-size: 13px;
  color: #8A7A72;
  float: right;
}

.review-title {
  font-size: 18px;
  font-weight: 600;
  color: #2A1F1A;
  margin: 10px 0 5px 0;
}

.review-author {
  font-size: 14px;
  color: #5A4A42;
  margin-bottom: 10px;
}

.verified-badge {
  color: #9E2B25;
  font-size: 12px;
  margin-left: 8px;
}

.review-content {
  font-size: 15px;
  line-height: 1.7;
  color: #5A4A42;
}

.read-all-link {
  display: block;
  text-align: center;
  font-size: 14px;
  color: #9E2B25;
  text-decoration: underline;
  margin-top: 20px;
}
</style>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "score",
      "label": "Average Score",
      "default": "4.9"
    },
    {
      "type": "range",
      "id": "review_count",
      "label": "Number of Reviews to Display",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "ask_question_btn",
      "label": "Ask Question Button Text",
      "default": "Ask a Question"
    },
    {
      "type": "url",
      "id": "ask_question_link",
      "label": "Ask Question Button Link"
    },
    {
      "type": "text",
      "id": "write_review_btn",
      "label": "Write Review Button Text",
      "default": "Write a Review"
    },
    {
      "type": "url",
      "id": "write_review_link",
      "label": "Write Review Button Link"
    },
    {
      "type": "url",
      "id": "read_all_link",
      "label": "Read All Reviews Link"
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
{% endschema %}
