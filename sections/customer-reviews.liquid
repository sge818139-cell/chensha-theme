<section class="customer-reviews-section">
  <div class="container">
    <h2 class="reviews-title">{{ section.settings.title }}</h2>
    
    <div class="reviews-summary">
      <div class="score-block">
        <span class="score">{{ section.settings.score }}</span>
        <span class="score-divider">/5</span>
      </div>
      <div class="stars-block">
        <div class="stars">★★★★★</div>
        <div class="review-count">{{ section.settings.review_count }} reviews</div>
      </div>
    </div>

    <div class="reviews-actions">
      <button class="btn-outline">{{ section.settings.ask_question_btn }}</button>
      <button class="btn-outline">{{ section.settings.write_review_btn }}</button>
    </div>

    <div class="review-list">
      {% for block in section.blocks %}
        <div class="review-item">
          <div class="review-stars">{{ block.settings.stars }}</div>
          <div class="review-meta">
            <span class="review-date">{{ block.settings.date }}</span>
          </div>
          <h4 class="review-title">{{ block.settings.title }}</h4>
          <div class="review-author">
            {{ block.settings.author }}
            {% if block.settings.verified %}
              <span class="verified-badge">✓ Verified Buyer</span>
            {% endif %}
          </div>
          <p class="review-content">{{ block.settings.content }}</p>
        </div>
      {% endfor %}
    </div>

    <a href="#" class="read-all-link">{{ section.settings.read_all_link }}</a>
  </div>
</section>

<style>
.customer-reviews-section {
  padding: 80px 0;
  background: #FAF8F4;
}

.reviews-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 32px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 30px;
  padding-bottom: 15px;
  border-bottom: 1px solid #E8E0D5;
}

.reviews-summary {
  display: flex;
  align-items: center;
  gap: 40px;
  margin-bottom: 30px;
}

.score-block {
  display: flex;
  align-items: baseline;
  gap: 5px;
}

.score {
  font-size: 48px;
  font-weight: 300;
  color: #2A1F1A;
  line-height: 1;
}

.score-divider {
  font-size: 18px;
  color: #8A7A72;
}

.stars {
  color: #C9A24B;
  font-size: 18px;
  margin-bottom: 5px;
}

.review-count {
  font-size: 14px;
  color: #8A7A72;
}

.reviews-actions {
  display: flex;
  gap: 15px;
  margin-bottom: 40px;
  justify-content: flex-end;
}

.btn-outline {
  padding: 12px 24px;
  border: 1px solid #2A1F1A;
  background: transparent;
  color: #2A1F1A;
  font-size: 13px;
  letter-spacing: 1px;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-outline:hover {
  background: #2A1F1A;
  color: #FAF8F4;
}

.review-list {
  margin-bottom: 30px;
}

.review-item {
  padding: 25px 0;
  border-bottom: 1px solid #E8E0D5;
}

.review-stars {
  color: #C9A24B;
  font-size: 14px;
  margin-bottom: 8px;
}

.review-date {
  font-size: 13px;
  color: #8A7A72;
  float: right;
}

.review-title {
  font-size: 18px;
  font-weight: 600;
  color: #2A1F1A;
  margin: 10px 0 5px 0;
}

.review-author {
  font-size: 14px;
  color: #5A4A42;
  margin-bottom: 10px;
}

.verified-badge {
  color: #9E2B25;
  font-size: 12px;
  margin-left: 8px;
}

.review-content {
  font-size: 15px;
  line-height: 1.7;
  color: #5A4A42;
}

.read-all-link {
  display: block;
  text-align: center;
  font-size: 14px;
  color: #9E2B25;
  text-decoration: underline;
  margin-top: 20px;
}
</style>

{% schema %}
{
  "name": "Customer Reviews",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "score",
      "label": "Average Score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review Count",
      "default": "6"
    },
    {
      "type": "text",
      "id": "ask_question_btn",
      "label": "Ask Question Button",
      "default": "Ask a Question"
    },
    {
      "type": "text",
      "id": "write_review_btn",
      "label": "Write Review Button",
      "default": "Write a Review"
    },
    {
      "type": "text",
      "id": "read_all_link",
      "label": "Read All Link Text",
      "default": "Read all 6 reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "stars",
          "label": "Stars",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "2 weeks ago"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Title",
          "default": "Beautiful and Meaningful"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Lauren M."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Buyer",
          "default": true
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Review Content",
          "default": "<p>The details are stunning and the cinnabar catches the light so beautifully. It feels like a little piece of Chinese culture I can carry with me every day.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Beautiful and Meaningful",
            "author": "Lauren M.",
            "date": "2 weeks ago",
            "verified": true,
            "content": "<p>The details are stunning and the cinnabar catches the light so beautifully. It feels like a little piece of Chinese culture I can carry with me every day.</p>"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Great Quality, Worth Every Penny",
            "author": "Sarah K.",
            "date": "1 month ago",
            "verified": true,
            "content": "<p>Such beautiful craftsmanship. The bead is smooth and the color is exactly as shown. It's become my daily go-to bracelet. The packaging was also lovely - perfect for gifting.</p>"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Love the Story Behind It",
            "author": "Michelle L.",
            "date": "2 months ago",
            "verified": true,
            "content": "<p>I was drawn to the meaning behind cinnabar and the brand's story. This bracelet exceeded my expectations. It feels special and I get compliments all the time.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
