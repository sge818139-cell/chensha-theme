{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Join the CHENSHA Circle" },
    { "type": "text", "id": "title_cn", "label": "Chinese title", "default": "入 會" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Subscribe for early access to limited collections, lunar-new-moon rituals, and a private 15% welcome code." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "button", "label": "Button text", "default": "Subscribe" }
  ]
}
{% endschema %}
<section class="newsletter" id="journal">
  <div class="container">
    <h2>{{ section.settings.title }}<span class="cn">{{ section.settings.title_cn }}</span></h2>
    <p>{{ section.settings.lead }}</p>
    {% form 'customer' %}
      <div class="nl-form">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required>
        <button type="submit">{{ section.settings.button }}</button>
      </div>
    {% endform %}
    <div class="nl-note">By subscribing, you agree to our Privacy Policy. Unsubscribe anytime.</div>
  </div>
</section>
