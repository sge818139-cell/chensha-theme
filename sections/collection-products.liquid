<section class="collection-products">
  <div class="container collection-layout">
    <!-- 左侧筛选栏 -->
    <aside class="collection-sidebar">
      <div class="filter-title">FILTER BY</div>
      <div class="filter-group">
        <div class="filter-label">Intention <span class="filter-plus">+</span></div>
      </div>
      <div class="filter-group">
        <div class="filter-label">Symbol <span class="filter-plus">+</span></div>
      </div>
      <div class="filter-group">
        <div class="filter-label">Material <span class="filter-plus">+</span></div>
      </div>
      <div class="filter-group">
        <div class="filter-label">Price <span class="filter-plus">+</span></div>
      </div>
    </aside>

    <!-- 右侧产品网格 -->
    <div class="collection-main">
      <div class="collection-toolbar">
        <div class="collection-count">{{ collection.products_count }} RESULTS</div>
        <div class="collection-sort">SORT BY: NEWEST ↓</div>
      </div>
      <div class="prod-grid">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p class="sec-lead" style="grid-column:1/-1;text-align:center">No products yet.</p>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Products",
  "settings": []
}
{% endschema %}
