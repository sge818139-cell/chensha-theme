{% schema %}
{
  "name": "Collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated Collections" },
    { "type": "text", "id": "title", "label": "Title", "default": "Wear the Tradition" },
    { "type": "text", "id": "title_cn", "label": "Chinese title", "default": "系 列" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cinnabar Bracelets" },
        { "type": "text", "id": "title_cn", "label": "Chinese title", "default": "硃砂手串" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections",
      "blocks": [
        { "type": "card", "settings": { "title": "Cinnabar Bracelets", "title_cn": "硃砂手串" } },
        { "type": "card", "settings": { "title": "Cloisonné & Gold", "title_cn": "景泰藍 · 鎏金" } },
        { "type": "card", "settings": { "title": "Woven Charms", "title_cn": "編繩掛飾" } }
      ]
    }
  ]
}
{% endschema %}
<section class="collections" id="collections">
  <div class="container">
    <div style="text-align:center;max-width:700px;margin:0 auto">
      <div class="sec-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="sec-title">{{ section.settings.title }}<span class="cn">{{ section.settings.title_cn }}</span></h2>
    </div>
    <div class="coll-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <a href="{{ block.settings.link | default: '#' }}" class="coll-card" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}">
            {% else %}
              <img src="{{ 'p04.jpg' | asset_url }}" alt="{{ block.settings.title }}">
            {% endif %}
            <div class="coll-overlay">
              <h3>{{ block.settings.title }}</h3>
              <div class="cn">{{ block.settings.title_cn }}</div>
              <span class="shop">Shop Now &rarr;</span>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <a href="#bracelets" class="coll-card">
          <img src="{{ 'p01.jpg' | asset_url }}" alt="Cinnabar Bracelets">
          <div class="coll-overlay"><h3>Cinnabar Bracelets</h3><div class="cn">硃砂手串</div><span class="shop">Shop Now &rarr;</span></div>
        </a>
        <a href="#bracelets" class="coll-card">
          <img src="{{ 'p02.jpg' | asset_url }}" alt="Cloisonné & Gold">
          <div class="coll-overlay"><h3>Cloisonn&eacute; &amp; Gold</h3><div class="cn">景泰藍 · 鎏金</div><span class="shop">Shop Now &rarr;</span></div>
        </a>
        <a href="#bracelets" class="coll-card">
          <img src="{{ 'p03.jpg' | asset_url }}" alt="Woven Charms">
          <div class="coll-overlay"><h3>Woven Charms</h3><div class="cn">編繩掛飾</div><span class="shop">Shop Now &rarr;</span></div>
        </a>
      {% endif %}
    </div>
  </div>
</section>
