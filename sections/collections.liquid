{% schema %}
{
  "name": "Collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated Collections" },
    { "type": "text", "id": "title", "label": "Title", "default": "Wear the Tradition" },
    { "type": "text", "id": "title_cn", "label": "Chinese title", "default": "系 列" },
    { "type": "image_picker", "id": "img1", "label": "Card 1 image" },
    { "type": "text", "id": "title1", "label": "Card 1 title", "default": "Cinnabar Bracelets" },
    { "type": "text", "id": "title1_cn", "label": "Card 1 Chinese", "default": "硃砂手串" },
    { "type": "image_picker", "id": "img2", "label": "Card 2 image" },
    { "type": "text", "id": "title2", "label": "Card 2 title", "default": "Cloisonné & Gold" },
    { "type": "text", "id": "title2_cn", "label": "Card 2 Chinese", "default": "景泰藍 · 鎏金" },
    { "type": "image_picker", "id": "img3", "label": "Card 3 image" },
    { "type": "text", "id": "title3", "label": "Card 3 title", "default": "Woven Charms" },
    { "type": "text", "id": "title3_cn", "label": "Card 3 Chinese", "default": "編繩掛飾" }
  ]
}
{% endschema %}
<section class="collections" id="collections">
  <div class="container">
    <div style="text-align:center;max-width:700px;margin:0 auto">
      <div class="sec-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="sec-title">{{ section.settings.title }}<span class="cn">{{ section.settings.title_cn }}</span></h2>
    </div>
    <div class="coll-grid">
      <a href="javascript:void(0)" class="coll-card">
        {% if section.settings.img1 %}
          <img src="{{ section.settings.img1 | image_url: width: 800 }}" alt="{{ section.settings.title1 }}">
        {% else %}
          <img src="{{ 'p01.jpg' | asset_url }}" alt="{{ section.settings.title1 }}">
        {% endif %}
        <div class="coll-overlay"><h3>{{ section.settings.title1 }}</h3><div class="cn">{{ section.settings.title1_cn }}</div><span class="shop">Shop Now &rarr;</span></div>
      </a>
      <a href="javascript:void(0)" class="coll-card">
        {% if section.settings.img2 %}
          <img src="{{ section.settings.img2 | image_url: width: 800 }}" alt="{{ section.settings.title2 }}">
        {% else %}
          <img src="{{ 'p02.jpg' | asset_url }}" alt="{{ section.settings.title2 }}">
        {% endif %}
        <div class="coll-overlay"><h3>{{ section.settings.title2 }}</h3><div class="cn">{{ section.settings.title2_cn }}</div><span class="shop">Shop Now &rarr;</span></div>
      </a>
      <a href="javascript:void(0)" class="coll-card">
        {% if section.settings.img3 %}
          <img src="{{ section.settings.img3 | image_url: width: 800 }}" alt="{{ section.settings.title3 }}">
        {% else %}
          <img src="{{ 'p03.jpg' | asset_url }}" alt="{{ section.settings.title3 }}">
        {% endif %}
        <div class="coll-overlay"><h3>{{ section.settings.title3 }}</h3><div class="cn">{{ section.settings.title3_cn }}</div><span class="shop">Shop Now &rarr;</span></div>
      </a>
    </div>
  </div>
</section>
