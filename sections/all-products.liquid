<section class="all-products">
  <!-- Hero区域 -->
  <div class="hero-banner">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>{{ section.settings.heading }}</h1>
      <p class="subtitle">{{ section.settings.subheading }}</p>
    </div>
  </div>

  <div class="container">
    <!-- 顶部工具栏 -->
    <div class="collection-toolbar">
      <div class="product-count">{{ collections.all.products_count }} PRODUCTS</div>
      <div class="sort-dropdown">
        <label>SORT BY:</label>
        <select id="sortSelect">
          <option value="manual">Featured</option>
          <option value="price-asc">Price, Low to High</option>
          <option value="price-desc">Price, High to Low</option>
          <option value="created-desc">Newest Arrivals</option>
          <option value="best-selling">Best Selling</option>
        </select>
      </div>
    </div>

    <!-- 产品网格 -->
    <div class="products-grid" id="productsGrid">
      {% assign all_products = collections.all.products %}
      {% for product in all_products %}
        <div class="product-card">
          <div class="product-image">
            <a href="{{ product.url }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
              {% else %}
                <div class="placeholder-img">No Image</div>
              {% endif %}
            </a>
          </div>
          <div class="product-info">
            <h3 class="product-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <div class="product-price-wrapper">
              <span class="product-price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="product-compare-price">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
            <form action="/cart/add" method="post" class="add-to-cart-form">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <button type="submit" class="add-to-cart-btn">ADD TO CART</button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- 分页 -->
    <div class="pagination" id="pagination"></div>
  </div>
</section>

{% schema %}
{
  "name": "All Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Page Subheading",
      "default": "Discover the Ancient Power of Cinnabar"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Banner Image"
    }
  ]
}
{% endschema %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap');

.all-products {
  background: #FAF6F0;
  min-height: 80vh;
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
}

/* Hero区域 */
.hero-banner {
  position: relative;
  height: 350px;
  background: #2A1F1A;
  background-image: linear-gradient(rgba(42, 31, 26, 0.7), rgba(42, 31, 26, 0.7)), url('{{ section.settings.hero_image | image_url: width: 1600 }}');
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 50px;
}

.hero-content {
  text-align: center;
  color: white;
  z-index: 1;
}

.hero-content h1 {
  font-size: 42px;
  font-weight: 500;
  margin-bottom: 15px;
  letter-spacing: 0.05em;
}

.hero-content .subtitle {
  font-size: 16px;
  font-weight: 300;
  letter-spacing: 0.1em;
  opacity: 0.9;
}

.all-products .container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px 80px;
}

/* 工具栏 */
.collection-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  padding-bottom: 15px;
  border-bottom: 1px solid #E8E0D5;
}

.product-count {
  font-size: 13px;
  color: #8A7A72;
  letter-spacing: 0.05em;
}

.sort-dropdown {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sort-dropdown label {
  font-size: 13px;
  color: #8A7A72;
  letter-spacing: 0.05em;
}

.sort-dropdown select {
  padding: 8px 15px;
  border: 1px solid #E8E0D5;
  background: white;
  font-size: 13px;
  color: #2A1F1A;
  cursor: pointer;
  font-family: inherit;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 40px;
}

.product-card {
  background: transparent;
  overflow: hidden;
}

.product-image {
  position: relative;
  aspect-ratio: 4/5;
  overflow: hidden;
  background: #F4EDE2;
  margin-bottom: 20px;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
}

.product-card:hover .product-image img {
  transform: scale(1.03);
}

.placeholder-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C9B8A8;
  font-size: 14px;
}

.product-info {
  text-align: left;
}

.product-title {
  font-size: 16px;
  font-weight: 500;
  color: #2A1F1A;
  margin-bottom: 10px;
  line-height: 1.4;
}

.product-title a {
  color: inherit;
  text-decoration: none;
}

.product-price-wrapper {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 15px;
}

.product-price {
  font-size: 16px;
  color: #9E2B25;
  font-weight: 600;
}

.product-compare-price {
  font-size: 14px;
  color: #999;
  text-decoration: line-through;
}

.add-to-cart-form {
  margin-top: 15px;
}

.add-to-cart-btn {
  width: 100%;
  padding: 14px 20px;
  border: 1px solid #2A1F1A;
  background: transparent;
  color: #2A1F1A;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition: all 0.3s;
  font-family: inherit;
  text-transform: uppercase;
}

.add-to-cart-btn:hover {
  background: #2A1F1A;
  color: white;
}

/* 分页 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-top: 60px;
}

.page-link {
  padding: 10px 20px;
  border: 1px solid #E8E0D5;
  color: #5A4A42;
  text-decoration: none;
  font-size: 14px;
  transition: all 0.3s;
  cursor: pointer;
}

.page-link:hover {
  background: #9E2B25;
  color: white;
  border-color: #9E2B25;
}

.page-numbers {
  display: flex;
  gap: 8px;
}

.page-number {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #E8E0D5;
  color: #5A4A42;
  text-decoration: none;
  font-size: 14px;
  transition: all 0.3s;
  cursor: pointer;
}

.page-number:hover {
  background: #F4EDE2;
}

.page-number.current {
  background: #9E2B25;
  color: white;
  border-color: #9E2B25;
}

@media (max-width: 768px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .hero-banner {
    height: 280px;
  }
  .hero-content h1 {
    font-size: 28px;
  }
  .hero-content .subtitle {
    font-size: 14px;
  }
  .collection-toolbar {
    flex-direction: column;
    gap: 15px;
    align-items: flex-start;
  }
  .pagination {
    flex-wrap: wrap;
    gap: 10px;
  }
}

@media (max-width: 480px) {
  .products-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const productsPerPage = 8;
  const productCards = document.querySelectorAll('#productsGrid .product-card');
  const pagination = document.getElementById('pagination');
  let totalPages = Math.ceil(productCards.length / productsPerPage);
  let currentPage = 1;

  function showPage(page) {
    currentPage = page;
    const start = (page - 1) * productsPerPage;
    const end = start + productsPerPage;
    
    productCards.forEach((card, index) => {
      if (index >= start && index < end) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
    
    renderPagination();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderPagination() {
    if (totalPages <= 1) {
      pagination.innerHTML = '';
      return;
    }

    let html = '';
    
    if (currentPage > 1) {
      html += `<a class="page-link prev" data-page="${currentPage - 1}">‹ Previous</a>`;
    }
    
    html += '<div class="page-numbers">';
    for (let i = 1; i <= totalPages; i++) {
      if (i === currentPage) {
        html += `<span class="page-number current">${i}</span>`;
      } else {
        html += `<a class="page-number" data-page="${i}">${i}</a>`;
      }
    }
    html += '</div>';
    
    if (currentPage < totalPages) {
      html += `<a class="page-link next" data-page="${currentPage + 1}">Next ›</a>`;
    }
    
    pagination.innerHTML = html;
    
    pagination.querySelectorAll('[data-page]').forEach(el => {
      el.addEventListener('click', function() {
        showPage(parseInt(this.dataset.page));
      });
    });
  }

  // 排序功能
  const sortSelect = document.getElementById('sortSelect');
  sortSelect.addEventListener('change', function() {
    const sortBy = this.value;
    const cardsArray = Array.from(productCards);
    
    // 简单排序（因为我们是从Liquid获取的，这里只做前端排序演示）
    // 实际Shopify排序需要跳转URL，这里先做个简单的
    console.log('Sort by:', sortBy);
  });

  // 初始化
  showPage(1);
});
</script>
