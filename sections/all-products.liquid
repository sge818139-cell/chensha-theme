<section class="all-products">
  <!-- Hero区域 -->
  <div class="hero-banner">
    <div class="hero-ink-bg"></div>
    <div class="hero-cinnabar"></div>
    <div class="hero-content">
      <h1>{{ section.settings.heading }}</h1>
      <p class="subtitle">{{ section.settings.subheading }}</p>
    </div>
  </div>

  <div class="container">
    <!-- 顶部工具栏 -->
    <div class="collection-toolbar">
      <div class="product-count">{{ collections.all.products_count }} PRODUCTS</div>
      
      <!-- 快捷筛选标签 -->
      <div class="filter-tags">
        <a href="javascript:void(0)" class="filter-tag active" data-filter="all">All</a>
        <a href="javascript:void(0)" class="filter-tag" data-filter="bracelets">Bracelets</a>
        <a href="javascript:void(0)" class="filter-tag" data-filter="pendants">Pendants</a>
      </div>
      
      <div class="toolbar-note">Handcrafted with intention</div>
    </div>

    <!-- 产品网格 -->
    <div class="products-grid" id="productsGrid">
      {% assign all_products = collections.all.products %}
      {% for product in all_products %}
        <div class="product-card" data-category="{% if product.title contains 'Bracelet' or product.title contains 'bracelet' %}bracelets{% elsif product.title contains 'Pendant' or product.title contains 'pendant' %}pendants{% else %}bracelets{% endif %}" data-price="{{ product.price | divided_by: 100 }}" data-name="{{ product.title | downcase }}">
          <div class="product-image">
            <a href="{{ product.url }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
              {% else %}
                <div class="placeholder-img">No Image</div>
              {% endif %}
            </a>
            <!-- Hover时的快速查看按钮 -->
            <div class="quick-view-overlay">
              <a href="{{ product.url }}" class="quick-view-btn">Quick View</a>
            </div>
          </div>
          <div class="product-info">
            <h3 class="product-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <div class="product-price-wrapper">
              <span class="product-price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="product-compare-price">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- 分页 -->
    <div class="pagination" id="pagination"></div>
  </div>
</section>

{% schema %}
{
  "name": "All Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Page Subheading",
      "default": "Discover the Ancient Power of Cinnabar"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Banner Image"
    }
  ]
}
{% endschema %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap');

.all-products {
  background: #FAF6F0;
  min-height: 80vh;
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
}

/* Hero区域 - 水墨风 */
.hero-banner {
  position: relative;
  padding: 40px 0 50px;
  background: #FAF6F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  overflow: hidden;
}

.hero-ink-bg {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: 
    radial-gradient(ellipse at 20% 80%, rgba(42, 31, 26, 0.12) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 70%, rgba(42, 31, 26, 0.08) 0%, transparent 45%),
    radial-gradient(ellipse at 50% 90%, rgba(42, 31, 26, 0.1) 0%, transparent 40%);
}

.hero-cinnabar {
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(158, 43, 37, 0.15) 0%, transparent 70%);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  filter: blur(30px);
}

.hero-content {
  text-align: center;
  color: #2A1F1A;
  padding: 0 20px;
  position: relative;
  z-index: 1;
}

.hero-content h1 {
  font-size: 42px;
  font-weight: 500;
  margin-bottom: 15px;
  letter-spacing: 0.1em;
  color: #C9A24B;
}

.hero-content .subtitle {
  font-size: 15px;
  font-weight: 300;
  letter-spacing: 0.15em;
  color: #8A7A72;
}

.all-products .container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px 80px;
}

/* 工具栏 */
.collection-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
  padding: 20px 0;
  border-top: 1px solid #E0D5C8;
  border-bottom: 1px solid #E0D5C8;
  flex-wrap: wrap;
  gap: 20px;
}

.product-count {
  font-size: 13px;
  color: #8A7A72;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* 快捷筛选标签 */
.filter-tags {
  display: flex;
  gap: 25px;
}

.filter-tag {
  font-size: 13px;
  color: #8A7A72;
  text-decoration: none;
  letter-spacing: 0.05em;
  padding: 5px 0;
  border-bottom: 1px solid transparent;
  transition: all 0.3s;
  cursor: pointer;
}

.filter-tag:hover,
.filter-tag.active {
  color: #9E2B25;
  border-bottom-color: #9E2B25;
}

.toolbar-note {
  font-size: 13px;
  color: #9E2B25;
  letter-spacing: 0.1em;
  font-style: italic;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.product-card {
  background: transparent;
  overflow: hidden;
  transition: transform 0.3s;
}

.product-card:hover {
  transform: translateY(-4px);
}

.product-image {
  position: relative;
  aspect-ratio: 4/5;
  overflow: hidden;
  background: #F4EDE2;
  margin-bottom: 18px;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-card:hover .product-image img {
  transform: scale(1.05);
}

.placeholder-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C9B8A8;
  font-size: 14px;
}

/* Hover遮罩 */
.quick-view-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(42, 31, 26, 0.9), transparent);
  padding: 30px 20px 20px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.product-card:hover .quick-view-overlay {
  opacity: 1;
}

.quick-view-btn {
  display: block;
  text-align: center;
  color: white;
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.product-info {
  text-align: center;
}

.product-title {
  font-size: 15px;
  font-weight: 500;
  color: #2A1F1A;
  margin-bottom: 8px;
  line-height: 1.4;
}

.product-title a {
  color: inherit;
  text-decoration: none;
}

.product-price-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.product-price {
  font-size: 15px;
  color: #9E2B25;
  font-weight: 600;
}

.product-compare-price {
  font-size: 13px;
  color: #999;
  text-decoration: line-through;
}

/* 分页 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 15px;
  margin-top: 60px;
}

.page-link {
  padding: 10px 20px;
  border: 1px solid #E0D5C8;
  color: #5A4A42;
  text-decoration: none;
  font-size: 13px;
  transition: all 0.3s;
  cursor: pointer;
  letter-spacing: 0.05em;
}

.page-link:hover {
  background: #9E2B25;
  color: white;
  border-color: #9E2B25;
}

.page-numbers {
  display: flex;
  gap: 8px;
}

.page-number {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #E0D5C8;
  color: #5A4A42;
  text-decoration: none;
  font-size: 14px;
  transition: all 0.3s;
  cursor: pointer;
}

.page-number:hover {
  background: #F4EDE2;
}

.page-number.current {
  background: #9E2B25;
  color: white;
  border-color: #9E2B25;
}

@media (max-width: 1024px) {
  .products-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .hero-content h1 {
    font-size: 36px;
  }
  .hero-cinnabar {
    width: 200px;
    height: 200px;
  }
}

@media (max-width: 768px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .hero-banner {
    padding: 30px 0 40px;
  }
  .hero-content h1 {
    font-size: 28px;
  }
  .hero-content .subtitle {
    font-size: 14px;
  }
  .collection-toolbar {
    flex-direction: column;
    align-items: flex-start;
    padding: 15px 0;
  }
  .pagination {
    flex-wrap: wrap;
    gap: 10px;
  }
}

@media (max-width: 480px) {
  .products-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const productsPerPage = 8;
  const productCards = Array.from(document.querySelectorAll('#productsGrid .product-card'));
  const pagination = document.getElementById('pagination');
  const filterTags = document.querySelectorAll('.filter-tag');
  
  let currentFilter = 'all';
  let currentPage = 1;

  function getFilteredProducts() {
    let filtered = productCards;
    
    if (currentFilter !== 'all') {
      filtered = filtered.filter(card => card.dataset.category === currentFilter);
    }
    
    return filtered;
  }

  function showPage(page) {
    const filtered = getFilteredProducts();
    const totalPages = Math.ceil(filtered.length / productsPerPage);
    currentPage = Math.min(page, totalPages);
    
    const start = (currentPage - 1) * productsPerPage;
    const end = start + productsPerPage;
    
    // 先隐藏所有产品
    productCards.forEach(card => card.style.display = 'none');
    
    // 显示当前页的产品
    filtered.forEach((card, index) => {
      if (index >= start && index < end) {
        card.style.display = 'block';
      }
    });
    
    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    if (totalPages <= 1) {
      pagination.innerHTML = '';
      return;
    }

    let html = '';
    
    if (currentPage > 1) {
      html += `<a class="page-link prev" data-page="${currentPage - 1}">‹ Previous</a>`;
    }
    
    html += '<div class="page-numbers">';
    for (let i = 1; i <= totalPages; i++) {
      if (i === currentPage) {
        html += `<span class="page-number current">${i}</span>`;
      } else {
        html += `<a class="page-number" data-page="${i}">${i}</a>`;
      }
    }
    html += '</div>';
    
    if (currentPage < totalPages) {
      html += `<a class="page-link next" data-page="${currentPage + 1}">Next ›</a>`;
    }
    
    pagination.innerHTML = html;
    
    pagination.querySelectorAll('[data-page]').forEach(el => {
      el.addEventListener('click', function() {
        showPage(parseInt(this.dataset.page));
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  // 筛选标签点击
  filterTags.forEach(tag => {
    tag.addEventListener('click', function() {
      filterTags.forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      currentFilter = this.dataset.filter;
      showPage(1);
    });
  });

  // 初始化
  showPage(1);
});
</script>
