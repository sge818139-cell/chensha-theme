<section class="all-products">
  <!-- Hero区域 - 左右布局 -->
  <div class="collection-hero">
    <div class="container collection-hero-grid">
      <div class="collection-hero-text">
        <div class="sec-eyebrow">{{ section.settings.eyebrow }}</div>
        <h1 class="collection-hero-title">{{ section.settings.title }}<span class="cn-title">{{ section.settings.cn_title }}</span></h1>
        <div class="hero-divider"></div>
        <p class="collection-hero-desc">{{ section.settings.description }}</p>
      </div>
      <div class="collection-hero-img">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}">
        {% else %}
          <img src="{{ 'collection-hero.jpg' | asset_url }}" alt="{{ section.settings.title | escape }}">
        {% endif %}
      </div>
    </div>
  </div>

  <div class="container">
    <!-- 顶部工具栏 -->
    <div class="collection-toolbar">
      <div class="product-count">{{ collections.all.products_count }} PRODUCTS</div>
      
      <!-- 快捷筛选标签 -->
      <div class="filter-tags">
        <a href="{{ section.settings.all_link }}" class="filter-tag active">All</a>
        <a href="{{ section.settings.conventional_link }}" class="filter-tag">Conventional</a>
        <a href="{{ section.settings.customized_link }}" class="filter-tag">Customized</a>
      </div>
      
      <div class="toolbar-note">Handcrafted with intention</div>
    </div>

    <!-- 产品网格 -->
    <div class="products-grid" id="productsGrid">
      {% assign all_products = collections.all.products %}
      {% for product in all_products %}
        <div class="product-card" data-price="{{ product.price | divided_by: 100 }}" data-name="{{ product.title | downcase }}">
          <div class="product-image">
            <a href="{{ product.url }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
              {% else %}
                <div class="placeholder-img">No Image</div>
              {% endif %}
            </a>
            <!-- Hover时的快速查看按钮 -->
            <div class="quick-view-overlay">
              <a href="{{ product.url }}" class="quick-view-btn">Quick View</a>
            </div>
          </div>
          <div class="product-info">
            <h3 class="product-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <div class="product-price-wrapper">
              <span class="product-price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="product-compare-price">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- 分页 -->
    <div class="pagination" id="pagination"></div>
  </div>
</section>

{% schema %}
{
  "name": "All Products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE CHENSHA COLLECTION" },
    { "type": "text", "id": "title", "label": "Title", "default": "Our Full Collection" },
    { "type": "text", "id": "cn_title", "label": "Chinese Title", "default": "全 部 作 品" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Every CHENSHA piece begins with a belief — that what you wear should carry meaning beyond adornment. Our cinnabar is hand-selected, hand-polished, and hand-assembled by artisans who treat each bead as a small ritual." },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    {
      "type": "header",
      "content": "Navigation Links"
    },
    {
      "type": "url",
      "id": "all_link",
      "label": "All Link",
      "default": "/collections/all"
    },
    {
      "type": "url",
      "id": "conventional_link",
      "label": "Conventional Collection Link"
    },
    {
      "type": "url",
      "id": "customized_link",
      "label": "Customized Collection Link"
    }
  ]
}
{% endschema %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap');

.all-products {
  background: #FAF6F0;
  min-height: 80vh;
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
}

/* Collection Hero - 左右布局 */
.collection-hero {
  padding: 60px 0 50px;
  background: #FAF6F0;
}

.collection-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.collection-hero-text {
  padding-right: 20px;
}

.sec-eyebrow {
  font-size: 12px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #C9A24B;
  margin-bottom: 20px;
  font-weight: 500;
}

.collection-hero-title {
  font-size: 48px;
  font-weight: 500;
  line-height: 1.2;
  color: #2A1F1A;
  margin-bottom: 0;
}

.collection-hero-title .cn-title {
  display: block;
  font-size: 24px;
  font-weight: 400;
  letter-spacing: 0.3em;
  color: #9E2B25;
  margin-top: 10px;
  font-family: 'Noto Serif SC', serif;
}

.hero-divider {
  width: 50px;
  height: 2px;
  background: #C9A24B;
  margin: 25px 0;
}

.collection-hero-desc {
  font-size: 16px;
  line-height: 1.8;
  color: #5A4A42;
  margin: 0;
  font-weight: 300;
}

.collection-hero-img {
  aspect-ratio: 4/3;
  overflow: hidden;
}

.collection-hero-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.all-products .container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px 80px;
}

/* 工具栏 */
.collection-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
  padding: 20px 0;
  border-top: 1px solid #E0D5C8;
  border-bottom: 1px solid #E0D5C8;
  flex-wrap: wrap;
  gap: 20px;
}

.product-count {
  font-size: 13px;
  color: #8A7A72;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* 快捷筛选标签 */
.filter-tags {
  display: flex;
  gap: 25px;
}

.filter-tag {
  font-size: 13px;
  color: #8A7A72;
  text-decoration: none;
  letter-spacing: 0.05em;
  padding: 5px 0;
  border-bottom: 1px solid transparent;
  transition: all 0.3s;
  cursor: pointer;
}

.filter-tag:hover,
.filter-tag.active {
  color: #9E2B25;
  border-bottom-color: #9E2B25;
}

.toolbar-note {
  font-size: 13px;
  color: #9E2B25;
  letter-spacing: 0.1em;
  font-style: italic;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.product-card {
  background: transparent;
  overflow: hidden;
  transition: transform 0.3s;
}

.product-card:hover {
  transform: translateY(-4px);
}

.product-image {
  position: relative;
  aspect-ratio: 4/5;
  overflow: hidden;
  background: #F4EDE2;
  margin-bottom: 18px;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-card:hover .product-image img {
  transform: scale(1.05);
}

.placeholder-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C9B8A8;
  font-size: 14px;
}

/* Hover遮罩 */
.quick-view-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(42, 31, 26, 0.9), transparent);
  padding: 30px 20px 20px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.product-card:hover .quick-view-overlay {
  opacity: 1;
}

.quick-view-btn {
  display: block;
  text-align: center;
  color: white;
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.product-info {
  text-align: center;
}

.product-title {
  font-size: 15px;
  font-weight: 500;
  color: #2A1F1A;
  margin-bottom: 8px;
  line-height: 1.4;
}

.product-title a {
  color: inherit;
  text-decoration: none;
}

.product-price-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.product-price {
  font-size: 15px;
  color: #9E2B25;
  font-weight: 600;
}

.product-compare-price {
  font-size: 13px;
  color: #999;
  text-decoration: line-through;
}

/* 分页 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 15px;
  margin-top: 60px;
}

.page-link {
  padding: 10px 20px;
  border: 1px solid #E0D5C8;
  color: #5A4A42;
  text-decoration: none;
  font-size: 13px;
  transition: all 0.3s;
  cursor: pointer;
  letter-spacing: 0.05em;
}

.page-link:hover {
  background: #9E2B25;
  color: white;
  border-color: #9E2B25;
}

.page-numbers {
  display: flex;
  gap: 8px;
}

.page-number {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #E0D5C8;
  color: #5A4A42;
  text-decoration: none;
  font-size: 14px;
  transition: all 0.3s;
  cursor: pointer;
}

.page-number:hover {
  background: #F4EDE2;
}

.page-number.current {
  background: #9E2B25;
  color: white;
  border-color: #9E2B25;
}

@media (max-width: 1024px) {
  .products-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .collection-hero-title {
    font-size: 38px;
  }
}

@media (max-width: 768px) {
  .collection-hero-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .collection-hero-text {
    padding-right: 0;
  }
  .collection-hero-title {
    font-size: 32px;
  }
  .collection-hero-title .cn-title {
    font-size: 20px;
  }
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .collection-toolbar {
    flex-direction: column;
    align-items: flex-start;
    padding: 15px 0;
  }
  .pagination {
    flex-wrap: wrap;
    gap: 10px;
  }
}

@media (max-width: 480px) {
  .products-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const productsPerPage = 9;
  const productCards = Array.from(document.querySelectorAll('#productsGrid .product-card'));
  const pagination = document.getElementById('pagination');
  
  let currentPage = 1;

  function showPage(page) {
    const totalPages = Math.ceil(productCards.length / productsPerPage);
    currentPage = Math.min(page, totalPages);
    
    const start = (currentPage - 1) * productsPerPage;
    const end = start + productsPerPage;
    
    // 先隐藏所有产品
    productCards.forEach(card => card.style.display = 'none');
    
    // 显示当前页的产品
    productCards.forEach((card, index) => {
      if (index >= start && index < end) {
        card.style.display = 'block';
      }
    });
    
    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    if (totalPages <= 1) {
      pagination.innerHTML = '';
      return;
    }

    let html = '';
    
    if (currentPage > 1) {
      html += `<a class="page-link prev" data-page="${currentPage - 1}">‹ Previous</a>`;
    }
    
    html += '<div class="page-numbers">';
    for (let i = 1; i <= totalPages; i++) {
      if (i === currentPage) {
        html += `<span class="page-number current">${i}</span>`;
      } else {
        html += `<a class="page-number" data-page="${i}">${i}</a>`;
      }
    }
    html += '</div>';
    
    if (currentPage < totalPages) {
      html += `<a class="page-link next" data-page="${currentPage + 1}">Next ›</a>`;
    }
    
    pagination.innerHTML = html;
    
    pagination.querySelectorAll('[data-page]').forEach(el => {
      el.addEventListener('click', function() {
        showPage(parseInt(this.dataset.page));
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  // 初始化
  showPage(1);
});
</script>
