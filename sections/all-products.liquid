<section class="all-products">
  <div class="container">
    <!-- 页面标题 -->
    <div class="page-header text-center">
      <h1>{{ section.settings.heading }}</h1>
      <p class="subtitle">{{ section.settings.subheading }}</p>
    </div>

    <!-- 产品网格 -->
    <div class="products-grid">
      {% for block in section.blocks %}
        <div class="product-card">
          <div class="product-image">
            {% if block.settings.image != blank %}
              <a href="{{ block.settings.link }}">
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}">
              </a>
            {% else %}
              <a href="{{ block.settings.link }}">
                <div class="placeholder-img">Product Image</div>
              </a>
            {% endif %}
          </div>
          <div class="product-info">
            <h3 class="product-title"><a href="{{ block.settings.link }}">{{ block.settings.title }}</a></h3>
            <p class="product-price">{{ block.settings.price }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "All Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Page Subheading",
      "default": "Discover our handcrafted cinnabar pieces"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Product Name"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$0.00"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "default": {
    "blocks": [
      { "type": "product", "settings": { "title": "Cinnabar Bracelet", "price": "$168.00" } },
      { "type": "product", "settings": { "title": "Cloisonné Bracelet", "price": "$178.00" } },
      { "type": "product", "settings": { "title": "Gold Gourd Charm", "price": "$188.00" } },
      { "type": "product", "settings": { "title": "Custom Design", "price": "$208.00" } }
    ]
  }
}
{% endschema %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap');

.all-products {
  padding: 80px 0;
  background: #FAF6F0;
  min-height: 80vh;
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
}

.all-products .container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.all-products .page-header {
  text-align: center;
  margin-bottom: 60px;
}

.all-products .page-header h1 {
  font-size: 42px;
  font-weight: 500;
  margin-bottom: 15px;
  color: #2A1F1A;
  letter-spacing: 0.02em;
}

.all-products .page-header .subtitle {
  color: #8A7A72;
  font-size: 16px;
  font-weight: 400;
  letter-spacing: 0.05em;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.product-card {
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
}

.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 40px rgba(158, 43, 37, 0.12);
}

.product-image {
  aspect-ratio: 4/5;
  overflow: hidden;
  background: #F4EDE2;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
}

.product-card:hover .product-image img {
  transform: scale(1.05);
}

.placeholder-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C9B8A8;
  font-size: 14px;
}

.product-info {
  padding: 20px;
  text-align: center;
}

.product-title {
  font-size: 15px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 8px;
  line-height: 1.4;
}

.product-title a {
  color: inherit;
  text-decoration: none;
}

.product-price {
  font-size: 14px;
  color: #9E2B25;
  font-weight: 500;
}

@media (max-width: 1024px) {
  .products-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 768px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .all-products .page-header h1 {
    font-size: 32px;
  }
}

@media (max-width: 480px) {
  .products-grid {
    grid-template-columns: 1fr;
  }
}
</style>
