<section class="all-products">
  <!-- Hero区域 -->
  <div class="hero-banner">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>{{ section.settings.heading }}</h1>
      <p class="subtitle">{{ section.settings.subheading }}</p>
    </div>
  </div>

  <div class="container">
    <!-- 产品网格 -->
    <div class="products-grid" id="productsGrid">
      {% assign all_products = collections.all.products %}
      {% for product in all_products %}
        <div class="product-card">
          <div class="product-image">
            <a href="{{ product.url }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
              {% else %}
                <div class="placeholder-img">No Image</div>
              {% endif %}
            </a>
            <!-- 产品标签 -->
            {% if product.tags.size > 0 %}
              <div class="product-badges">
                {% for tag in product.tags limit: 1 %}
                  <span class="badge">{{ tag }}</span>
                {% endfor %}
              </div>
            {% endif %}
            <!-- Hover时的快速查看按钮 -->
            <div class="quick-view">
              <a href="{{ product.url }}" class="quick-view-btn">View Details</a>
            </div>
          </div>
          <div class="product-info">
            <h3 class="product-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="product-price">{{ product.price | money }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- 分页 -->
    <div class="pagination" id="pagination"></div>
  </div>
</section>

{% schema %}
{
  "name": "All Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Page Subheading",
      "default": "Discover the Ancient Power of Cinnabar"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Banner Image"
    }
  ]
}
{% endschema %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap');

.all-products {
  background: #FAF6F0;
  min-height: 80vh;
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
}

/* Hero区域 */
.hero-banner {
  position: relative;
  height: 400px;
  background: #2A1F1A;
  background-image: linear-gradient(rgba(42, 31, 26, 0.7), rgba(42, 31, 26, 0.7)), url('{{ section.settings.hero_image | image_url: width: 1600 }}');
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60px;
}

.hero-content {
  text-align: center;
  color: white;
  z-index: 1;
}

.hero-content h1 {
  font-size: 48px;
  font-weight: 500;
  margin-bottom: 15px;
  letter-spacing: 0.05em;
}

.hero-content .subtitle {
  font-size: 18px;
  font-weight: 300;
  letter-spacing: 0.1em;
  opacity: 0.9;
}

.all-products .container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px 80px;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.product-card {
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
}

.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 40px rgba(158, 43, 37, 0.12);
}

.product-image {
  position: relative;
  aspect-ratio: 4/5;
  overflow: hidden;
  background: #F4EDE2;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
}

.product-card:hover .product-image img {
  transform: scale(1.05);
}

.placeholder-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C9B8A8;
  font-size: 14px;
}

/* 产品标签 */
.product-badges {
  position: absolute;
  top: 15px;
  left: 15px;
  z-index: 2;
}

.badge {
  display: inline-block;
  padding: 4px 12px;
  background: #9E2B25;
  color: white;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.05em;
  border-radius: 2px;
  text-transform: uppercase;
}

/* 快速查看按钮 */
.quick-view {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(42, 31, 26, 0.9);
  padding: 15px;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.product-card:hover .quick-view {
  transform: translateY(0);
}

.quick-view-btn {
  display: block;
  text-align: center;
  color: white;
  text-decoration: none;
  font-size: 13px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.product-info {
  padding: 20px;
  text-align: center;
}

.product-title {
  font-size: 15px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 8px;
  line-height: 1.4;
}

.product-title a {
  color: inherit;
  text-decoration: none;
}

.product-price {
  font-size: 14px;
  color: #9E2B25;
  font-weight: 500;
}

/* 分页 */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-top: 60px;
}

.page-link {
  padding: 10px 20px;
  border: 1px solid #E8E0D5;
  color: #5A4A42;
  text-decoration: none;
  font-size: 14px;
  transition: all 0.3s;
  cursor: pointer;
}

.page-link:hover {
  background: #9E2B25;
  color: white;
  border-color: #9E2B25;
}

.page-numbers {
  display: flex;
  gap: 8px;
}

.page-number {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #E8E0D5;
  color: #5A4A42;
  text-decoration: none;
  font-size: 14px;
  transition: all 0.3s;
  cursor: pointer;
}

.page-number:hover {
  background: #F4EDE2;
}

.page-number.current {
  background: #9E2B25;
  color: white;
  border-color: #9E2B25;
}

@media (max-width: 1024px) {
  .products-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .hero-content h1 {
    font-size: 36px;
  }
}

@media (max-width: 768px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .hero-banner {
    height: 300px;
  }
  .hero-content h1 {
    font-size: 28px;
  }
  .hero-content .subtitle {
    font-size: 14px;
  }
  .pagination {
    flex-wrap: wrap;
    gap: 10px;
  }
}

@media (max-width: 480px) {
  .products-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const productsPerPage = 8;
  const productCards = document.querySelectorAll('#productsGrid .product-card');
  const pagination = document.getElementById('pagination');
  const totalPages = Math.ceil(productCards.length / productsPerPage);
  let currentPage = 1;

  function showPage(page) {
    currentPage = page;
    const start = (page - 1) * productsPerPage;
    const end = start + productsPerPage;
    
    productCards.forEach((card, index) => {
      if (index >= start && index < end) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
    
    renderPagination();
  }

  function renderPagination() {
    if (totalPages <= 1) {
      pagination.innerHTML = '';
      return;
    }

    let html = '';
    
    // 上一页
    if (currentPage > 1) {
      html += `<a class="page-link prev" data-page="${currentPage - 1}">‹ Previous</a>`;
    }
    
    // 页码
    html += '<div class="page-numbers">';
    for (let i = 1; i <= totalPages; i++) {
      if (i === currentPage) {
        html += `<span class="page-number current">${i}</span>`;
      } else {
        html += `<a class="page-number" data-page="${i}">${i}</a>`;
      }
    }
    html += '</div>';
    
    // 下一页
    if (currentPage < totalPages) {
      html += `<a class="page-link next" data-page="${currentPage + 1}">Next ›</a>`;
    }
    
    pagination.innerHTML = html;
    
    // 绑定点击事件
    pagination.querySelectorAll('[data-page]').forEach(el => {
      el.addEventListener('click', function() {
        showPage(parseInt(this.dataset.page));
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  // 初始化
  showPage(1);
});
</script>
