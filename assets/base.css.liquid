:root{
  --cinnabar:#9E2B25;
  --cinnabar-deep:#7A1F1A;
  --gold:#C9A24B;
  --gold-light:#E0C88A;
  --ivory:#FAF6F0;
  --paper:#F4EDE2;
  --ink:#2A1F1A;
  --ink-soft:#5C4A42;
  --line:#E2D8C8;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'Inter','Noto Serif SC',sans-serif;
  background:var(--ivory);
  color:var(--ink);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
.container{max-width:1280px;margin:0 auto;padding:0 32px}
.serif{font-family:'Cormorant Garamond','Noto Serif SC',serif}

/* ===== Top bar ===== */
.announcement-bar{
  background:var(--cinnabar-deep);
  color:#F4E4D0;
  text-align:center;
  padding:9px 16px;
  font-size:12.5px;
  letter-spacing:1.2px;
}
.announcement-bar b{color:var(--gold-light);font-weight:600;letter-spacing:1.5px}

/* ===== Header ===== */
.site-header{
  background:var(--ivory);
  border-bottom:1px solid var(--line);
  position:-webkit-sticky;position:sticky;top:0;z-index:1000;
  transition:box-shadow .3s ease, background .3s ease;
  width:100%;
}
.site-header.is-scrolled{
  box-shadow:0 2px 20px rgba(42,31,26,.08);
  background:rgba(250,246,240,.96);
  backdrop-filter:saturate(180%) blur(12px);
}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:72px}
.logo{
  font-family:'Cormorant Garamond','Noto Serif SC',serif;
  font-size:26px;font-weight:600;letter-spacing:6px;color:var(--cinnabar);
}
.logo span{color:var(--gold)}
.nav-links{display:flex;gap:38px;list-style:none}
.nav-links a{
  font-size:13px;letter-spacing:2px;font-weight:500;
  color:var(--ink);text-transform:uppercase;transition:color .2s;
}
.nav-links a:hover{color:var(--cinnabar)}
.header-icons{display:flex;gap:20px;align-items:center}
.header-icons svg{width:20px;height:20px;stroke:var(--ink);fill:none;stroke-width:1.5;cursor:pointer}
.menu-toggle{display:none;background:none;border:none;cursor:pointer;padding:4px}
.menu-toggle svg{width:24px;height:24px}
.cart-count{
  position:relative;
}
.cart-count::after{
  content:attr(data-count);position:absolute;top:-6px;right:-8px;
  background:var(--cinnabar);color:#fff;font-size:10px;min-width:15px;height:15px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;font-weight:600;
}
@media(max-width:820px){
  .nav-links{
    display:none;position:fixed;top:0;right:0;bottom:0;width:280px;
    background:var(--ivory);flex-direction:column;gap:0;padding:90px 32px 32px;
    box-shadow:-4px 0 24px rgba(0,0,0,.1);z-index:1001;
    transition:transform .3s ease;transform:translateX(100%);
  }
  .nav-links.is-open{display:flex;transform:translateX(0)}
  .nav-links li{padding:14px 0;border-bottom:1px solid var(--line)}
  .menu-toggle{display:block}
}
@media(min-width:821px){.menu-toggle{display:none}}
.nav-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:1000}
.nav-overlay.is-open{display:block}

/* ===== Hero ===== */
.hero{
  position:relative;
  background:
    radial-gradient(ellipse at 75% 30%, rgba(201,162,75,.18) 0%, transparent 55%),
    linear-gradient(135deg, #6B1A15 0%, var(--cinnabar-deep) 45%, #4A0F0C 100%);
  color:#F4E4D0;overflow:hidden;min-height:640px;display:flex;align-items:center;
}
.hero-inner{
  display:grid;grid-template-columns:1.1fr .9fr;gap:40px;
  align-items:center;width:100%;position:relative;z-index:2;
}
.hero-eyebrow{font-size:13px;letter-spacing:5px;color:var(--gold-light);text-transform:uppercase;margin-bottom:24px;font-weight:500}
.hero h1{
  font-family:'Cormorant Garamond','Noto Serif SC',serif;
  font-size:clamp(48px,7vw,92px);line-height:1.02;font-weight:500;color:#FBF3E4;margin-bottom:8px;
}
.hero h1 .cn{display:block;font-size:.45em;letter-spacing:18px;color:var(--gold-light);font-weight:400;margin-top:12px}
.hero p.lead{font-size:17px;line-height:1.8;max-width:480px;color:#E8D4BC;margin:28px 0 36px;font-weight:300}
.btn-row{display:flex;gap:16px;flex-wrap:wrap}
.btn{
  display:inline-block;padding:16px 40px;font-size:13px;letter-spacing:3px;
  text-transform:uppercase;font-weight:500;cursor:pointer;transition:all .25s;border:1px solid var(--gold);
}
.btn-gold{background:var(--gold);color:#3A1410;border-color:var(--gold)}
.btn-gold:hover{background:var(--gold-light);border-color:var(--gold-light)}
.btn-ghost{background:transparent;color:#F4E4D0}
.btn-ghost:hover{background:rgba(201,162,75,.15)}
.hero-visual{position:relative;display:flex;justify-content:center;align-items:center}
.hero-circle{
  width:420px;height:420px;border-radius:50%;
  background:radial-gradient(circle, rgba(201,162,75,.25) 0%, transparent 70%);
  display:flex;align-items:center;justify-content:center;position:relative;
}
.hero-product{width:88%;border-radius:50%;box-shadow:0 30px 80px rgba(0,0,0,.5)}
@media(max-width:900px){
  .hero-inner{grid-template-columns:1fr;text-align:center}
  .hero p.lead{margin-left:auto;margin-right:auto}
  .btn-row{justify-content:center}
  .hero-circle{width:320px;height:320px;margin:20px auto 0}
}

/* ===== Trust bar ===== */
.trust{background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.trust-inner{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:28px 0;text-align:center}
.trust-item .t-title{font-family:'Cormorant Garamond',serif;font-size:17px;font-weight:600;color:var(--cinnabar);margin-bottom:4px;letter-spacing:1px}
.trust-item .t-sub{font-size:12.5px;color:var(--ink-soft);letter-spacing:.5px}
@media(max-width:700px){.trust-inner{grid-template-columns:repeat(2,1fr);gap:24px}}

/* ===== Section base ===== */
section{padding:100px 0}
.sec-eyebrow{font-size:12px;letter-spacing:5px;color:var(--gold);text-transform:uppercase;font-weight:600;margin-bottom:18px}
.sec-title{
  font-family:'Cormorant Garamond','Noto Serif SC',serif;
  font-size:clamp(32px,4vw,52px);font-weight:500;line-height:1.15;color:var(--ink);margin-bottom:20px;
}
.sec-title .cn{display:block;font-size:.55em;letter-spacing:12px;color:var(--cinnabar);margin-top:10px;font-weight:400}
.sec-lead{font-size:16px;color:var(--ink-soft);max-width:620px;line-height:1.8;font-weight:300}

/* ===== Origin ===== */
.origin-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.origin-img{position:relative;border-radius:2px;overflow:hidden}
.origin-img img{width:100%;height:560px;object-fit:cover}
.origin-quote{
  font-family:'Cormorant Garamond','Noto Serif SC',serif;
  font-size:24px;font-style:italic;line-height:1.6;color:var(--cinnabar);
  margin:28px 0;padding-left:24px;border-left:2px solid var(--gold);
}
.origin-stats{display:flex;gap:48px;margin-top:40px;flex-wrap:wrap}
.ostat .n{font-family:'Cormorant Garamond',serif;font-size:44px;color:var(--cinnabar);font-weight:600;line-height:1}
.ostat .l{font-size:12px;letter-spacing:2px;color:var(--ink-soft);margin-top:6px;text-transform:uppercase}
@media(max-width:900px){.origin-grid{grid-template-columns:1fr}.origin-img img{height:380px}}

/* ===== Collections ===== */
.collections{background:var(--paper)}
.coll-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px}
.coll-card{position:relative;overflow:hidden;cursor:pointer;background:#fff;display:block}
.coll-card img{width:100%;height:380px;object-fit:cover;transition:transform .8s ease}
.coll-card:hover img{transform:scale(1.05)}
.coll-overlay{
  position:absolute;inset:0;
  background:linear-gradient(to top, rgba(42,31,26,.85) 0%, transparent 55%);
  display:flex;flex-direction:column;justify-content:flex-end;padding:32px;
}
.coll-overlay h3{font-family:'Cormorant Garamond','Noto Serif SC',serif;color:#FBF3E4;font-size:28px;font-weight:500}
.coll-overlay .cn{color:var(--gold-light);font-size:14px;letter-spacing:4px;margin-top:4px}
.coll-overlay .shop{margin-top:14px;font-size:12px;letter-spacing:3px;color:#FBF3E4;text-transform:uppercase;border-bottom:1px solid var(--gold);align-self:flex-start;padding-bottom:3px}
@media(max-width:900px){.coll-grid{grid-template-columns:1fr}}

/* ===== Product grid ===== */
.prod-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px 24px;margin-top:56px}
.pcard{background:#fff;transition:transform .3s, box-shadow .3s;cursor:pointer}
.pcard:hover{transform:translateY(-4px);box-shadow:0 20px 50px rgba(158,43,37,.12)}
.pcard-img{position:relative;overflow:hidden;background:var(--ivory)}
.pcard-img img{width:100%;aspect-ratio:1/1;object-fit:cover;transition:transform .8s}
.pcard:hover .pcard-img img{transform:scale(1.06)}
.pcard-badge{position:absolute;top:16px;left:16px;background:var(--cinnabar);color:#FBF3E4;font-size:10.5px;letter-spacing:2px;padding:5px 12px;text-transform:uppercase;font-weight:500}
.pcard-body{padding:22px 18px 26px;text-align:center}
.pcard-cat{font-size:11px;letter-spacing:3px;color:var(--gold);text-transform:uppercase;margin-bottom:8px}
.pcard-name{font-family:'Cormorant Garamond','Noto Serif SC',serif;font-size:21px;font-weight:600;color:var(--ink);margin-bottom:4px}
.pcard-cn{font-size:13px;color:var(--ink-soft);letter-spacing:3px;margin-bottom:14px}
.pcard-price{font-size:16px;color:var(--ink);font-weight:500}
.pcard-price .old{color:#B8A89A;text-decoration:line-through;margin-left:10px;font-size:14px;font-weight:400}
.pcard-pay{font-size:11.5px;color:var(--ink-soft);margin-top:6px;letter-spacing:.5px}
@media(max-width:900px){.prod-grid{grid-template-columns:repeat(2,1fr);gap:24px 16px}}
@media(max-width:560px){.prod-grid{grid-template-columns:1fr}}

/* ===== Featured banner ===== */
.featured{background:linear-gradient(115deg, rgba(74,15,12,.92) 0%, rgba(122,31,26,.88) 60%, rgba(158,43,37,.85) 100%), url('{{ "p02.jpg" | asset_url }}') center/cover;color:#FBF3E4}
.feat-inner{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.feat-tag{display:inline-block;border:1px solid var(--gold);color:var(--gold-light);padding:6px 18px;font-size:11px;letter-spacing:3px;text-transform:uppercase;margin-bottom:24px}
.feat h2{font-family:'Cormorant Garamond','Noto Serif SC',serif;font-size:clamp(36px,4.5vw,56px);font-weight:500;line-height:1.15;margin-bottom:24px}
.feat h2 .cn{display:block;color:var(--gold-light);font-size:.5em;letter-spacing:10px;margin-top:10px}
.feat p{color:#E8D4BC;font-size:16px;line-height:1.85;max-width:520px;font-weight:300;margin-bottom:32px}
.feat-price{font-family:'Cormorant Garamond',serif;font-size:36px;color:var(--gold-light);margin-bottom:28px;font-weight:500}
.feat-price .old{font-size:20px;color:#B89878;text-decoration:line-through;margin-left:14px}
@media(max-width:900px){.feat-inner{grid-template-columns:1fr;text-align:center}.feat p{margin-left:auto;margin-right:auto}.feat .btn-row{justify-content:center}}

/* ===== Packaging ===== */
.pack-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.pack-img{border-radius:2px;overflow:hidden;box-shadow:0 30px 70px rgba(42,31,26,.15)}
.pack-list{margin-top:32px;display:grid;gap:18px;list-style:none}
.pack-list .dot{width:8px;height:8px;background:var(--cinnabar);border-radius:50%;margin-top:8px;flex-shrink:0}
.pack-list li{display:flex;gap:14px;align-items:flex-start;font-size:15px;color:var(--ink-soft)}
.pack-list b{color:var(--ink);font-weight:600}
@media(max-width:900px){.pack-grid{grid-template-columns:1fr}}

/* ===== Craft ===== */
.craft{background:linear-gradient(180deg, var(--cinnabar-deep) 0%, #4A0F0C 100%);color:#F4E4D0}
.craft .sec-title{color:#FBF3E4}
.craft .sec-lead{color:#D8BFA5}
.craft-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:60px}
.craft-card{border-top:1px solid rgba(201,162,75,.4);padding-top:32px}
.craft-card .num{font-family:'Cormorant Garamond',serif;font-size:14px;color:var(--gold-light);letter-spacing:4px;margin-bottom:16px}
.craft-card h3{font-family:'Cormorant Garamond','Noto Serif SC',serif;font-size:26px;font-weight:500;margin-bottom:14px;color:#FBF3E4}
.craft-card p{font-size:14.5px;line-height:1.8;color:#D8BFA5;font-weight:300}
@media(max-width:900px){.craft-grid{grid-template-columns:1fr}}

/* ===== Newsletter ===== */
.newsletter{background:var(--paper);text-align:center}
.newsletter h2{font-family:'Cormorant Garamond','Noto Serif SC',serif;font-size:clamp(30px,3.5vw,44px);font-weight:500;margin-bottom:14px}
.newsletter h2 .cn{color:var(--cinnabar);font-size:.6em;letter-spacing:10px;display:block;margin-top:8px}
.newsletter p{color:var(--ink-soft);max-width:520px;margin:0 auto 36px;font-weight:300}
.nl-form{display:flex;max-width:520px;margin:0 auto;border:1px solid var(--ink)}
.nl-form input{flex:1;padding:16px 20px;border:none;background:transparent;font-size:14px;outline:none;color:var(--ink)}
.nl-form button{background:var(--cinnabar);color:#FBF3E4;border:none;padding:0 32px;font-size:12px;letter-spacing:3px;text-transform:uppercase;cursor:pointer}
.nl-note{font-size:12px;color:var(--ink-soft);margin-top:16px}

/* ===== Footer ===== */
.site-footer{background:#2A1F1A;color:#C9B8A8;padding:70px 0 30px}
.foot-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;margin-bottom:50px}
.foot-brand .logo{color:var(--gold-light);font-size:24px}
.foot-brand p{font-size:13.5px;line-height:1.8;margin-top:18px;max-width:320px;color:#9E8B7E}
.foot-col h4{font-size:12px;letter-spacing:3px;color:#FBF3E4;text-transform:uppercase;margin-bottom:20px;font-weight:600}
.foot-col ul{list-style:none}
.foot-col li{margin-bottom:12px}
.foot-col a{font-size:13.5px;color:#9E8B7E}
.foot-bottom{border-top:1px solid rgba(201,162,75,.15);padding-top:28px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;font-size:12px;color:#7A6860}
@media(max-width:800px){.foot-grid{grid-template-columns:1fr 1fr}}
@media(max-width:500px){.foot-grid{grid-template-columns:1fr}}
