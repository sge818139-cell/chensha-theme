{% layout 'theme' %}
<section class="article-page">
  <div class="container narrow">
    <div class="sec-head center">
      <div class="sec-eyebrow">CHENSHA JOURNAL</div>
      <h1 class="sec-title">{{ article.title }}</h1>
      <p class="sec-sub">{{ article.published_at | date: '%B %d, %Y' }}</p>
    </div>
    {% if article.image %}
      <div class="article-img">
        <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}">
      </div>
    {% endif %}
    <div class="article-content">
      {{ article.content }}
    </div>
    <div class="article-nav">
      <a href="{{ routes.blog_url }}" class="journal-more">← Back to Journal</a>
    </div>
  </div>
</section>
