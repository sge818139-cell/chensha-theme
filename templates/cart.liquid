{% layout 'theme' %}

<section class="cart-section">
  <div class="container">
    <h1 class="cart-title">Your Cart</h1>
    
    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        <p>Your cart is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-gold">Continue Shopping</a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" class="cart-form">
        <div class="cart-items">
          {% for item in cart.items %}
          <div class="cart-item">
            <div class="cart-item-img">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.product.title | escape }}">
              {% else %}
                <div class="cart-item-placeholder">No Image</div>
              {% endif %}
            </div>
            <div class="cart-item-details">
              <h3 class="cart-item-title">{{ item.product.title }}</h3>
              <div class="cart-item-variant">
                {% for option in item.product.options_with_values %}
                  {{ option.name }}: {{ item.variant.options[forloop.index0] }}
                {% endfor %}
              </div>
              <div class="cart-item-price">{{ item.final_price | money }} each</div>
            </div>
            <div class="cart-item-qty">
              <div class="qty-control">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-line="{{ forloop.index }}">
              </div>
            </div>
            <div class="cart-item-total">
              <div class="cart-item-line-price">{{ item.final_line_price | money }}</div>
              <button type="submit" name="updates[]" value="0" class="cart-remove" data-line="{{ forloop.index }}">
                Remove
              </button>
            </div>
          </div>
          {% endfor %}
        </div>

        <div class="cart-summary">
          <div class="cart-subtotal">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-shipping-note">Shipping & taxes calculated at checkout.</p>
          <button type="submit" name="checkout" class="btn btn-gold btn-checkout">Check Out</button>
        </div>
      </form>
    {% endif %}
  </div>
</section>

<style>
.cart-section {
  padding: 80px 0;
  min-height: 60vh;
}

.cart-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 42px;
  font-weight: 400;
  color: #2A1F1A;
  margin-bottom: 40px;
  text-align: center;
}

.cart-empty {
  text-align: center;
  padding: 80px 0;
  color: #8A7A72;
  font-size: 18px;
}

.cart-empty p {
  margin-bottom: 30px;
}

.cart-form {
  max-width: 900px;
  margin: 0 auto;
}

.cart-items {
  border-top: 1px solid #E8E0D5;
}

.cart-item {
  display: grid;
  grid-template-columns: 100px 1fr 120px 150px;
  gap: 30px;
  align-items: center;
  padding: 25px 0;
  border-bottom: 1px solid #E8E0D5;
}

.cart-item-img {
  width: 100px;
  height: 100px;
  border-radius: 6px;
  overflow: hidden;
  background: #FAF6F0;
}

.cart-item-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cart-item-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8A7A72;
  font-size: 12px;
}

.cart-item-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px;
  font-weight: 600;
  color: #2A1F1A;
  margin-bottom: 8px;
}

.cart-item-variant {
  font-size: 14px;
  color: #8A7A72;
  margin-bottom: 8px;
}

.cart-item-price {
  font-size: 14px;
  color: #8A7A72;
}

.qty-control input {
  width: 70px;
  padding: 10px;
  border: 1px solid #E8E0D5;
  text-align: center;
  font-size: 16px;
  color: #2A1F1A;
  background: #fff;
}

.cart-item-total {
  text-align: right;
}

.cart-item-line-price {
  font-size: 18px;
  font-weight: 600;
  color: #2A1F1A;
  margin-bottom: 8px;
}

.cart-remove {
  background: none;
  border: none;
  color: #9E2B25;
  font-size: 13px;
  cursor: pointer;
  text-decoration: underline;
  padding: 0;
}

.cart-remove:hover {
  color: #7A1F1A;
}

.cart-summary {
  margin-top: 40px;
  padding-top: 30px;
  border-top: 1px solid #E8E0D5;
  max-width: 400px;
  margin-left: auto;
}

.cart-subtotal {
  display: flex;
  justify-content: space-between;
  font-size: 20px;
  font-weight: 600;
  color: #2A1F1A;
  margin-bottom: 10px;
}

.cart-shipping-note {
  font-size: 14px;
  color: #8A7A72;
  margin-bottom: 25px;
}

.btn-checkout {
  width: 100%;
  padding: 16px;
  font-size: 15px;
  letter-spacing: 1px;
}

@media (max-width: 768px) {
  .cart-item {
    grid-template-columns: 80px 1fr;
    gap: 15px;
  }
  
  .cart-item-qty {
    grid-column: 2;
  }
  
  .cart-item-total {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-update cart when quantity changes
  var qtyInputs = document.querySelectorAll('.qty-control input');
  var form = document.querySelector('.cart-form');
  
  qtyInputs.forEach(function(input) {
    input.addEventListener('change', function() {
      form.submit();
    });
  });
});
</script>
