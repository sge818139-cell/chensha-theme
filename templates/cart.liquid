{% layout 'theme' %}

<section class="cart-section">
  <div class="container">
    <h1 class="cart-title">Your Cart</h1>
    
    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        <p>Your cart is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-gold">Continue Shopping</a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" class="cart-form">
        <div class="cart-items">
          {% for item in cart.items %}
          <div class="cart-item">
            <div class="cart-item-img">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.product.title | escape }}">
              {% else %}
                <div class="cart-item-placeholder">No Image</div>
              {% endif %}
            </div>
            <div class="cart-item-details">
              <h3 class="cart-item-title">{{ item.product.title }}</h3>
              <div class="cart-item-variant">
                {% for option in item.product.options_with_values %}
                  {% unless option.name == 'Title' or option.value == 'Default Title' %}
                    {{ option.name }}: {{ item.variant.options[forloop.index0] }}
                  {% endunless %}
                {% endfor %}
              </div>
              <button type="button" class="cart-remove" data-line="{{ forloop.index }}">
                Remove
              </button>
            </div>
            <div class="cart-item-qty">
              <button type="button" class="qty-btn qty-minus">−</button>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-line="{{ forloop.index }}">
              <button type="button" class="qty-btn qty-plus">+</button>
            </div>
            <div class="cart-item-line-price">{{ item.final_line_price | money }}</div>
          </div>
          {% endfor %}
        </div>

        <div class="cart-summary">
          <div class="cart-subtotal-row">
            <span class="cart-subtotal-label">Subtotal</span>
            <span class="cart-subtotal-price">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-shipping-note">Shipping & taxes calculated at checkout.</p>
          <button type="submit" name="checkout" class="btn btn-gold btn-checkout">Check Out</button>
          <a href="{{ routes.all_products_collection_url }}" class="continue-shopping-link">
            Continue Shopping →
          </a>
        </div>
      </form>
    {% endif %}
  </div>
</section>

<style>
.cart-section {
  padding: 100px 0;
  min-height: 70vh;
  background: #FAF8F4;
}

.cart-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 48px;
  font-weight: 300;
  color: #2A1F1A;
  margin-bottom: 60px;
  text-align: center;
  letter-spacing: 2px;
}

.cart-empty {
  text-align: center;
  padding: 100px 0;
  color: #8A7A72;
  font-size: 18px;
}

.cart-empty p {
  margin-bottom: 30px;
}

.cart-form {
  max-width: 800px;
  margin: 0 auto;
}

.cart-items {
  margin-bottom: 60px;
}

.cart-item {
  display: grid;
  grid-template-columns: 100px 1fr 150px 120px;
  gap: 30px;
  align-items: center;
  padding: 30px 0;
  border-bottom: 1px solid #E8E0D5;
}

.cart-item:first-child {
  border-top: 1px solid #E8E0D5;
}

.cart-item-img {
  width: 100px;
  height: 100px;
  overflow: hidden;
  background: #fff;
}

.cart-item-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cart-item-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8A7A72;
  font-size: 12px;
}

.cart-item-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px;
  font-weight: 500;
  color: #2A1F1A;
  margin-bottom: 8px;
  letter-spacing: 0.5px;
}

.cart-item-variant {
  font-size: 14px;
  color: #8A7A72;
  margin-bottom: 15px;
}

.cart-remove {
  background: none;
  border: none;
  color: #9E2B25;
  font-size: 13px;
  cursor: pointer;
  padding: 0;
  letter-spacing: 1px;
  text-transform: uppercase;
  transition: opacity 0.2s ease;
}

.cart-remove:hover {
  opacity: 0.7;
}

.cart-item-qty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-btn {
  background: none;
  border: none;
  width: 28px;
  height: 28px;
  font-size: 16px;
  color: #8A7A72;
  cursor: pointer;
  transition: all 0.2s ease;
}

.qty-btn:hover {
  color: #2A1F1A;
}

.qty-control input,
.cart-item-qty input {
  width: 40px;
  padding: 5px;
  border: none;
  text-align: center;
  font-size: 15px;
  color: #2A1F1A;
  background: transparent;
  -moz-appearance: textfield;
  appearance: textfield;
}

.cart-item-qty input::-webkit-outer-spin-button,
.cart-item-qty input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.cart-item-line-price {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px;
  font-weight: 500;
  color: #2A1F1A;
  text-align: right;
}

.cart-summary {
  padding-top: 40px;
  border-top: 1px solid #E8E0D5;
  max-width: 400px;
  margin-left: auto;
}

.cart-subtotal-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15px;
}

.cart-subtotal-label {
  font-size: 16px;
  color: #5A4A42;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.cart-subtotal-price {
  font-family: 'Cormorant Garamond', serif;
  font-size: 24px;
  font-weight: 500;
  color: #2A1F1A;
}

.cart-shipping-note {
  font-size: 14px;
  color: #8A7A72;
  margin-bottom: 30px;
  text-align: right;
}

.btn-checkout {
  width: 100%;
  padding: 18px;
  font-size: 14px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.continue-shopping-link {
  display: block;
  text-align: center;
  margin-top: 20px;
  font-size: 14px;
  color: #8A7A72;
  letter-spacing: 1px;
  text-decoration: none;
  transition: color 0.2s ease;
}

.continue-shopping-link:hover {
  color: #9E2B25;
}

@media (max-width: 768px) {
  .cart-item {
    grid-template-columns: 80px 1fr;
    gap: 20px;
  }
  
  .cart-item-qty {
    grid-column: 2;
  }
  
  .cart-item-line-price {
    grid-column: 1 / -1;
    text-align: left;
    margin-top: 10px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var form = document.querySelector('.cart-form');
  
  // Auto-update cart when quantity changes
  var qtyInputs = document.querySelectorAll('.cart-item-qty input');
  qtyInputs.forEach(function(input) {
    input.addEventListener('change', function() {
      form.submit();
    });
  });
  
  // Plus/minus buttons
  var minusBtns = document.querySelectorAll('.qty-minus');
  var plusBtns = document.querySelectorAll('.qty-plus');
  
  minusBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var input = this.parentElement.querySelector('input');
      input.value = Math.max(0, parseInt(input.value) - 1);
      input.dispatchEvent(new Event('change'));
    });
  });
  
  plusBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var input = this.parentElement.querySelector('input');
      input.value = parseInt(input.value) + 1;
      input.dispatchEvent(new Event('change'));
    });
  });
  
  // Remove item via AJAX
  var removeButtons = document.querySelectorAll('.cart-remove');
  removeButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.getAttribute('data-line');
      
      fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          line: line,
          quantity: 0
        })
      })
      .then(function(response) {
        return response.json();
      })
      .then(function(cart) {
        location.reload();
      });
    });
  });
});
</script>
