{% layout 'theme' %}

{% assign product = product | default: all_products['the-essence'] %}
{% unless product %}
  {% assign product = collections.all.products.first %}
{% endunless %}

<section class="pdp">
  <div class="container">
    {% section 'pdp-product-info-cinnabar' %}

    <!-- BRAND STORY SPLIT -->
    {% section 'pdp-brand-story-cinnabar' %}

    <!-- CUSTOMER REVIEWS -->
    {% section 'customer-reviews-cinnabar' %}

    <!-- YOU MAY ALSO LOVE -->
    {% section 'you-may-also-love' %}

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var form = document.getElementById('product-form');
  if (!form) return;
  
  var variants = {{ product.variants | json }};
  
  form.querySelectorAll('.pdp-value input').forEach(function(input) {
    input.addEventListener('change', function() {
      updateVariant();
    });
  });
  
  function updateVariant() {
    var selectedOptions = {};
    form.querySelectorAll('.pdp-option').forEach(function(option) {
      var label = option.querySelector('.pdp-option-label').textContent;
      var selected = option.querySelector('input:checked');
      if (selected) selectedOptions[label] = selected.value;
    });
    
    var matchingVariant = variants.find(function(v) {
      return JSON.stringify(v.options) === JSON.stringify(Object.values(selectedOptions));
    });
    
    if (matchingVariant) {
      form.querySelector('input[name="id"]').value = matchingVariant.id;
    }
  }
});
</script>
