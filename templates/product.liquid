{% layout 'theme' %}

{% assign product = product | default: all_products['the-essence'] %}
{% unless product %}
  {% assign product = collections.all.products.first %}
{% endunless %}

<section class="pdp">
  <div class="container">
    <div class="pdp-layout">

      <!-- LEFT: Gallery -->
      <div class="pdp-gallery">
        <div class="pdp-main">
          {% if product.featured_image %}
            <img id="pdpMainImg" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
          {% else %}
            <img src="{{ 'p01.jpg' | asset_url }}" alt="{{ product.title | escape }}">
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
        <div class="pdp-thumbs">
          {% for image in product.images %}
            <img src="{{ image | image_url: width: 150 }}" alt="{{ product.title | append: ' thumb' | escape }}"
                 class="pdp-thumb{% if forloop.first %} active{% endif %}"
                 onclick="var m=document.getElementById('pdpMainImg');m.src='{{ image | image_url: width: 1000 }}';document.querySelectorAll('.pdp-thumb').forEach(function(t){t.classList.remove('active')});this.classList.add('active')">
          {% endfor %}
        </div>
        {% endif %}
        <div class="pdp-packaging-img">
          <img src="{{ 'packaging.jpg' | asset_url }}" alt="CHENSHA gift packaging">
        </div>
      </div>

      <!-- RIGHT: Info -->
      <div class="pdp-info">
        {% if product.type %}<div class="pdp-eyebrow">{{ product.type }}</div>{% endif %}
        <h1 class="pdp-title">{{ product.title }}</h1>

        <div class="pdp-price-row">
          <span class="pdp-price">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="pdp-compare">{{ product.compare_at_price | money }}</span>
            <span class="pdp-sale-badge">SAVE {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span>
          {% endif %}
        </div>

        <div class="pdp-pay">or 4 interest-free payments of <strong>{{ product.price | money | remove: '$' | divided_by: 4 | round: 2 | prepend: '$' }}</strong> with Afterpay</div>

        <div class="pdp-rating-row">
          <span class="pdp-stars">★★★★★</span>
          <span class="pdp-rating-text">(No reviews yet)</span>
        </div>

        <div class="pdp-divider"></div>

        {% if product and product.available %}
        {% form 'product', product, id: 'product-form', class: 'product-form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {% unless product.variants.size == 1 %}
            <div class="pdp-variants">
              {% for option in product.options_with_values %}
                <div class="pdp-option">
                  <label class="pdp-option-label">{{ option.name }}</label>
                  <div class="pdp-option-values">
                    {% for value in option.values %}
                      <label class="pdp-value">
                        <input type="radio" name="options[{{ option.name }}]" value="{{ value }}" {% if forloop.first %}checked{% endif %}>
                        <span>{{ value }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <div class="pdp-qty-cart">
            <div class="pdp-qty">
              <button type="button" onclick="var i=this.nextElementSibling;i.value=Math.max(1,parseInt(i.value)-1)">−</button>
              <input type="number" name="quantity" value="1" min="1">
              <button type="button" onclick="var i=this.previousElementSibling;i.value=parseInt(i.value)+1">+</button>
            </div>
            <button type="submit" name="add" class="pdp-add-btn">Add to Cart</button>
          </div>
        {% endform %}
        {% else %}
          <div class="pdp-qty-cart">
            <div class="pdp-qty">
              <button type="button">−</button>
              <input type="number" value="1" min="1" readonly>
              <button type="button">+</button>
            </div>
            <button class="pdp-add-btn" disabled>Add to Cart</button>
          </div>
        {% endif %}

        <div class="pdp-guarantees">
          <div class="pdp-guarantee">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <div><strong>Free Worldwide Shipping</strong><span>On orders over $150</span></div>
          </div>
          <div class="pdp-guarantee">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
            <div><strong>30-Day Easy Returns</strong><span>Hassle-free returns & exchanges</span></div>
          </div>
          <div class="pdp-guarantee">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg>
            <div><strong>Authenticity Certified</strong><span>Certificate included with every order</span></div>
          </div>
        </div>

        <div class="pdp-tabs">
          <div class="pdp-tab-headers">
            <button class="pdp-tab-header active" data-tab="details">Details</button>
            <button class="pdp-tab-header" data-tab="symbolism">Symbolism</button>
            <button class="pdp-tab-header" data-tab="materials">Materials</button>
            <button class="pdp-tab-header" data-tab="care">Care</button>
          </div>
          <div class="pdp-tab-content">
            <div class="pdp-tab-panel active" data-panel="details">
              <p>Let your inner compass guide you. The CHENSHA Cinnabar Bracelet is a token of direction, purpose, and quiet confidence. A luminous stone sits at the center, illuminating your way forward.</p>
              <ul>
                <li>Natural cinnabar beads, hand-selected</li>
                <li>Bead diameter - 8mm / 10mm / 12mm options</li>
                <li>Adjustable cord - fits wrist sizes 15-19cm</li>
                <li>99% pure cinnabar from Tongren, China</li>
                <li>Handcrafted by master artisans</li>
                <li>Hypoallergenic & made for everyday wear</li>
              </ul>
            </div>
            <div class="pdp-tab-panel" data-panel="symbolism">
              <p>For over two millennia, cinnabar has been revered as the "Stone of Life" in Chinese culture.</p>
              <ul>
                <li>Represents good fortune, protection, and vitality</li>
                <li>Worn by emperors and scholars through every dynasty</li>
                <li>Believed to ward off negative energy</li>
                <li>Symbol of passion, creativity, and confidence</li>
              </ul>
            </div>
            <div class="pdp-tab-panel" data-panel="materials">
              <p>Sourced from the ancient mines of Tongren, Guizhou - the birthplace of the world's finest cinnabar.</p>
              <ul>
                <li>99% pure natural cinnabar (HgS)</li>
                <li>Hand-polished to a deep, luminous crimson</li>
                <li>Waxed cotton cord, adjustable</li>
                <li>Gold vermeil accents (18k gold over sterling silver)</li>
              </ul>
            </div>
            <div class="pdp-tab-panel" data-panel="care">
              <p>Caring for your CHENSHA piece ensures it stays beautiful for generations.</p>
              <ul>
                <li>Avoid prolonged contact with water, perfume, or chemicals</li>
                <li>Wipe gently with a soft, dry cloth after wear</li>
                <li>Store in the included velvet pouch when not in use</li>
                <li>Keep away from direct sunlight and extreme heat</li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- BELOW: Description -->
    <div class="pdp-description">
      <div class="pdp-desc-inner">
        {{ product.description }}
      </div>
    </div>

    <!-- BRAND STORY SPLIT -->
    {% section 'pdp-brand-story' %}

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Tabs
  var tabHeaders = document.querySelectorAll('.pdp-tab-header');
  var tabPanels = document.querySelectorAll('.pdp-tab-panel');
  
  tabHeaders.forEach(function(header) {
    header.addEventListener('click', function() {
      var tab = this.getAttribute('data-tab');
      
      tabHeaders.forEach(function(h) { h.classList.remove('active'); });
      tabPanels.forEach(function(p) { p.classList.remove('active'); });
      
      this.classList.add('active');
      document.querySelector('.pdp-tab-panel[data-panel="' + tab + '"]').classList.add('active');
    });
  });

  // Variant form
  var form = document.getElementById('product-form');
  if (!form) return;
  
  var variants = {{ product.variants | json }};
  
  form.querySelectorAll('.pdp-value input').forEach(function(input) {
    input.addEventListener('change', function() {
      updateVariant();
    });
  });
  
  function updateVariant() {
    var selectedOptions = {};
    form.querySelectorAll('.pdp-option').forEach(function(option) {
      var label = option.querySelector('.pdp-option-label').textContent;
      var selected = option.querySelector('input:checked');
      if (selected) selectedOptions[label] = selected.value;
    });
    
    var matchingVariant = variants.find(function(v) {
      return JSON.stringify(v.options) === JSON.stringify(Object.values(selectedOptions));
    });
    
    if (matchingVariant) {
      form.querySelector('input[name="id"]').value = matchingVariant.id;
    }
  }
});
</script>

<style>
.pdp-tabs {
  margin-top: 40px;
  padding-top: 30px;
  border-top: 1px solid #E8E0D5;
}

.pdp-tab-headers {
  display: flex;
  gap: 30px;
  margin-bottom: 25px;
  border-bottom: 1px solid #E8E0D5;
}

.pdp-tab-header {
  background: none;
  border: none;
  padding: 0 0 12px 0;
  font-family: 'Cormorant Garamond', serif;
  font-size: 16px;
  color: #8A7A72;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: all 0.3s ease;
}

.pdp-tab-header.active {
  color: #2A1F1A;
  border-bottom-color: #9E2B25;
}

.pdp-tab-panel {
  display: none;
  font-size: 15px;
  line-height: 1.8;
  color: #5A4A42;
}

.pdp-tab-panel.active {
  display: block;
}

.pdp-tab-panel p {
  margin-bottom: 15px;
}

.pdp-tab-panel ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.pdp-tab-panel li {
  padding-left: 18px;
  position: relative;
  margin-bottom: 8px;
}

.pdp-tab-panel li:before {
  content: '•';
  position: absolute;
  left: 0;
  color: #9E2B25;
}
</style>
