{% comment %}
  ========================================
  CHENSHA 账户余额与记录 Snippet
  ========================================
  使用方法：
  1. 把这个文件放到 snippets/ 目录
  2. 在客户账户模板（customers/account.liquid）合适位置插入：{% render 'account-balance-panel' %}
  3. 充值产品链接可以在下面的 schema 或代码里修改

  功能：
  - 账户余额大卡片展示
  - 立即充值按钮
  - 充值记录列表
  - 余额使用（消费）记录列表
  - 标签页切换
  ========================================
{% endcomment %}

{% if customer %}
<div class="account-balance-panel">

  <!-- 余额大卡片 -->
  <div class="balance-hero-card">
    <div class="balance-hero-bg"></div>
    <div class="balance-hero-content">
      <div class="balance-hero-label">账户余额 · Account Balance</div>
      <div class="balance-hero-amount">
        <span class="currency">$</span>
        <span class="amount-number">{{ customer.metafields.custom.account_balance | default: 0 }}</span>
      </div>
      <div class="balance-hero-actions">
        <a href="/products/account-top-up" class="balance-topup-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          立即充值 · Top Up
        </a>
      </div>
    </div>
    <div class="balance-hero-decoration">
      <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
        <circle cx="60" cy="60" r="50" stroke="rgba(224,200,138,0.2)" stroke-width="1"/>
        <circle cx="60" cy="60" r="35" stroke="rgba(224,200,138,0.15)" stroke-width="1"/>
        <circle cx="60" cy="60" r="20" stroke="rgba(224,200,138,0.1)" stroke-width="1"/>
      </svg>
    </div>
  </div>

  <!-- 记录标签页 -->
  <div class="balance-records-section">
    <div class="records-tabs">
      <button class="record-tab active" data-tab="topup">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
        </svg>
        充值记录
      </button>
      <button class="record-tab" data-tab="usage">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20 7h-9M14 17H5M17 17a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM7 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
        </svg>
        消费记录
      </button>
    </div>

    <!-- 充值记录列表 -->
    <div class="records-panel active" data-panel="topup">
      {% assign topup_records = customer.metafields.custom.topup_records %}
      {% if topup_records and topup_records != blank %}
        {% assign records_array = topup_records | split: '},{ ' %}
        <div class="records-list">
          {% for record in customer.metafields.custom.topup_records %}
            <div class="record-item">
              <div class="record-icon topup-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="19" x2="12" y2="5"/>
                  <polyline points="5 12 12 5 19 12"/>
                </svg>
              </div>
              <div class="record-info">
                <div class="record-title">
                  {% if record.amount < 0 %}
                    充值退款
                  {% else %}
                    账户充值
                  {% endif %}
                  {% if record.bonusRule and record.bonusRule != '退款扣回' %}
                    <span class="record-bonus-tag">{{ record.bonusRule }}</span>
                  {% endif %}
                </div>
                <div class="record-meta">
                  <span>{{ record.timestamp | date: "%Y-%m-%d %H:%M" }}</span>
                  {% if record.orderName %}
                    <span class="record-order">订单 {{ record.orderName }}</span>
                  {% endif %}
                </div>
                {% if record.amount > 0 and record.bonus > 0 %}
                  <div class="record-detail">
                    充值 ${{ record.amount }} + 赠送 ${{ record.bonus }}
                  </div>
                {% endif %}
              </div>
              <div class="record-amount {% if record.amount < 0 %}negative{% else %}positive{% endif %}">
                {% if record.amount < 0 %}
                  -${{ record.totalCredit | remove: '-' }}
                {% else %}
                  +${{ record.totalCredit }}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="records-empty">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
          <p>暂无充值记录</p>
          <a href="/products/account-top-up" class="empty-topup-link">立即充值，享专属赠送</a>
        </div>
      {% endif %}
    </div>

    <!-- 消费记录列表 -->
    <div class="records-panel" data-panel="usage">
      {% assign usage_records = customer.metafields.custom.balance_usage_records %}
      {% if usage_records and usage_records != blank %}
        <div class="records-list">
          {% for record in customer.metafields.custom.balance_usage_records %}
            <div class="record-item">
              <div class="record-icon usage-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                  <line x1="3" y1="6" x2="21" y2="6"/>
                  <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
              </div>
              <div class="record-info">
                <div class="record-title">
                  余额支付
                  <span class="record-status status-{{ record.status | default: 'pending' }}">
                    {% case record.status %}
                      {% when 'used' %}已完成
                      {% when 'pending' %}待结账
                      {% when 'cancelled' %}已取消
                      {% when 'refunded' %}已退款
                      {% else %}{{ record.status }}
                    {% endcase %}
                  </span>
                </div>
                <div class="record-meta">
                  <span>{{ record.createdAt | date: "%Y-%m-%d %H:%M" }}</span>
                  {% if record.orderName %}
                    <span class="record-order">订单 {{ record.orderName }}</span>
                  {% endif %}
                </div>
                {% if record.discountCode %}
                  <div class="record-detail">折扣码 {{ record.discountCode }}</div>
                {% endif %}
              </div>
              <div class="record-amount negative">
                -${{ record.amount }}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="records-empty">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <p>暂无消费记录</p>
          <p class="empty-hint">使用余额支付后，记录将显示在这里</p>
        </div>
      {% endif %}
    </div>

  </div>
</div>

<style>
/* ========== 账户余额面板样式 ========== */
.account-balance-panel {
  margin: 30px 0;
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
}

/* 余额大卡片 */
.balance-hero-card {
  position: relative;
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 50%, #5C1512 100%);
  border-radius: 20px;
  padding: 40px;
  overflow: hidden;
  box-shadow: 0 8px 40px rgba(158, 43, 37, 0.25);
  margin-bottom: 30px;
}

.balance-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 20% 80%, rgba(201, 162, 75, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(224, 200, 138, 0.1) 0%, transparent 40%);
  pointer-events: none;
}

.balance-hero-content {
  position: relative;
  z-index: 1;
}

.balance-hero-label {
  font-size: 14px;
  color: rgba(224, 200, 138, 0.8);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 12px;
  font-weight: 500;
}

.balance-hero-amount {
  display: flex;
  align-items: baseline;
  gap: 4px;
  color: white;
  margin-bottom: 24px;
}

.balance-hero-amount .currency {
  font-size: 28px;
  font-weight: 500;
  color: #E0C88A;
}

.balance-hero-amount .amount-number {
  font-size: 56px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1;
}

.balance-hero-actions {
  display: flex;
  gap: 12px;
}

.balance-topup-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  background: linear-gradient(135deg, #C9A24B 0%, #B8923F 100%);
  color: white;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 2px 12px rgba(201, 162, 75, 0.3);
}

.balance-topup-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 20px rgba(201, 162, 75, 0.4);
}

.balance-hero-decoration {
  position: absolute;
  right: -20px;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0.6;
  pointer-events: none;
}

/* 记录区域 */
.balance-records-section {
  background: white;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(158, 43, 37, 0.06);
  border: 1px solid rgba(201, 162, 75, 0.15);
}

.records-tabs {
  display: flex;
  border-bottom: 1px solid #F4EDE2;
  padding: 0 24px;
}

.record-tab {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 18px 24px;
  background: none;
  border: none;
  font-size: 16px;
  font-weight: 600;
  color: #8A7A72;
  cursor: pointer;
  transition: all 0.3s ease;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
}

.record-tab:hover {
  color: #5A4A42;
}

.record-tab.active {
  color: #9E2B25;
  border-bottom-color: #9E2B25;
}

.records-panel {
  display: none;
  padding: 10px 0;
}

.records-panel.active {
  display: block;
}

/* 记录列表 */
.records-list {
  padding: 0 24px;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 0;
  border-bottom: 1px solid #FAF6F0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.topup-icon {
  background: rgba(158, 43, 37, 0.1);
  color: #9E2B25;
}

.usage-icon {
  background: rgba(201, 162, 75, 0.15);
  color: #B8923F;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 16px;
  font-weight: 600;
  color: #2A1F1A;
  margin-bottom: 4px;
}

.record-bonus-tag {
  font-size: 11px;
  background: linear-gradient(135deg, #C9A24B 0%, #B8923F 100%);
  color: white;
  padding: 2px 8px;
  border-radius: 4px;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.record-status {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 4px;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.status-pending {
  background: #FFF3CD;
  color: #856404;
}

.status-used {
  background: #D4EDDA;
  color: #155724;
}

.status-cancelled {
  background: #F8D7DA;
  color: #721C24;
}

.status-refunded {
  background: #D1ECF1;
  color: #0C5460;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 13px;
  color: #8A7A72;
  font-family: 'Noto Sans SC', sans-serif;
}

.record-order {
  color: #9E2B25;
  font-weight: 500;
}

.record-detail {
  margin-top: 4px;
  font-size: 13px;
  color: #8A7A72;
  font-family: 'Noto Sans SC', sans-serif;
}

.record-amount {
  font-size: 18px;
  font-weight: 700;
  font-family: 'Cormorant Garamond', serif;
  flex-shrink: 0;
}

.record-amount.positive {
  color: #9E2B25;
}

.record-amount.negative {
  color: #5A4A42;
}

/* 空状态 */
.records-empty {
  padding: 60px 40px;
  text-align: center;
  color: #8A7A72;
}

.records-empty svg {
  margin-bottom: 16px;
  opacity: 0.4;
}

.records-empty p {
  font-size: 16px;
  margin-bottom: 8px;
}

.records-empty .empty-hint {
  font-size: 13px;
  color: #B0A098;
  font-family: 'Noto Sans SC', sans-serif;
}

.empty-topup-link {
  display: inline-block;
  margin-top: 16px;
  padding: 10px 24px;
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
  color: white;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
}

.empty-topup-link:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(158, 43, 37, 0.25);
}

/* 响应式 */
@media (max-width: 600px) {
  .balance-hero-card {
    padding: 28px 24px;
  }

  .balance-hero-amount .amount-number {
    font-size: 42px;
  }

  .records-tabs {
    padding: 0 16px;
  }

  .record-tab {
    padding: 16px 16px;
    font-size: 15px;
  }

  .records-list {
    padding: 0 16px;
  }

  .record-meta {
    flex-wrap: wrap;
    gap: 6px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // 标签页切换
  const tabs = document.querySelectorAll('.record-tab');
  const panels = document.querySelectorAll('.records-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', function() {
      const targetTab = this.dataset.tab;

      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));

      this.classList.add('active');
      document.querySelector('.records-panel[data-panel="' + targetTab + '"]').classList.add('active');
    });
  });
});
</script>
{% endif %}
