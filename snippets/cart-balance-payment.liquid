{% comment %}
  ========================================
  CHENSHA 购物车余额支付 Snippet
  ========================================
  使用方法：
  1. 把这个文件放到 snippets/ 目录
  2. 在购物车模板（cart.liquid）合适位置插入：{% render 'cart-balance-payment' %}
  3. 把下面的 API_BASE_URL 替换成你的 Netlify 部署地址（不要加末尾的 /）

  功能：
  - 显示用户账户余额
  - 用户自定义输入使用多少余额
  - 一键使用余额支付（自动生成折扣码）
  - 取消使用余额（自动退回）
  - 结账时自动带上折扣码
  ========================================
{% endcomment %}

{% if customer %}
<div class="cart-balance-section" id="cartBalanceSection">
  <div class="balance-card">
    <div class="balance-header">
      <div class="balance-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v12M15 9.5a3 3 0 0 0-3-1.5c-1.66 0-3 1.12-3 2.5s1.34 2.5 3 2.5 3 1.12 3 2.5-1.34 2.5-3 2.5a3 3 0 0 1-3-1.5"/>
        </svg>
      </div>
      <div class="balance-info">
        <span class="balance-label">Account Balance</span>
        <span class="balance-amount" id="cartBalanceAmount">${{ customer.metafields.custom.account_balance | default: 0 }}</span>
      </div>
    </div>

    <!-- 未使用余额时的操作区 -->
    <div class="balance-action-area" id="balanceActionArea">
      <div class="balance-input-row">
        <span class="input-currency">$</span>
        <input type="number" id="balanceUseAmount" class="balance-use-input" placeholder="Enter amount to use" min="0.01" step="0.01">
        <button type="button" class="use-all-btn" id="useAllBalanceBtn">Use All</button>
      </div>
      <button type="button" class="use-balance-btn" id="useBalanceBtn">
        <span class="btn-text">Pay with Balance</span>
        <span class="btn-loading" style="display:none;">Processing...</span>
      </button>
    </div>

    <!-- 已使用余额时的显示区 -->
    <div class="balance-used-area" id="balanceUsedArea" style="display:none;">
      <div class="used-info">
        <div class="used-row">
          <span>Balance Applied</span>
          <span class="used-amount" id="usedBalanceAmount">-$0.00</span>
        </div>
        <div class="used-row remaining">
          <span>Remaining to Pay</span>
          <span class="remaining-amount" id="remainingAmount">$0.00</span>
        </div>
      </div>
      <button type="button" class="cancel-balance-btn" id="cancelBalanceBtn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
        Cancel Balance Usage
      </button>
    </div>

    <p class="balance-hint">Balance can be used with other payment methods. Remaining amount will be paid at checkout.</p>
  </div>
</div>

<style>
/* ========== 购物车余额支付样式 ========== */
.cart-balance-section {
  margin: 24px 0;
  font-family: 'Cormorant Garamond', 'Noto Serif SC', serif;
}

.balance-card {
  background: linear-gradient(135deg, #FAF6F0 0%, #F4EDE2 100%);
  border: 1px solid rgba(201, 162, 75, 0.25);
  border-radius: 14px;
  padding: 24px;
  box-shadow: 0 2px 12px rgba(158, 43, 37, 0.05);
}

.balance-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 20px;
}

.balance-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
  color: #E0C88A;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.balance-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.balance-label {
  font-size: 13px;
  color: #8A7A72;
  letter-spacing: 0.05em;
  font-family: 'Noto Sans SC', sans-serif;
}

.balance-amount {
  font-size: 26px;
  font-weight: 700;
  color: #9E2B25;
  font-family: 'Cormorant Garamond', serif;
}

/* 输入区域 */
.balance-input-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.input-currency {
  position: absolute;
  left: 16px;
  font-size: 18px;
  font-weight: 600;
  color: #9E2B25;
  z-index: 1;
}

.balance-use-input {
  flex: 1;
  padding: 12px 16px 12px 36px;
  border: 2px solid #E8E0D5;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 600;
  color: #2A1F1A;
  background: white;
  transition: all 0.3s ease;
  font-family: 'Cormorant Garamond', serif;
  outline: none;
}

.balance-use-input:focus {
  border-color: #9E2B25;
  box-shadow: 0 0 0 3px rgba(158, 43, 37, 0.1);
}

.use-all-btn {
  padding: 10px 16px;
  background: white;
  border: 2px solid #C9A24B;
  color: #9E2B25;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  white-space: nowrap;
  font-family: 'Cormorant Garamond', serif;
}

.use-all-btn:hover {
  background: #C9A24B;
  color: white;
}

/* 使用余额按钮 */
.use-balance-btn {
  width: 100%;
  padding: 14px 20px;
  background: linear-gradient(135deg, #9E2B25 0%, #7A1F1A 100%);
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.08em;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 2px 12px rgba(158, 43, 37, 0.2);
  font-family: 'Cormorant Garamond', serif;
}

.use-balance-btn:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(158, 43, 37, 0.3);
}

.use-balance-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* 已使用余额显示 */
.balance-used-area {
  margin-top: 10px;
}

.used-info {
  background: white;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  border: 1px solid rgba(158, 43, 37, 0.15);
}

.used-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 0;
  font-size: 15px;
  color: #5A4A42;
}

.used-row.remaining {
  border-top: 1px dashed #E8E0D5;
  margin-top: 8px;
  padding-top: 12px;
  font-weight: 600;
  color: #2A1F1A;
}

.used-amount {
  color: #9E2B25;
  font-weight: 600;
  font-family: 'Cormorant Garamond', serif;
}

.remaining-amount {
  color: #9E2B25;
  font-weight: 700;
  font-size: 18px;
  font-family: 'Cormorant Garamond', serif;
}

.cancel-balance-btn {
  width: 100%;
  padding: 10px 16px;
  background: transparent;
  border: 1px solid #E8E0D5;
  color: #8A7A72;
  border-radius: 8px;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-family: 'Noto Sans SC', sans-serif;
}

.cancel-balance-btn:hover {
  border-color: #9E2B25;
  color: #9E2B25;
  background: rgba(158, 43, 37, 0.05);
}

.balance-hint {
  margin-top: 14px;
  font-size: 12px;
  color: #8A7A72;
  text-align: center;
  line-height: 1.5;
  font-family: 'Noto Sans SC', sans-serif;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // ========== 配置项 ==========
  const API_BASE_URL = 'https://chensha-topup-backend.netlify.app';

  // ========== 元素获取 ==========
  const balanceSection = document.getElementById('cartBalanceSection');
  const balanceAmountEl = document.getElementById('cartBalanceAmount');
  const balanceUseInput = document.getElementById('balanceUseAmount');
  const useAllBtn = document.getElementById('useAllBalanceBtn');
  const useBalanceBtn = document.getElementById('useBalanceBtn');
  const actionArea = document.getElementById('balanceActionArea');
  const usedArea = document.getElementById('balanceUsedArea');
  const usedBalanceAmountEl = document.getElementById('usedBalanceAmount');
  const remainingAmountEl = document.getElementById('remainingAmount');
  const cancelBalanceBtn = document.getElementById('cancelBalanceBtn');

  if (!balanceSection) return;

  // ========== 状态 ==========
  let currentBalance = parseFloat(balanceAmountEl.textContent.replace('$', '')) || 0;
  let currentUsage = null; // { recordId, discountCode, amount }

  // 从 localStorage 恢复使用状态（页面刷新后保持）
  const savedUsage = localStorage.getItem('chensha_balance_usage');
  if (savedUsage) {
    try {
      currentUsage = JSON.parse(savedUsage);
      showUsedState(currentUsage.amount);
    } catch (e) {
      localStorage.removeItem('chensha_balance_usage');
    }
  }

  // ========== 工具函数 ==========
  function getCartTotal() {
    // 尝试从购物车页面获取总价
    // 兼容不同主题，尝试多种选择器
    const selectors = [
      '.cart-total .price',
      '.cart__total .price',
      '.total-price .price',
      '[data-cart-total]',
      '.cart-subtotal .price',
      '.totals .total .price'
    ];
    for (const selector of selectors) {
      const el = document.querySelector(selector);
      if (el) {
        const text = el.textContent.replace(/[^0-9.]/g, '');
        const value = parseFloat(text);
        if (!isNaN(value) && value > 0) return value;
      }
    }
    // 如果找不到，用 Shopify Ajax API 获取
    return fetch('/cart.js')
      .then(r => r.json())
      .then(cart => cart.total_price / 100)
      .catch(() => 0);
  }

  function showUsedState(amount) {
    actionArea.style.display = 'none';
    usedArea.style.display = 'block';
    usedBalanceAmountEl.textContent = '-$' + amount.toFixed(2);

    // 计算还需支付
    Promise.resolve(getCartTotal()).then(cartTotal => {
      const remaining = Math.max(0, cartTotal - amount);
      remainingAmountEl.textContent = '$' + remaining.toFixed(2);
    });
  }

  function showActionState() {
    actionArea.style.display = 'block';
    usedArea.style.display = 'none';
    balanceUseInput.value = '';
  }

  // ========== 事件处理 ==========

  // 全部使用
  useAllBtn.addEventListener('click', function() {
    balanceUseInput.value = currentBalance.toFixed(2);
  });

  // 使用余额
  useBalanceBtn.addEventListener('click', async function() {
    const amount = parseFloat(balanceUseInput.value);

    if (!amount || amount <= 0) {
      alert('Please enter a valid amount');
      return;
    }
    if (amount > currentBalance) {
      alert('Insufficient balance. Current balance: $' + currentBalance.toFixed(2));
      return;
    }

    const btnText = this.querySelector('.btn-text');
    const btnLoading = this.querySelector('.btn-loading');
    btnText.style.display = 'none';
    btnLoading.style.display = 'inline';
    this.disabled = true;

    try {
      // 获取客户ID（从页面或Shopify对象）
      let customerId = null;
      if (window.Shopify && window.Shopify.customer && window.Shopify.customer.id) {
        customerId = window.Shopify.customer.id;
      } else {
        // 尝试从页面meta或其他地方获取
        const customerIdEl = document.querySelector('[data-customer-id]');
        if (customerIdEl) customerId = customerIdEl.dataset.customerId;
      }

      if (!customerId) {
        alert('Unable to get customer info. Please refresh and try again.');
        throw new Error('No customer ID');
      }

      // 调用后端API使用余额
      const response = await fetch(API_BASE_URL + '/.netlify/functions/balance/use', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customerId: customerId,
          amount: amount,
          cartToken: window.Shopify?.cart?.token || null
        })
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || data.message || 'Failed to use balance');
      }

      // 保存使用状态
      currentUsage = {
        recordId: data.recordId,
        discountCode: data.discountCode,
        amount: amount
      };
      localStorage.setItem('chensha_balance_usage', JSON.stringify(currentUsage));

      // 更新显示
      currentBalance = data.newBalance;
      balanceAmountEl.textContent = '$' + currentBalance.toFixed(2);
      showUsedState(amount);

      // 提示用户
      alert('Balance applied successfully! Discount code ' + data.discountCode + ' will be auto-applied at checkout.');

    } catch (error) {
      console.error('Failed to use balance:', error);
      alert(error.message || 'Failed to use balance. Please try again.');
    } finally {
      btnText.style.display = 'inline';
      btnLoading.style.display = 'none';
      this.disabled = false;
    }
  });

  // 取消使用余额
  cancelBalanceBtn.addEventListener('click', async function() {
    if (!currentUsage) {
      showActionState();
      return;
    }

    if (!confirm('Are you sure you want to cancel balance usage? The amount will be returned to your account.')) {
      return;
    }

    this.disabled = true;
    this.textContent = 'Processing...';

    try {
      // 获取客户ID
      let customerId = null;
      if (window.Shopify && window.Shopify.customer && window.Shopify.customer.id) {
        customerId = window.Shopify.customer.id;
      }

      if (!customerId) {
        throw new Error('Unable to get customer info');
      }

      // 调用后端API取消
      const response = await fetch(API_BASE_URL + '/.netlify/functions/balance/cancel', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customerId: customerId,
          recordId: currentUsage.recordId
        })
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || data.message || 'Failed to cancel');
      }

      // 更新状态
      currentBalance = data.newBalance;
      balanceAmountEl.textContent = '$' + currentBalance.toFixed(2);
      currentUsage = null;
      localStorage.removeItem('chensha_balance_usage');
      showActionState();

    } catch (error) {
      console.error('Failed to cancel balance usage:', error);
      alert(error.message || 'Failed to cancel. Please try again.');
    } finally {
      this.disabled = false;
      this.textContent = 'Cancel Balance Usage';
    }
  });

  // ========== 拦截结账按钮，自动带上折扣码 ==========
  function interceptCheckout() {
    const checkoutSelectors = [
      'a[href="/checkout"]',
      'button[name="checkout"]',
      '.cart__checkout',
      '.checkout-btn',
      '[data-checkout]'
    ];

    checkoutSelectors.forEach(selector => {
      document.querySelectorAll(selector).forEach(el => {
        if (el.dataset.balanceIntercepted) return;
        el.dataset.balanceIntercepted = 'true';

        el.addEventListener('click', function(e) {
          if (currentUsage && currentUsage.discountCode) {
            e.preventDefault();
            // 跳转到带折扣码的结账页
            window.location.href = '/checkout?discount=' + encodeURIComponent(currentUsage.discountCode);
          }
        });
      });
    });
  }

  // 初始化拦截（延迟执行确保结账按钮已渲染）
  setTimeout(interceptCheckout, 1000);
  // 购物车更新后重新拦截
  document.addEventListener('cart:updated', function() {
    setTimeout(interceptCheckout, 500);
    // 重新计算剩余金额
    if (currentUsage) {
      Promise.resolve(getCartTotal()).then(cartTotal => {
        const remaining = Math.max(0, cartTotal - currentUsage.amount);
        remainingAmountEl.textContent = '$' + remaining.toFixed(2);
      });
    }
  });
});
</script>
{% endif %}
